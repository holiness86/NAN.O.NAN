<!DOCTYPE html>
<html lang="fa" dir="rtl" data-bs-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#F6ECE5">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%A5%90%3C/text%3E%3C/svg%3E">
  <title>صفحه‌ای پیدا نشد — نان و نان</title>

  <script>
    (function () {
      var d = document.documentElement;
      try {
        var t = localStorage.getItem('nanonan-theme');
        if (t !== 'dark' && t !== 'light') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        d.setAttribute('data-bs-theme', t);
        var m = document.querySelector('meta[name="theme-color"]');
        if (m) m.setAttribute('content', t === 'dark' ? '#1B120C' : '#F6ECE5');
      } catch (e) {}
    })();
  </script>

  <link rel="preload" href="/Fonts/YekanBakh-VF.woff2" as="font" type="font/woff2" crossorigin>

  <link href="/css/bootstrap.rtl.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/icons-1.13.1/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/style.css">

  <style>
    .brand-mini { text-decoration: none; }
    .nf-page { display: flex; flex-direction: column; min-height: 100vh; min-height: 100dvh; }

    .nf-main {
      position: relative;
      display: grid;
      flex: 1;
      place-items: center;
      width: 100%;
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 1rem var(--page-pad) 3rem;
      isolation: isolate;
    }

    .nf-ghost {
      position: absolute;
      top: 50%;
      left: 50%;
      z-index: -1;
      direction: ltr;
      font-family: Arial, sans-serif;
      font-size: clamp(8.5rem, 40vw, 21rem);
      font-weight: 900;
      line-height: .8;
      letter-spacing: -.04em;
      color: transparent;
      background: linear-gradient(180deg, rgba(var(--brand-rgb), .2) 0%, rgba(var(--brand-rgb), 0) 90%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-stroke: 2px rgba(var(--brand-rgb), .34);
      -webkit-mask-image: linear-gradient(180deg, #000 52%, transparent 100%);
      mask-image: linear-gradient(180deg, #000 52%, transparent 100%);
      transform: translate3d(-50%, -56%, 0);
      white-space: nowrap;
      pointer-events: none;
      user-select: none;
    }

    .nf-card {
      position: relative;
      width: min(100%, 460px);
      margin-block: clamp(2.2rem, 11vh, 5rem);
      padding: 2rem 1.5rem 1.5rem;
      border: 1px solid var(--border-warm);
      border-radius: var(--r-xl);
      background: var(--surface);
      box-shadow: var(--shadow-card);
      text-align: center;
      animation: card-in 420ms var(--ease-out) both;
    }
    @supports (corner-shape: squircle) {
      .nf-card, .nf-icon, .nf-btn, .nf-btn-ghost, .nf-path { corner-shape: squircle; }
    }

    .nf-icon {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 72px;
      height: 72px;
      margin: 0 auto 1.1rem;
      border: 1px solid var(--border-warm);
      border-radius: var(--r-lg);
      background: var(--brand-soft);
      color: var(--brand);
      font-size: 2rem;
    }

    .nf-steam { position: absolute; top: -6px; right: 0; left: 0; display: flex; justify-content: center; gap: 9px; pointer-events: none; }
    .nf-steam span {
      width: 4px;
      height: 14px;
      border-radius: 50rem;
      background: var(--brand-light);
      opacity: 0;
      will-change: transform, opacity;
      animation: nf-steam 2.4s ease-in-out infinite;
    }
    .nf-steam span:nth-child(1) { animation-delay: .5s; }
    .nf-steam span:nth-child(3) { animation-delay: 1.1s; }
    @keyframes nf-steam {
      0% { opacity: 0; transform: translate3d(0, 6px, 0) scaleY(.6); }
      40% { opacity: .7; }
      100% { opacity: 0; transform: translate3d(0, -14px, 0) scaleY(1.1); }
    }

    .nf-title { margin: 0 0 .5rem; font-size: clamp(1.45rem, 5.5vw, 1.8rem); font-weight: 800; line-height: 1.3; letter-spacing: -.02em; color: var(--ink); }
    .nf-title span { color: var(--brand); }

    .nf-text { margin: 0 auto 1.1rem; max-width: 34ch; font-size: .92rem; line-height: 1.85; color: var(--ink-muted); }

    .nf-path {
      display: block;
      max-width: 100%;
      margin: 0 auto 1.3rem;
      padding: .45rem .85rem;
      border: 1px dashed var(--border-warm);
      border-radius: var(--r-sm);
      background: var(--surface-raised);
      direction: ltr;
      text-align: left;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: .76rem;
      color: var(--ink-muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .nf-actions { display: flex; flex-direction: column; gap: 10px; }

    .nf-btn {
      -webkit-appearance: none;
      appearance: none;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: .8rem;
      width: 100%;
      min-height: 54px;
      padding: .4rem 1rem;
      border: 0;
      border-radius: var(--r-md);
      background: var(--brand);
      box-shadow: var(--shadow-brand);
      color: #fff;
      font-size: 1rem;
      font-weight: 800;
      text-decoration: none;
      cursor: pointer;
      transition: transform var(--dur-press) var(--ease-out), background-color var(--dur-fast) linear;
    }
    .nf-btn:active { transform: scale(.97); }
    [data-bs-theme="dark"] .nf-btn { color: var(--cream); }
    @media (hover: hover) and (pointer: fine) {
      .nf-btn:hover { background: var(--brand-dark); color: #fff; }
      [data-bs-theme="dark"] .nf-btn:hover { background: var(--brand-light); color: var(--cream); }
    }

    .nf-timer { position: relative; display: grid; flex: none; place-items: center; width: 38px; height: 38px; }
    .nf-timer svg { position: absolute; inset: 0; width: 100%; height: 100%; transform: rotate(-90deg); }
    .nf-timer circle { fill: none; stroke-width: 3; }
    .nf-timer .track { stroke: currentColor; opacity: .28; }
    .nf-timer .bar { stroke: currentColor; stroke-linecap: round; stroke-dasharray: 100.53; stroke-dashoffset: 0; }
    .nf-timer.run .bar { animation: nf-ring var(--nf-dur, 10s) linear forwards; }
    .nf-timer.paused .bar { animation-play-state: paused; }
    @keyframes nf-ring { to { stroke-dashoffset: 100.53; } }
    .nf-count { position: relative; font-size: .88rem; font-weight: 800; }

    .nf-btn-ghost {
      -webkit-appearance: none;
      appearance: none;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: .5rem;
      width: 100%;
      min-height: 46px;
      padding: .3rem 1rem;
      border: 1.5px solid var(--border-warm);
      border-radius: var(--r-md);
      background: var(--surface);
      color: var(--ink-muted);
      font-size: .85rem;
      font-weight: 700;
      cursor: pointer;
      transition: transform var(--dur-press) var(--ease-out), border-color var(--dur-fast) linear, color var(--dur-fast) linear;
    }
    .nf-btn-ghost:active { transform: scale(.97); }
    @media (hover: hover) and (pointer: fine) {
      .nf-btn-ghost:hover { border-color: var(--steel); color: var(--steel); }
    }

    .nf-note { margin: 1rem 0 0; font-size: .78rem; color: var(--ink-muted); }
    .nf-note b { color: var(--brand); font-weight: 800; }

    @media (min-width: 576px) {
      .nf-card { padding: 2.4rem 2rem 1.8rem; }
      .nf-actions { flex-direction: row-reverse; }
      .nf-btn { flex: 1.5; }
      .nf-btn-ghost { flex: 1; }
    }
  </style>
</head>
<body class="nf-page">

  <header class="top-bar">
    <a class="brand-mini" href="/" aria-label="نان و نان — بازگشت به منو">
      <div class="brand-mini-logo"><img src="/images/logo/Nan.O.Nan-brand.png" width="60" height="60" alt="" decoding="async"></div>
      <div class="brand-mini-text">
        <p class="brand-mini-name">نان <span>و نان</span></p>
        <p class="brand-mini-tagline">Café &amp; Bakery</p>
      </div>
    </a>
    <button type="button" class="theme-btn" id="themeBtn" aria-label="تغییر تم روشن/تاریک">
      <i class="bi bi-moon-stars-fill" id="themeIcon" aria-hidden="true"></i>
    </button>
  </header>

  <main class="nf-main" aria-labelledby="nfTitle">
    <div class="nf-ghost" aria-hidden="true">404</div>

    <section class="nf-card">
      <div class="nf-icon" aria-hidden="true">
        <div class="nf-steam"><span></span><span></span><span></span></div>
        <i class="bi bi-cup-hot"></i>
      </div>

      <h1 class="nf-title" id="nfTitle">این صفحه <span>پیدا نشد</span></h1>
      <p class="nf-text">آدرسی که وارد کردید وجود نداره یا جابه‌جا شده. برگردید به منو و از اونجا ادامه بدید.</p>

      <% if (typeof requestedPath !== 'undefined' && requestedPath) { %>
      <code class="nf-path" dir="ltr"><%= requestedPath %></code>
      <% } %>

      <div class="nf-actions">
        <a class="nf-btn" id="nfBack" href="/">
          <span class="nf-timer" id="nfTimer" aria-hidden="true">
            <svg viewBox="0 0 40 40">
              <circle class="track" cx="20" cy="20" r="16"></circle>
              <circle class="bar" cx="20" cy="20" r="16"></circle>
            </svg>
            <span class="nf-count" id="nfCount">۱۰</span>
          </span>
          <span>بازگشت به منو</span>
        </a>
        <button type="button" class="nf-btn-ghost" id="nfPause">
          <i class="bi bi-pause-fill" id="nfPauseIcon" aria-hidden="true"></i>
          <span id="nfPauseText">توقف بازگشت خودکار</span>
        </button>
      </div>

      <p class="nf-note" id="nfNote">تا <b id="nfSec">۱۰</b> ثانیه دیگه خودکار به منو برمی‌گردید.</p>
    </section>
  </main>

  <footer class="menu-footer">
    <div class="footer-brand">نان و نان</div>
    <p class="footer-text footer-fine">© 2026 نان و نان</p>
  </footer>

  <script>
    (function () {
      var root = document.documentElement;
      var SECONDS = 10;
      var TARGET = '/';
      var fa = new Intl.NumberFormat('fa-IR');

      var themeBtn = document.getElementById('themeBtn');
      var themeIcon = document.getElementById('themeIcon');
      var timer = document.getElementById('nfTimer');
      var count = document.getElementById('nfCount');
      var sec = document.getElementById('nfSec');
      var note = document.getElementById('nfNote');
      var back = document.getElementById('nfBack');
      var pauseBtn = document.getElementById('nfPause');
      var pauseIcon = document.getElementById('nfPauseIcon');
      var pauseText = document.getElementById('nfPauseText');

      var remaining = SECONDS * 1000;
      var deadline = Date.now() + remaining;
      var paused = false;
      var done = false;
      var tick = null;

      function syncTheme() {
        var dark = root.getAttribute('data-bs-theme') === 'dark';
        themeIcon.className = 'bi ' + (dark ? 'bi-sun-fill' : 'bi-moon-stars-fill');
        var m = document.querySelector('meta[name="theme-color"]');
        if (m) m.setAttribute('content', dark ? '#1B120C' : '#F6ECE5');
      }

      themeBtn.addEventListener('click', function () {
        var next = root.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-bs-theme', next);
        try { localStorage.setItem('nanonan-theme', next); } catch (e) {}
        syncTheme();
      });

      function go() {
        if (done) return;
        done = true;
        clearInterval(tick);
        window.location.replace(TARGET);
      }

      function render() {
        if (!paused) remaining = Math.max(0, deadline - Date.now());
        var left = Math.ceil(remaining / 1000);
        var text = fa.format(left);
        count.textContent = text;
        sec.textContent = text;
        if (remaining <= 0) go();
      }

      function setPaused(value) {
        paused = value;
        timer.classList.toggle('paused', paused);
        pauseIcon.className = 'bi ' + (paused ? 'bi-play-fill' : 'bi-pause-fill');
        pauseText.textContent = paused ? 'ادامه بازگشت خودکار' : 'توقف بازگشت خودکار';
        if (paused) {
          note.textContent = 'بازگشت خودکار متوقف شد. هر وقت خواستید دکمه بالا رو بزنید.';
        } else {
          deadline = Date.now() + remaining;
          note.innerHTML = 'تا <b id="nfSec"></b> ثانیه دیگه خودکار به منو برمی‌گردید.';
          sec = document.getElementById('nfSec');
        }
        render();
      }

      pauseBtn.addEventListener('click', function () {
        if (!done) setPaused(!paused);
      });

      back.addEventListener('click', function () {
        done = true;
        clearInterval(tick);
      });

      syncTheme();
      timer.style.setProperty('--nf-dur', SECONDS + 's');
      render();
      requestAnimationFrame(function () {
        requestAnimationFrame(function () { timer.classList.add('run'); });
      });
      tick = setInterval(render, 250);

      document.addEventListener('visibilitychange', function () {
        if (!document.hidden) render();
      });
    })();
  </script>
</body>
</html>
