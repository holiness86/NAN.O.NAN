<!DOCTYPE html>
<html lang="fa" dir="rtl" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ویرایش دسته‌بندی | نان و نان</title>

    <!-- جلوگیری از فلاش تم اشتباه — دقیقاً هماهنگ با index.ejs (کلید مشترک) -->
    <script>
      (function () {
        try {
          var t = localStorage.getItem('nanonan-theme');
          if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-bs-theme', t);
        } catch (e) {}
      })();
    </script>

    <link href="/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/icons-1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* توکن‌های محلی صرفاً alias به توکن‌های اصلی style.css هستند
           تا پالت رنگی و تم روشن/تاریک دقیقاً مثل صفحه اصلی باشد. */
        :root, [data-bs-theme="light"] {
            --bg-gradient-1: var(--cream);
            --bg-gradient-2: var(--cream-deep);
            --bg-gradient-3: var(--surface-raised);
            --glass-bg: var(--surface-glass);
            --glass-border: var(--border-warm);
            --glass-shadow: rgba(var(--ink-rgb), .08);
            --glass-hover: var(--brand-soft);
            --text-main: var(--ink);
            --text-muted: var(--ink-muted);
            --input-bg: rgba(255, 255, 255, 0.65);
            --input-focus: rgba(255, 255, 255, 0.92);
            --accent-color: var(--brand);
            --accent-hover: var(--brand-dark);
        }
        [data-bs-theme="dark"] {
            --bg-gradient-1: var(--cream);
            --bg-gradient-2: var(--cream-deep);
            --bg-gradient-3: var(--surface-raised);
            --glass-bg: var(--surface-glass);
            --glass-border: var(--border-warm);
            --glass-shadow: rgba(0, 0, 0, 0.5);
            --glass-hover: var(--brand-soft);
            --text-main: var(--ink);
            --text-muted: var(--ink-muted);
            --input-bg: rgba(0, 0, 0, 0.3);
            --input-focus: rgba(0, 0, 0, 0.5);
            --accent-color: var(--brand);
            --accent-hover: var(--brand-dark);
        }
        body {
            background: linear-gradient(-45deg, var(--bg-gradient-1), var(--bg-gradient-2), var(--bg-gradient-3));
            color: var(--text-main);
            font-family: 'Vazirmatn', Tahoma, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }
        .glass-card {
            background: var(--glass-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            box-shadow: 0 8px 32px var(--glass-shadow);
            width: 100%;
            max-width: 500px;
            padding: 2.5rem;
        }
        .glass-input {
            background: var(--input-bg) !important;
            border: 1px solid var(--glass-border) !important;
            color: var(--text-main) !important;
            border-radius: 14px;
            padding: 0.75rem 1rem;
            transition: all 0.3s ease;
        }
        .glass-input:focus {
            box-shadow: 0 0 0 3px rgba(184, 134, 11, 0.2) !important;
            border-color: var(--accent-color) !important;
            background: var(--input-focus) !important;
        }
        .btn-accent {
            background: linear-gradient(135deg, var(--accent-color), var(--accent-hover));
            color: #1A1208 !important;
            border: none;
            border-radius: 14px;
            padding: 0.75rem 1.5rem;
            font-weight: 600;
            width: 100%;
            transition: all 0.3s ease;
        }
        [data-bs-theme="dark"] .btn-accent {
            color: #120C05 !important;
        }
        .btn-accent:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(184, 134, 11, 0.3);
        }
        .btn-glass {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--glass-border);
            color: var(--text-main);
            border-radius: 14px;
            padding: 0.75rem 1.5rem;
            width: 100%;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
            text-align: center;
        }
        .btn-glass:hover {
            background: var(--glass-hover);
            color: var(--text-main);
        }
        /* مرورگرهای مدرن (Chrome, Firefox, Safari, Edge) */
 input::placeholder,
 textarea::placeholder {
  color: var(--text-main) !important;
  opacity: 1; /* برای فیکس کردن رنگ سفید خالص در فایرفاکس */
}

/* مرورگر Internet Explorer 10-11 */
 input:-ms-input-placeholder,
textarea:-ms-input-placeholder {
  color: var(--text-main) !important;
}

/* نسخه قدیمی مرورگر Edge */
 input::-ms-input-placeholder,
textarea::-ms-input-placeholder {
  color: var(--text-main) !important;
}

        /* ── انیمیشن ورود کارت ─────────────────────────────────── */
        @keyframes cardPop { 0% { opacity: 0; transform: translateY(24px) scale(.97); } 100% { opacity: 1; transform: translateY(0) scale(1); } }
        @keyframes fieldIn { 0% { opacity: 0; transform: translateY(12px); } 100% { opacity: 1; transform: translateY(0); } }
        .glass-card { animation: cardPop .6s cubic-bezier(.22,1,.36,1) both; }
        .glass-card > form > .col-12 { animation: fieldIn .45s ease both; }
        .glass-card > form > .col-12:nth-child(1) { animation-delay: .06s; }
        .glass-card > form > .col-12:nth-child(2) { animation-delay: .12s; }
        .glass-card > form > .col-12:nth-child(3) { animation-delay: .18s; }
        .glass-card > form > .col-12:nth-child(4) { animation-delay: .24s; }
        .glass-card > form > .col-12:nth-child(5) { animation-delay: .30s; }

        /* ── پیش‌نمایش تصویر/وکتور انتخاب‌شده ─────────────────────── */
        .cat-visual-preview {
            background: var(--brand-soft);
            border: 1px solid var(--glass-border);
        }
        .cat-visual-preview-box {
            width: 52px; height: 52px; border-radius: 14px; flex-shrink: 0;
            overflow: hidden; display: flex; align-items: center; justify-content: center;
            background: var(--glass-bg); border: 1px solid var(--glass-border);
            font-size: 1.4rem; color: var(--accent-color); padding: 6px;
        }
        .cat-visual-preview-box img { width: 100%; height: 100%; object-fit: contain; animation: fieldIn .4s ease; }
        .cat-visual-preview-hint { font-size: .78rem; color: var(--text-muted); display: block; }

        /* ── گرید وکتورهای از پیش آپلود‌شده ──────────────────────── */
        .visual-picker-grid {
            display: grid; grid-template-columns: repeat(5, 1fr);
            gap: 10px; max-height: 260px; overflow-y: auto;
            padding: 10px; border-radius: 16px;
            background: var(--input-bg); border: 1px solid var(--glass-border);
        }
        .visual-picker-item {
            aspect-ratio: 1/1; border-radius: 14px; cursor: pointer;
            background: var(--glass-bg); border: 2px solid var(--glass-border);
            display: flex; align-items: center; justify-content: center;
            padding: 8px; position: relative; transition: transform .2s ease, border-color .2s ease;
        }
        .visual-picker-item img { width: 100%; height: 100%; object-fit: contain; }
        .visual-picker-item:hover { transform: translateY(-3px) scale(1.05); border-color: var(--accent-light); }
        .visual-picker-item.active { border-color: var(--accent-color); background: var(--brand-soft); }
        .visual-picker-item.active::after {
            content: "\f26e"; font-family: "bootstrap-icons"; color: var(--accent-color);
            position: absolute; bottom: -4px; left: -4px;
            width: 18px; height: 18px; border-radius: 50%;
            background: var(--surface, #fff); display: flex; align-items: center; justify-content: center;
            font-size: .7rem; box-shadow: 0 2px 6px rgba(0,0,0,.25);
        }
        .visual-picker-item span.vp-label {
            position: absolute; inset: auto 0 -20px 0; text-align: center;
            font-size: .62rem; color: var(--text-muted); white-space: nowrap;
            overflow: hidden; text-overflow: ellipsis;
        }

        /* ── باکس آپلود تصویر/وکتور دلخواه ────────────────────────── */
        .cat-img-upload {
            display: flex; align-items: center; gap: 1rem;
            padding: .9rem; border-radius: 16px;
            background: var(--input-bg); border: 1px dashed var(--glass-border);
            transition: all .25s ease; cursor: pointer;
        }
        .cat-img-upload:hover, .cat-img-upload.dragover {
            border-color: var(--accent-color);
            background: var(--brand-soft);
        }
        .cat-img-upload-icon {
            width: 44px; height: 44px; border-radius: 12px; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
            background: var(--glass-bg); border: 1px solid var(--glass-border);
            font-size: 1.2rem; color: var(--accent-color);
        }
        .cat-img-upload .txt strong { display: block; font-size: .85rem; }
        .cat-img-upload .txt span { font-size: .74rem; color: var(--text-muted); }
        .cat-img-remove {
            border: none; background: rgba(214,69,59,0.12); color: #D6453B;
            border-radius: 10px; width: 32px; height: 32px; flex-shrink: 0;
            display: none; align-items: center; justify-content: center;
        }
        .cat-img-remove.show { display: flex; }

        /* ── سواتچ‌های رنگی گرادیانی (هماهنگ با style.css: --sw-0..9) ── */
        .swatch-grid {
            display: grid; grid-template-columns: repeat(5, 1fr);
            gap: 10px; margin-top: .5rem;
        }
        .swatch-dot {
            aspect-ratio: 1/1; border-radius: 14px; cursor: pointer;
            border: 2px solid transparent; position: relative;
            transition: transform .2s ease, border-color .2s ease;
        }
        .swatch-dot:hover { transform: translateY(-3px) scale(1.05); }
        .swatch-dot.active { border-color: var(--text-main); box-shadow: 0 0 0 3px var(--glass-shadow); }
        .swatch-dot.active::after {
            content: "\f26e"; font-family: "bootstrap-icons"; color: #fff;
            position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
            font-size: 1.1rem; text-shadow: 0 1px 3px rgba(0,0,0,.4);
        }
        .swatch-dot[data-sw="0"] { background: var(--sw-0, linear-gradient(135deg,#e8c88a,#c49a3c)); }
        .swatch-dot[data-sw="1"] { background: var(--sw-1, linear-gradient(135deg,#f29a82,#c94f30)); }
        .swatch-dot[data-sw="2"] { background: var(--sw-2, linear-gradient(135deg,#b5d4a8,#4a8a38)); }
        .swatch-dot[data-sw="3"] { background: var(--sw-3, linear-gradient(135deg,#a8d8b0,#2e8a50)); }
        .swatch-dot[data-sw="4"] { background: var(--sw-4, linear-gradient(135deg,#f0b8c8,#c83860)); }
        .swatch-dot[data-sw="5"] { background: var(--sw-5, linear-gradient(135deg,#a8cce8,#2e6aa8)); }
        .swatch-dot[data-sw="6"] { background: var(--sw-6, linear-gradient(135deg,#f4b87e,#d47230)); }
        .swatch-dot[data-sw="7"] { background: var(--sw-7, linear-gradient(135deg,#d8b8e8,#8a3ec4)); }
        .swatch-dot[data-sw="8"] { background: var(--sw-8, linear-gradient(135deg,#a0e0d0,#1e9a82)); }
        .swatch-dot[data-sw="9"] { background: var(--sw-9, linear-gradient(135deg,#d8a878,#8a5a28)); }

        /* ── وضعیت لودینگ دکمه ذخیره ─────────────────────────────── */
        .btn-accent { position: relative; overflow: hidden; }
        .btn-accent[disabled] { cursor: not-allowed; opacity: .85; }
        .btn-spinner {
            display: none; width: 18px; height: 18px;
            border: 2.5px solid rgba(255,255,255,.4); border-top-color: currentColor;
            border-radius: 50%; animation: spin .7s linear infinite;
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        .btn-accent.is-loading .btn-label { opacity: 0; }
        .btn-accent.is-loading .btn-spinner {
            display: inline-block; position: absolute; top: 50%; left: 50%; margin: -9px 0 0 -9px;
        }
    </style>
</head>
<body>

<div class="glass-card">
    <h5 class="fw-bold mb-4 text-center d-flex align-items-center justify-content-center gap-2">
        <i class="bi bi-tags-fill text-accent"></i>
        ویرایش اطلاعات دسته‌بندی
    </h5>
<form action="/admin/category/update/<%= category._id %>" method="POST" enctype="multipart/form-data" class="row g-3" id="editCategoryForm">
    <div class="col-12">
        <label class="form-label fw-medium text-muted">نام فارسی</label>
        <input type="text" name="nameFa" class="form-control glass-input"
               value="<%= category.name %>" required>
    </div>
    <div class="col-12">
        <label class="form-label fw-medium text-muted">نام انگلیسی</label>
        <input type="text" name="nameEn" class="form-control glass-input"
               value="<%= category.enname %>" required>
    </div>

    <!-- تصویر / وکتور دسته‌بندی -->
    <div class="col-12">
        <label class="form-label fw-medium text-muted">تصویر دسته‌بندی</label>

        <!-- پیش‌نمایش زنده -->
        <div class="d-flex align-items-center gap-3 mb-3 p-3 rounded-3 cat-visual-preview">
            <div class="cat-visual-preview-box" id="catVisualPreviewBox">
                <% if (category.imageUrl) { %>
                    <img src="<%= category.imageUrl %>" alt="" id="catVisualPreviewImg">
                <% } else { %>
                    <i class="bi bi-image" id="catVisualPlaceholderIcon"></i>
                <% } %>
            </div>
            <div>
                <span class="fw-medium d-block" id="catVisualPreviewLabel">
                    <%= category.imageUrl ? 'تصویر انتخاب‌شده' : 'هیچ تصویری انتخاب نشده' %>
                </span>
                <span class="cat-visual-preview-hint">یکی از وکتورهای آماده را انتخاب کنید یا تصویر دلخواه آپلود کنید</span>
            </div>
        </div>

        <!-- گرید وکتورهای از پیش آپلود شده -->
        <div class="visual-picker-grid" id="visualPickerGrid"></div>

        <!-- آپلود تصویر/وکتور دلخواه -->
        <label class="cat-img-upload mt-3" id="catImgDrop" for="catImageInput">
            <div class="cat-img-upload-icon"><i class="bi bi-cloud-arrow-up"></i></div>
            <div class="txt flex-grow-1">
                <strong>آپلود تصویر یا وکتور دلخواه</strong>
                <span>SVG / PNG / JPG — برای آپلود کلیک یا فایل را اینجا رها کنید</span>
            </div>
            <button type="button" class="cat-img-remove <%= category.imageUrl ? 'show' : '' %>" id="catImgRemoveBtn" title="حذف تصویر">
                <i class="bi bi-x-lg"></i>
            </button>
            <input type="file" name="image" id="catImageInput" accept="image/*,.svg" class="visually-hidden">
        </label>

        <!-- مقدار نهایی (مسیر وکتور پیش‌فرض انتخاب‌شده، یا مقدار فعلی؛ در صورت آپلود فایل، سرور باید فایل را در اولویت قرار دهد) -->
        <input type="hidden" name="imageUrl" id="selectedImageUrl" value="<%= category.imageUrl || '' %>">
    </div>

    <!-- سواتچ رنگی/گرادیان دسته‌بندی -->
    <div class="col-12">
        <label class="form-label fw-medium text-muted">رنگ/گرادیان اختصاصی دسته‌بندی</label>
        <div class="swatch-grid" id="swatchGrid">
            <% for (var s = 0; s <= 9; s++) { %>
                <div class="swatch-dot <%= (category.color !== undefined && String(category.color) === String(s)) ? 'active' : '' %>"
                     data-sw="<%= s %>" title="سواتچ <%= s %>"></div>
            <% } %>
        </div>
        <input type="hidden" name="color" id="selectedSwatch" value="<%= typeof category.color !== 'undefined' ? category.color : '' %>">
    </div>

    <div class="col-12 mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-accent" id="saveCategoryBtn">
            <span class="btn-label"><i class="bi bi-check-circle me-1"></i> ذخیره تغییرات</span>
            <span class="btn-spinner" aria-hidden="true"></span>
        </button>
        <a href="/admin" class="btn btn-glass">انصراف</a>
    </div>
</form>
</div>

<script>
    // نکته: تم پیش از رندر توسط اسکریپت ضدفلاش در <head> ست شده (کلید مشترک nanonan-theme)

    /* ── وکتورهای از پیش آپلود‌شده — مسیر واقعی فایل‌ها روی سرور
       این فایل‌ها باید در public/images/categories/presets/ قرار بگیرند
       (۱۰ فایل SVG پیوست‌شده در پاسخ). برای افزودن وکتور جدید فقط
       فایل را در همان مسیر قرار داده و یک آیتم به این آرایه اضافه کنید. */
    const CATEGORY_PRESETS = [
        { file: 'bread.svg',         label: 'نان' },
        { file: 'croissant.svg',     label: 'کرواسان' },
        { file: 'coffee.svg',        label: 'قهوه' },
        { file: 'cake.svg',          label: 'کیک' },
        { file: 'cupcake.svg',       label: 'کاپ‌کیک' },
        { file: 'donut.svg',         label: 'دونات' },
        { file: 'cookie.svg',        label: 'کوکی' },
        { file: 'cinnamon-roll.svg', label: 'رول دارچین' },
        { file: 'sandwich.svg',      label: 'ساندویچ' },
        { file: 'milk.svg',          label: 'شیر' }
    ];
    const PRESET_BASE_PATH = '/images/categories/presets/';

    (function () {
        const grid         = document.getElementById('visualPickerGrid');
        const hiddenUrl     = document.getElementById('selectedImageUrl');
        const previewBox    = document.getElementById('catVisualPreviewBox');
        const previewLabel  = document.getElementById('catVisualPreviewLabel');
        const fileInput     = document.getElementById('catImageInput');
        const removeBtn     = document.getElementById('catImgRemoveBtn');
        const currentValue  = hiddenUrl.value;

        function fullPath(file) { return PRESET_BASE_PATH + file; }

        function setPreview(src, label) {
            if (src) {
                previewBox.innerHTML = `<img src="${src}" alt="" id="catVisualPreviewImg">`;
            } else {
                previewBox.innerHTML = `<i class="bi bi-image" id="catVisualPlaceholderIcon"></i>`;
            }
            previewLabel.textContent = label || 'هیچ تصویری انتخاب نشده';
            removeBtn.classList.toggle('show', Boolean(src));
        }

        function highlightActive(activeFile) {
            grid.querySelectorAll('.visual-picker-item').forEach(item => {
                item.classList.toggle('active', item.dataset.file === activeFile);
            });
        }

        function renderGrid() {
            grid.innerHTML = '';
            CATEGORY_PRESETS.forEach(preset => {
                const path = fullPath(preset.file);
                const isActive = currentValue === path;
                const item = document.createElement('div');
                item.className = 'visual-picker-item' + (isActive ? ' active' : '');
                item.dataset.file = path;
                item.title = preset.label;
                item.innerHTML = `<img src="${path}" alt="${preset.label}" loading="lazy">`;
                item.addEventListener('click', () => {
                    fileInput.value = '';               // انصراف از فایل آپلودی احتمالی
                    hiddenUrl.value = path;
                    highlightActive(path);
                    setPreview(path, preset.label);
                });
                grid.appendChild(item);
            });
        }

        renderGrid();

        /* ── آپلود وکتور/تصویر دلخواه: پیش‌نمایش زنده + Drag&Drop + حذف ── */
        const dropZone = document.getElementById('catImgDrop');

        fileInput.addEventListener('change', function () {
            const file = this.files && this.files[0];
            if (!file) return;
            highlightActive(null); // انتخاب از گرید پریست‌ها لغو می‌شود
            const reader = new FileReader();
            reader.onload = e => setPreview(e.target.result, file.name);
            reader.readAsDataURL(file);
        });

        removeBtn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            fileInput.value = '';
            hiddenUrl.value = '';
            highlightActive(null);
            setPreview(null, null);
        });

        ['dragenter', 'dragover'].forEach(evt => {
            dropZone.addEventListener(evt, e => { e.preventDefault(); dropZone.classList.add('dragover'); });
        });
        ['dragleave', 'drop'].forEach(evt => {
            dropZone.addEventListener(evt, e => { e.preventDefault(); dropZone.classList.remove('dragover'); });
        });
        dropZone.addEventListener('drop', function (e) {
            const file = e.dataTransfer.files && e.dataTransfer.files[0];
            if (!file) return;
            fileInput.files = e.dataTransfer.files;
            fileInput.dispatchEvent(new Event('change'));
        });
    })();

/* ── انتخاب سواتچ رنگی/گرادیان ─────────────────────────────────────── */
(function () {
    const grid = document.getElementById('swatchGrid');
    const hidden = document.getElementById('selectedSwatch');
    if (!grid) return;
    grid.querySelectorAll('.swatch-dot').forEach(dot => {
        dot.addEventListener('click', () => {
            grid.querySelectorAll('.swatch-dot').forEach(d => d.classList.remove('active'));
            dot.classList.add('active');
            hidden.value = dot.getAttribute('data-sw');
        });
    });
})();

/* ── لودینگ تعاملی هنگام ذخیره‌ی فرم ─────────────────────────────────── */
(function () {
    const form = document.getElementById('editCategoryForm');
    const btn  = document.getElementById('saveCategoryBtn');
    if (!form || !btn) return;
    form.addEventListener('submit', function () {
        if (!form.checkValidity()) return;
        btn.classList.add('is-loading');
        btn.setAttribute('disabled', 'disabled');
    });
})();
</script>
</body>
</html>