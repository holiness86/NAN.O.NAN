<!DOCTYPE html>
<html lang="fa" dir="rtl" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ویرایش دسته‌بندی | نان و نان</title>
    <link href="/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/icons-1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        :root {
            --bg-gradient-1: #FAF7F2;
            --bg-gradient-2: #F0EAE0;
            --bg-gradient-3: #FFFFFF;
            --glass-bg: rgba(255, 255, 255, 0.45);
            --glass-border: rgba(184, 134, 11, 0.15);
            --glass-shadow: rgba(80, 50, 10, 0.05);
            --text-main: #1A1208;
            --text-muted: #6B5230;
            --input-bg: rgba(255, 255, 255, 0.7);
            --input-focus: rgba(255, 255, 255, 0.95);
            --accent-color: #B8860B;
            --accent-hover: #D4A843;
        }
        [data-theme="dark"] {
            --bg-gradient-1: #120C05;
            --bg-gradient-2: #1A1208;
            --bg-gradient-3: #1F160B;
            --glass-bg: rgba(26, 18, 8, 0.55);
            --glass-border: rgba(184, 134, 11, 0.2);
            --glass-shadow: rgba(0, 0, 0, 0.5);
            --text-main: #FAF7F2;
            --text-muted: #D4A843;
            --input-bg: rgba(18, 12, 5, 0.5);
            --input-focus: rgba(18, 12, 5, 0.8);
            --accent-color: #D4A843;
            --accent-hover: #B8860B;
        }
        body {
            background: linear-gradient(-45deg, var(--bg-gradient-1), var(--bg-gradient-2), var(--bg-gradient-3));
            color: var(--text-main);
            font-family: 'Vazirmatn', Tahoma, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }
        .glass-card {
            background: var(--glass-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            box-shadow: 0 8px 32px var(--glass-shadow);
            width: 100%;
            max-width: 500px;
            padding: 2.5rem;
        }
        .glass-input {
            background: var(--input-bg) !important;
            border: 1px solid var(--glass-border) !important;
            color: var(--text-main) !important;
            border-radius: 14px;
            padding: 0.75rem 1rem;
            transition: all 0.3s ease;
        }
        .glass-input:focus {
            box-shadow: 0 0 0 3px rgba(184, 134, 11, 0.2) !important;
            border-color: var(--accent-color) !important;
            background: var(--input-focus) !important;
        }
        .btn-accent {
            background: linear-gradient(135deg, var(--accent-color), var(--accent-hover));
            color: #1A1208 !important;
            border: none;
            border-radius: 14px;
            padding: 0.75rem 1.5rem;
            font-weight: 600;
            width: 100%;
            transition: all 0.3s ease;
        }
        [data-theme="dark"] .btn-accent {
            color: #120C05 !important;
        }
        .btn-accent:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(184, 134, 11, 0.3);
        }
        .btn-glass {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--glass-border);
            color: var(--text-main);
            border-radius: 14px;
            padding: 0.75rem 1.5rem;
            width: 100%;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
            text-align: center;
        }
        .btn-glass:hover {
            background: var(--glass-hover);
            color: var(--text-main);
        }
        /* مرورگرهای مدرن (Chrome, Firefox, Safari, Edge) */
 input::placeholder,
 textarea::placeholder {
  color: var(--text-main) !important;
  opacity: 1; /* برای فیکس کردن رنگ سفید خالص در فایرفاکس */
}

/* مرورگر Internet Explorer 10-11 */
 input:-ms-input-placeholder,
textarea:-ms-input-placeholder {
  color: var(--text-main) !important;
}

/* نسخه قدیمی مرورگر Edge */
 input::-ms-input-placeholder,
textarea::-ms-input-placeholder {
  color: var(--text-main) !important;
}

        /* ── انیمیشن ورود کارت ─────────────────────────────────── */
        @keyframes cardPop { 0% { opacity: 0; transform: translateY(24px) scale(.97); } 100% { opacity: 1; transform: translateY(0) scale(1); } }
        @keyframes fieldIn { 0% { opacity: 0; transform: translateY(12px); } 100% { opacity: 1; transform: translateY(0); } }
        .glass-card { animation: cardPop .6s cubic-bezier(.22,1,.36,1) both; }
        .glass-card > form > .col-12 { animation: fieldIn .45s ease both; }
        .glass-card > form > .col-12:nth-child(1) { animation-delay: .06s; }
        .glass-card > form > .col-12:nth-child(2) { animation-delay: .12s; }
        .glass-card > form > .col-12:nth-child(3) { animation-delay: .18s; }
        .glass-card > form > .col-12:nth-child(4) { animation-delay: .24s; }
        .glass-card > form > .col-12:nth-child(5) { animation-delay: .30s; }

        /* ── باکس آپلود تصویر دسته‌بندی ──────────────────────────── */
        .cat-img-upload {
            display: flex; align-items: center; gap: 1rem;
            padding: .9rem; border-radius: 16px;
            background: var(--input-bg); border: 1px dashed var(--glass-border);
            transition: all .25s ease; cursor: pointer;
        }
        .cat-img-upload:hover, .cat-img-upload.dragover {
            border-color: var(--accent-color);
            background: rgba(184,134,11,0.08);
        }
        .cat-img-preview-box {
            width: 64px; height: 64px; border-radius: 16px; flex-shrink: 0;
            overflow: hidden; display: flex; align-items: center; justify-content: center;
            background: var(--glass-bg); border: 1px solid var(--glass-border);
            font-size: 1.5rem; color: var(--accent-color);
        }
        .cat-img-preview-box img { width: 100%; height: 100%; object-fit: cover; animation: fieldIn .4s ease; }
        .cat-img-upload .txt strong { display: block; font-size: .85rem; }
        .cat-img-upload .txt span { font-size: .74rem; color: var(--text-muted); }
        .cat-img-remove {
            border: none; background: rgba(214,69,59,0.12); color: #D6453B;
            border-radius: 10px; width: 32px; height: 32px; flex-shrink: 0;
            display: none; align-items: center; justify-content: center;
        }
        .cat-img-remove.show { display: flex; }

        /* ── سواتچ‌های رنگی گرادیانی (هماهنگ با style.css: --sw-0..9) ── */
        .swatch-grid {
            display: grid; grid-template-columns: repeat(5, 1fr);
            gap: 10px; margin-top: .5rem;
        }
        .swatch-dot {
            aspect-ratio: 1/1; border-radius: 14px; cursor: pointer;
            border: 2px solid transparent; position: relative;
            transition: transform .2s ease, border-color .2s ease;
        }
        .swatch-dot:hover { transform: translateY(-3px) scale(1.05); }
        .swatch-dot.active { border-color: var(--text-main); box-shadow: 0 0 0 3px var(--glass-shadow); }
        .swatch-dot.active::after {
            content: "\f26e"; font-family: "bootstrap-icons"; color: #fff;
            position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
            font-size: 1.1rem; text-shadow: 0 1px 3px rgba(0,0,0,.4);
        }
        .swatch-dot[data-sw="0"] { background: var(--sw-0, linear-gradient(135deg,#e8c88a,#c49a3c)); }
        .swatch-dot[data-sw="1"] { background: var(--sw-1, linear-gradient(135deg,#f29a82,#c94f30)); }
        .swatch-dot[data-sw="2"] { background: var(--sw-2, linear-gradient(135deg,#b5d4a8,#4a8a38)); }
        .swatch-dot[data-sw="3"] { background: var(--sw-3, linear-gradient(135deg,#a8d8b0,#2e8a50)); }
        .swatch-dot[data-sw="4"] { background: var(--sw-4, linear-gradient(135deg,#f0b8c8,#c83860)); }
        .swatch-dot[data-sw="5"] { background: var(--sw-5, linear-gradient(135deg,#a8cce8,#2e6aa8)); }
        .swatch-dot[data-sw="6"] { background: var(--sw-6, linear-gradient(135deg,#f4b87e,#d47230)); }
        .swatch-dot[data-sw="7"] { background: var(--sw-7, linear-gradient(135deg,#d8b8e8,#8a3ec4)); }
        .swatch-dot[data-sw="8"] { background: var(--sw-8, linear-gradient(135deg,#a0e0d0,#1e9a82)); }
        .swatch-dot[data-sw="9"] { background: var(--sw-9, linear-gradient(135deg,#d8a878,#8a5a28)); }

        /* ── وضعیت لودینگ دکمه ذخیره ─────────────────────────────── */
        .btn-accent { position: relative; overflow: hidden; }
        .btn-accent[disabled] { cursor: not-allowed; opacity: .85; }
        .btn-spinner {
            display: none; width: 18px; height: 18px;
            border: 2.5px solid rgba(255,255,255,.4); border-top-color: currentColor;
            border-radius: 50%; animation: spin .7s linear infinite;
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        .btn-accent.is-loading .btn-label { opacity: 0; }
        .btn-accent.is-loading .btn-spinner {
            display: inline-block; position: absolute; top: 50%; left: 50%; margin: -9px 0 0 -9px;
        }
    </style>
</head>
<body>

<div class="glass-card">
    <h5 class="fw-bold mb-4 text-center d-flex align-items-center justify-content-center gap-2">
        <i class="bi bi-tags-fill text-accent"></i>
        ویرایش اطلاعات دسته‌بندی
    </h5>
<form action="/admin/category/update/<%= category._id %>" method="POST" enctype="multipart/form-data" class="row g-3" id="editCategoryForm">
    <div class="col-12">
        <label class="form-label fw-medium text-muted">نام فارسی</label>
        <input type="text" name="nameFa" class="form-control glass-input"
               value="<%= category.name %>" required>
    </div>
    <div class="col-12">
        <label class="form-label fw-medium text-muted">نام انگلیسی</label>
        <input type="text" name="nameEn" class="form-control glass-input"
               value="<%= category.enname %>" required>
    </div>

    <!-- آیکون -->
    <div class="col-12">
        <label class="form-label fw-medium text-muted">آیکون دسته‌بندی</label>

        <!-- پیش‌نمایش -->
        <div class="d-flex align-items-center gap-3 mb-3 p-3 rounded-3"
             style="background: rgba(184,134,11,0.08); border: 1px solid var(--glass-border);">
            <div id="iconPreview"
                 style="width:48px; height:48px; border-radius:14px;
                        background: var(--glass-bg); border: 1px solid var(--glass-border);
                        display:flex; align-items:center; justify-content:center;
                        font-size:1.4rem; color: var(--accent-color);">
                <i class="bi <%= category.icon || 'bi-grid' %>" id="previewIcon"></i>
            </div>
            <div>
                <span class="fw-medium d-block" id="previewName"><%= category.icon || 'bi-grid' %></span>
                <span style="font-size:0.8rem; color: var(--text-muted);">آیکون انتخاب‌شده</span>
            </div>
        </div>

        <!-- جستجو -->
        <input type="text" id="iconSearch" class="form-control glass-input mb-3"
               placeholder="جستجو... (مثال: cup, fire, heart)">

        <!-- گرید آیکون‌ها -->
        <div id="iconGrid"
             style="display:grid; grid-template-columns: repeat(auto-fill, minmax(52px,1fr));
                    gap:8px; max-height:220px; overflow-y:auto;
                    padding:10px; border-radius:14px;
                    background: var(--input-bg); border: 1px solid var(--glass-border);">
        </div>

        <!-- مقدار نهایی -->
        <input type="hidden" name="icon" id="selectedIcon" value="<%= category.icon || 'bi-grid' %>">
    </div>

    <!-- تصویر اختصاصی دسته‌بندی -->
    <div class="col-12">
        <label class="form-label fw-medium text-muted">تصویر اختصاصی دسته‌بندی (اختیاری)</label>
        <label class="cat-img-upload" id="catImgDrop" for="catImageInput">
            <div class="cat-img-preview-box" id="catImgPreviewBox">
                <% if (category.imageUrl) { %>
                    <img src="<%= category.imageUrl %>" alt="" id="catImgPreview">
                <% } else { %>
                    <i class="bi bi-image" id="catImgPlaceholderIcon"></i>
                <% } %>
            </div>
            <div class="txt flex-grow-1">
                <strong>برای آپلود کلیک یا تصویر را رها کنید</strong>
                <span>PNG / JPG — در صورت خالی گذاشتن، آیکون فعلی استفاده می‌شود</span>
            </div>
            <button type="button" class="cat-img-remove <%= category.imageUrl ? 'show' : '' %>" id="catImgRemoveBtn" title="حذف تصویر">
                <i class="bi bi-x-lg"></i>
            </button>
            <input type="file" name="image" id="catImageInput" accept="image/*" class="visually-hidden">
        </label>
    </div>

    <!-- سواتچ رنگی/گرادیان دسته‌بندی -->
    <div class="col-12">
        <label class="form-label fw-medium text-muted">رنگ/گرادیان اختصاصی دسته‌بندی</label>
        <div class="swatch-grid" id="swatchGrid">
            <% for (var s = 0; s <= 9; s++) { %>
                <div class="swatch-dot <%= (category.color !== undefined && String(category.color) === String(s)) ? 'active' : '' %>"
                     data-sw="<%= s %>" title="سواتچ <%= s %>"></div>
            <% } %>
        </div>
        <input type="hidden" name="color" id="selectedSwatch" value="<%= typeof category.color !== 'undefined' ? category.color : '' %>">
    </div>

    <div class="col-12 mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-accent" id="saveCategoryBtn">
            <span class="btn-label"><i class="bi bi-check-circle me-1"></i> ذخیره تغییرات</span>
            <span class="btn-spinner" aria-hidden="true"></span>
        </button>
        <a href="/admin" class="btn btn-glass">انصراف</a>
    </div>
</form>
</div>

<script>
    window.addEventListener('DOMContentLoaded', () => {
        const savedTheme = localStorage.getItem('admin_theme') || 'dark';
        document.documentElement.setAttribute('data-theme', savedTheme);
    });


    const ICONS = [
  'bi-grid','bi-cup-hot','bi-cup-hot-fill','bi-cup-straw',
  'bi-egg-fried','bi-egg-fill','bi-fire','bi-flower1','bi-flower2',
  'bi-pie-chart-fill','bi-heart-fill','bi-star-fill','bi-star',
  'bi-droplet-fill','bi-droplet','bi-water','bi-snow2','bi-snow3',
  'bi-brightness-alt-high','bi-layers-fill','bi-circle-fill',
  'bi-grid-fill','bi-grid-3x3-gap-fill','bi-box-seam-fill',
  'bi-bag-fill','bi-cart-fill','bi-basket-fill',
  'bi-cup','bi-cup-fill','bi-thermometer-half',
  'bi-lightning-fill','bi-moon-stars-fill','bi-sun-fill',
  'bi-leaf','bi-tree','bi-award-fill','bi-bookmark-fill',
  'bi-clock-fill','bi-gem','bi-globe','bi-house-fill',
  'bi-music-note-beamed','bi-palette-fill','bi-percent',
  'bi-pin-map-fill','bi-shop','bi-shop-window','bi-tag-fill',
  'bi-tags-fill','bi-truck','bi-emoji-smile-fill',
  'bi-hexagon-fill','bi-people-fill','bi-person-fill',
  'bi-trophy-fill','bi-umbrella-fill','bi-wrench-adjustable',
  'bi-puzzle-fill','bi-robot','bi-send-fill','bi-sliders2',
  'bi-speedometer2','bi-table','bi-zoom-in'
];

let filteredIcons = [...ICONS];

function renderIconGrid(list) {
    const grid = document.getElementById('iconGrid');
    const current = document.getElementById('selectedIcon').value;
    grid.innerHTML = '';

    list.forEach(icon => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.title = icon;
        const isActive = current === icon;
        btn.style.cssText = `
            width:52px; height:52px; border-radius:12px;
            background: ${isActive ? 'rgba(184,134,11,0.2)' : 'var(--glass-bg)'};
            border: 1px solid ${isActive ? 'var(--accent-color)' : 'var(--glass-border)'};
            display:flex; align-items:center; justify-content:center;
            font-size:1.25rem;
            color: ${isActive ? 'var(--accent-color)' : 'var(--text-main)'};
            cursor:pointer; transition: all .2s ease;
        `;
        btn.innerHTML = `<i class="bi ${icon}"></i>`;

        btn.addEventListener('mouseenter', () => {
            btn.style.background = 'rgba(184,134,11,0.15)';
            btn.style.borderColor = 'var(--accent-color)';
            btn.style.color = 'var(--accent-color)';
            btn.style.transform = 'scale(1.12)';
        });
        btn.addEventListener('mouseleave', () => {
            const sel = document.getElementById('selectedIcon').value;
            const active = sel === icon;
            btn.style.background  = active ? 'rgba(184,134,11,0.2)' : 'var(--glass-bg)';
            btn.style.borderColor = active ? 'var(--accent-color)' : 'var(--glass-border)';
            btn.style.color       = active ? 'var(--accent-color)' : 'var(--text-main)';
            btn.style.transform   = 'scale(1)';
        });

        btn.addEventListener('click', () => {
            document.getElementById('selectedIcon').value = icon;
            document.getElementById('previewIcon').className = `bi ${icon}`;
            document.getElementById('previewName').textContent = icon;
            renderIconGrid(filteredIcons); // رفرش برای هایلایت
        });

        grid.appendChild(btn);
    });
}

document.addEventListener('DOMContentLoaded', () => {
    renderIconGrid(ICONS);

    document.getElementById('iconSearch').addEventListener('input', function () {
        const q = this.value.toLowerCase().trim();
        filteredIcons = q ? ICONS.filter(i => i.includes(q)) : [...ICONS];
        renderIconGrid(filteredIcons);
    });
});

/* ── آپلود تصویر دسته‌بندی: پیش‌نمایش زنده + Drag&Drop + حذف ─────────── */
(function () {
    const dropZone   = document.getElementById('catImgDrop');
    const fileInput  = document.getElementById('catImageInput');
    const previewBox = document.getElementById('catImgPreviewBox');
    const removeBtn  = document.getElementById('catImgRemoveBtn');

    function renderPreview(src) {
        previewBox.innerHTML = src
            ? `<img src="${src}" alt="" id="catImgPreview">`
            : `<i class="bi bi-image" id="catImgPlaceholderIcon"></i>`;
        removeBtn.classList.toggle('show', Boolean(src));
    }

    fileInput.addEventListener('change', function () {
        const file = this.files && this.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = e => renderPreview(e.target.result);
        reader.readAsDataURL(file);
    });

    removeBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        fileInput.value = '';
        renderPreview(null);
    });

    ['dragenter', 'dragover'].forEach(evt => {
        dropZone.addEventListener(evt, e => { e.preventDefault(); dropZone.classList.add('dragover'); });
    });
    ['dragleave', 'drop'].forEach(evt => {
        dropZone.addEventListener(evt, e => { e.preventDefault(); dropZone.classList.remove('dragover'); });
    });
    dropZone.addEventListener('drop', function (e) {
        const file = e.dataTransfer.files && e.dataTransfer.files[0];
        if (!file) return;
        fileInput.files = e.dataTransfer.files;
        fileInput.dispatchEvent(new Event('change'));
    });
})();

/* ── انتخاب سواتچ رنگی/گرادیان ─────────────────────────────────────── */
(function () {
    const grid = document.getElementById('swatchGrid');
    const hidden = document.getElementById('selectedSwatch');
    if (!grid) return;
    grid.querySelectorAll('.swatch-dot').forEach(dot => {
        dot.addEventListener('click', () => {
            grid.querySelectorAll('.swatch-dot').forEach(d => d.classList.remove('active'));
            dot.classList.add('active');
            hidden.value = dot.getAttribute('data-sw');
        });
    });
})();

/* ── لودینگ تعاملی هنگام ذخیره‌ی فرم ─────────────────────────────────── */
(function () {
    const form = document.getElementById('editCategoryForm');
    const btn  = document.getElementById('saveCategoryBtn');
    if (!form || !btn) return;
    form.addEventListener('submit', function () {
        if (!form.checkValidity()) return;
        btn.classList.add('is-loading');
        btn.setAttribute('disabled', 'disabled');
    });
})();
</script>
</body>
</html>