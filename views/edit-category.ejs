<!DOCTYPE html>
<html lang="fa" dir="rtl" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ویرایش دسته‌بندی | بابل تیله رزکان</title>

    <script>
      (function () {
        try {
          var t = localStorage.getItem('bubbleteale-theme');
          if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-bs-theme', t);
        } catch (e) {}
      })();
    </script>

    <link href="/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/icons-1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        :root, [data-bs-theme="light"] {
            --bg-gradient-1: var(--cream);
            --bg-gradient-2: var(--cream-deep);
            --bg-gradient-3: var(--surface-raised);
            --glass-bg: var(--surface-glass);
            --glass-border: var(--border-warm);
            --glass-shadow: rgba(var(--ink-rgb), .08);
            --glass-hover: var(--brand-soft);
            --text-main: var(--ink);
            --text-muted: var(--ink-muted);
            --input-bg: rgba(255, 255, 255, 0.65);
            --input-focus: rgba(255, 255, 255, 0.92);
            --accent-color: var(--brand);
            --accent-hover: var(--brand-dark);
        }
        [data-bs-theme="dark"] {
            --bg-gradient-1: var(--cream);
            --bg-gradient-2: var(--cream-deep);
            --bg-gradient-3: var(--surface-raised);
            --glass-bg: var(--surface-glass);
            --glass-border: var(--border-warm);
            --glass-shadow: rgba(0, 0, 0, 0.5);
            --glass-hover: var(--brand-soft);
            --text-main: var(--ink);
            --text-muted: var(--ink-muted);
            --input-bg: rgba(0, 0, 0, 0.3);
            --input-focus: rgba(0, 0, 0, 0.5);
            --accent-color: var(--brand);
            --accent-hover: var(--brand-dark);
        }
        body {
            background: linear-gradient(-45deg, var(--bg-gradient-1), var(--bg-gradient-2), var(--bg-gradient-3));
            color: var(--text-main);
            font-family: 'YekanBakh', Tahoma, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }
        .glass-card {
            background: var(--glass-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 30px;
            border-radius: max(30px, 1.85rem);
            box-shadow: 0 12px 40px var(--glass-shadow);
            width: 100%;
            max-width: 980px;
            padding: 2.6rem;
        }
        .glass-input {
            background: var(--input-bg) !important;
            border: 1px solid var(--glass-border) !important;
            color: var(--text-main) !important;
            border-radius: 16px !important;
            padding: 0.75rem 1rem;
            transition: all 0.3s ease;
        }
        .glass-input:focus {
            box-shadow: 0 0 0 4px rgba(87,45,119, 0.2) !important;
            border-color: var(--accent-color) !important;
            background: var(--input-focus) !important;
        }
        .btn-accent {
            background: linear-gradient(135deg, var(--accent-color), var(--accent-hover));
            color: #FFFFFF !important;
            border: none;
            border-radius: 18px;
            padding: 0.75rem 1.6rem;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        .btn-accent:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(87,45,119, 0.3);
        }
        .btn-glass {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--glass-border);
            color: var(--text-main);
            border-radius: 18px;
            padding: 0.75rem 1.6rem;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .btn-glass:hover { background: var(--glass-hover); color: var(--text-main); }

        input::placeholder,
        textarea::placeholder { color: var(--text-main) !important; opacity: 1; }
        input:-ms-input-placeholder,
        textarea:-ms-input-placeholder { color: var(--text-main) !important; }
        input::-ms-input-placeholder,
        textarea::-ms-input-placeholder { color: var(--text-main) !important; }

        @keyframes cardPop { 0% { opacity: 0; transform: translateY(24px) scale(.97); } 100% { opacity: 1; transform: translateY(0) scale(1); } }
        @keyframes fieldIn { 0% { opacity: 0; transform: translateY(12px); } 100% { opacity: 1; transform: translateY(0); } }
        .glass-card { animation: cardPop .6s cubic-bezier(.22,1,.36,1) both; }
        .form-block { animation: fieldIn .45s ease both; }
        .form-block:nth-child(1) { animation-delay: .06s; }
        .form-block:nth-child(2) { animation-delay: .12s; }
        .form-block:nth-child(3) { animation-delay: .18s; }
        .category-form-preview { animation: fieldIn .5s ease .1s both; }

        .category-form-grid { display: grid; grid-template-columns: 1.55fr 1fr; gap: 1.6rem; align-items: start; }
        @media (max-width: 860px) { .category-form-grid { grid-template-columns: 1fr; } }

        .form-block {
            background: var(--glass-hover);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            padding: 1.25rem 1.3rem;
            margin-bottom: 1.1rem;
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
        }
        .form-block:focus-within { border-color: var(--accent-color); box-shadow: 0 0 0 4px rgba(87,45,119,0.12); }
        .form-block-title {
            display: flex; align-items: center; gap: 0.5rem;
            font-weight: 800; font-size: 0.86rem; color: var(--text-main);
            margin-bottom: 1rem;
        }
        .form-block-title i { color: var(--accent-color); font-size: 1rem; }

        .category-form-preview { position: sticky; top: 1rem; }
        .live-cat-card {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 28px;
            border-radius: max(28px, 1.75rem);
            padding: 1.6rem 1.3rem;
            text-align: center;
            box-shadow: 0 10px 30px var(--glass-shadow);
            transition: transform 0.4s cubic-bezier(.34,1.1,.64,1);
        }
        .live-cat-card:hover { transform: translateY(-4px); }
        .live-cat-icon {
            width: 92px; height: 92px; margin: 0 auto 1rem;
            border-radius: 30px; border-radius: max(30px, 1.85rem);
            display: flex; align-items: center; justify-content: center;
            overflow: hidden;
            background: var(--brand-soft);
            border: 1px solid var(--glass-border);
            color: var(--accent-color);
            font-size: 2.4rem;
        }
        .live-cat-icon img { width: 100%; height: 100%; object-fit: cover; }
        .live-cat-icon img.is-vector { object-fit: contain; padding: 14px; }
        .live-cat-name { font-weight: 800; font-size: 1.1rem; color: var(--text-main); margin-bottom: .2rem; }
        .live-cat-enname { font-size: .82rem; color: var(--text-muted); direction: ltr; }
        .live-cat-badge {
            display: inline-flex; align-items: center; gap: .35rem;
            margin-top: 1rem; padding: .35rem .9rem;
            border-radius: 50rem; background: var(--input-bg);
            border: 1px solid var(--glass-border);
            font-size: .74rem; font-weight: 700; color: var(--text-muted);
        }

        .cat-visual-preview { background: var(--brand-soft); border: 1px solid var(--glass-border); }
        .cat-visual-preview-box {
            width: 52px; height: 52px; border-radius: 16px; flex-shrink: 0;
            overflow: hidden; display: flex; align-items: center; justify-content: center;
            background: var(--glass-bg); border: 1px solid var(--glass-border);
            font-size: 1.4rem; color: var(--accent-color); padding: 6px;
        }
        .cat-visual-preview-box img { width: 100%; height: 100%; object-fit: contain; animation: fieldIn .4s ease; }
        .cat-visual-preview-hint { font-size: .78rem; color: var(--text-muted); display: block; }

        .visual-picker-grid {
            display: grid; grid-template-columns: repeat(6, 1fr);
            gap: 10px; max-height: 280px; overflow-y: auto;
            padding: 10px; border-radius: 18px;
            background: var(--input-bg); border: 1px solid var(--glass-border);
        }
        @media (max-width: 400px) {
            .visual-picker-grid { grid-template-columns: repeat(5, 1fr); }
        }
        .visual-picker-item {
            aspect-ratio: 1/1; border-radius: 16px; cursor: pointer;
            background: var(--glass-bg); border: 2px solid var(--glass-border);
            display: flex; align-items: center; justify-content: center;
            padding: 8px; position: relative; transition: transform .2s ease, border-color .2s ease;
        }
        .visual-picker-item img { width: 100%; height: 100%; object-fit: contain; }
        .visual-picker-item:hover { transform: translateY(-3px) scale(1.05); border-color: var(--accent-light); }
        .visual-picker-item.active { border-color: var(--accent-color); background: var(--brand-soft); }
        .visual-picker-item.active::after {
            content: "\f26e"; font-family: "bootstrap-icons"; color: var(--accent-color);
            position: absolute; bottom: -4px; left: -4px;
            width: 18px; height: 18px; border-radius: 50%;
            background: var(--surface, #fff); display: flex; align-items: center; justify-content: center;
            font-size: .7rem; box-shadow: 0 2px 6px rgba(0,0,0,.25);
        }

        .cat-img-upload {
            display: flex; align-items: center; gap: 1rem;
            padding: .9rem; border-radius: 18px;
            background: var(--input-bg); border: 1px dashed var(--glass-border);
            transition: all .25s ease; cursor: pointer;
        }
        .cat-img-upload:hover, .cat-img-upload.dragover {
            border-color: var(--accent-color);
            background: var(--brand-soft);
        }
        .cat-img-upload-icon {
            width: 44px; height: 44px; border-radius: 16px; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
            background: var(--glass-bg); border: 1px solid var(--glass-border);
            font-size: 1.2rem; color: var(--accent-color);
        }
        .cat-img-upload .txt strong { display: block; font-size: .85rem; }
        .cat-img-upload .txt span { font-size: .74rem; color: var(--text-muted); }
        .cat-img-remove {
            border: none; background: rgba(214,69,59,0.12); color: #D6453B;
            border-radius: 12px; width: 32px; height: 32px; flex-shrink: 0;
            display: none; align-items: center; justify-content: center;
        }
        .cat-img-remove.show { display: flex; }

        .btn-accent { position: relative; overflow: hidden; }
        .btn-accent[disabled] { cursor: not-allowed; opacity: .85; }
        .btn-spinner {
            display: none; width: 18px; height: 18px;
            border: 2.5px solid rgba(255,255,255,.4); border-top-color: currentColor;
            border-radius: 50%; animation: spin .7s linear infinite;
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        .btn-accent.is-loading .btn-label { opacity: 0; }
        .btn-accent.is-loading .btn-spinner {
            display: inline-block; position: absolute; top: 50%; left: 50%; margin: -9px 0 0 -9px;
        }

        .cat-type-toggle {
            display: inline-flex; gap: 0.4rem; padding: 0.3rem;
            background: var(--glass-hover); border: 1px solid var(--glass-border);
            border-radius: 50rem; width: 100%;
        }
        .cat-type-btn {
            flex: 1 1 0; border: none; background: transparent; color: var(--text-muted);
            font-weight: 700; font-size: 0.82rem; padding: 0.55rem 0.8rem; border-radius: 50rem;
            display: flex; align-items: center; justify-content: center; gap: 0.4rem;
            cursor: pointer; transition: all 0.25s ease;
        }
        .cat-type-btn.active {
            background: linear-gradient(135deg, var(--accent-color), var(--accent-hover));
            color: #FFFFFF; box-shadow: 0 4px 14px rgba(87,45,119,0.28);
        }
        .cat-parent-wrap {
            overflow: hidden;
            max-height: 0; opacity: 0; transform: translateY(-6px);
            transition: max-height 0.4s cubic-bezier(.22,1,.36,1), opacity 0.3s ease, transform 0.3s ease;
        }
        .cat-parent-wrap.show { max-height: 140px; opacity: 1; transform: translateY(0); margin-top: 1.1rem; }
    </style>
</head>
<body>

<div class="glass-card">
    <h5 class="fw-bold mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-tags-fill text-accent"></i>
        ویرایش اطلاعات دسته‌بندی
    </h5>

    <form action="/admin/category/update/<%= category._id %>" method="POST" enctype="multipart/form-data" id="editCategoryForm">
        <div class="category-form-grid">

            <div class="category-form-fields">
                <div class="form-block">
                    <div class="form-block-title"><i class="bi bi-diagram-3-fill"></i> نوع دسته‌بندی</div>
                    <div class="cat-type-toggle" id="editCatTypeToggle">
                        <button type="button" class="cat-type-btn" data-type="main">
                            <i class="bi bi-diagram-2-fill"></i> دسته اصلی
                        </button>
                        <button type="button" class="cat-type-btn" data-type="sub">
                            <i class="bi bi-diagram-3-fill"></i> زیرمجموعه یک دسته
                        </button>
                    </div>
                    <div class="cat-parent-wrap" id="editParentWrap">
                        <label class="form-label fw-medium text-muted small">نام دسته والد</label>
                        <input type="text" class="form-control glass-input" id="editParentInput" placeholder="مثال: نوشیدنی">
                        <div class="form-text">دقیقاً همان نام دسته اصلی موجود را وارد کنید.</div>
                    </div>
                </div>

                <div class="form-block">
                    <div class="form-block-title"><i class="bi bi-tag-fill"></i> نام‌گذاری</div>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-medium text-muted small" id="editCatNameLabel">نام فارسی</label>
                            <input type="text" name="nameFa" id="editCategoryNameInput" class="form-control glass-input"
                                   value="<%= category.name %>" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-medium text-muted small">نام انگلیسی</label>
                            <input type="text" name="nameEn" id="editCategoryEnnameInput" class="form-control glass-input"
                                   value="<%= category.enname %>" required>
                        </div>
                    </div>
                </div>

                <div class="form-block">
                    <div class="form-block-title"><i class="bi bi-image-fill"></i> تصویر دسته‌بندی</div>

                    <input type="text" id="visualPickerSearch" class="form-control glass-input mb-2"
                           placeholder="جستجو در وکتورها... (مثال: چای، شیر، مروارید)">

                    <div class="visual-picker-grid" id="visualPickerGrid"></div>

                    <label class="cat-img-upload mt-3" id="catImgDrop" for="catImageInput">
                        <div class="cat-img-upload-icon"><i class="bi bi-cloud-arrow-up"></i></div>
                        <div class="txt flex-grow-1">
                            <strong>آپلود تصویر یا وکتور دلخواه</strong>
                            <span>SVG / PNG / JPG — برای آپلود کلیک یا فایل را اینجا رها کنید</span>
                        </div>
                        <button type="button" class="cat-img-remove <%= category.imageUrl ? 'show' : '' %>" id="catImgRemoveBtn" title="حذف تصویر">
                            <i class="bi bi-x-lg"></i>
                        </button>
                        <input type="file" name="image" id="catImageInput" accept="image/png,image/jpeg,image/webp,image/svg+xml,.svg,.png,.jpg,.jpeg,.webp" class="visually-hidden">
                    </label>

                    <input type="hidden" name="imageUrl" id="selectedImageUrl" value="<%= category.imageUrl || '' %>">
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-accent flex-grow-1" id="saveCategoryBtn">
                        <span class="btn-label"><i class="bi bi-check-circle me-1"></i> ذخیره تغییرات</span>
                        <span class="btn-spinner" aria-hidden="true"></span>
                    </button>
                    <a href="/admin#categoryManage" class="btn btn-glass">انصراف</a>
                </div>
            </div>

            <div class="category-form-preview">
                <div class="form-block-title"><i class="bi bi-eye-fill"></i> پیش‌نمایش زنده</div>
                <div class="live-cat-card">
                    <div class="live-cat-icon" id="liveCatIcon">
                        <% if (category.imageUrl) { %>
                            <img src="<%= category.imageUrl %>" alt="" id="liveCatIconImg">
                        <% } else { %>
                            <i class="bi bi-image" id="liveCatIconPlaceholder"></i>
                        <% } %>
                    </div>
                    <div class="live-cat-name" id="liveCatName"><%= category.name %></div>
                    <div class="live-cat-enname" id="liveCatEnname"><%= category.enname %></div>
                    <span class="live-cat-badge"><i class="bi bi-tag"></i> دسته‌بندی</span>
                </div>
            </div>

        </div>
    </form>
</div>

<script>
    (function () {
        var CAT_SEP = ' — ';
        var toggle      = document.getElementById('editCatTypeToggle');
        var form        = document.getElementById('editCategoryForm');
        var parentWrap  = document.getElementById('editParentWrap');
        var parentInput = document.getElementById('editParentInput');
        var nameLabel   = document.getElementById('editCatNameLabel');
        var nameInput   = document.getElementById('editCategoryNameInput');
        var liveName    = document.getElementById('liveCatName');
        if (!toggle || !form) return;

        var currentFull = nameInput.value;
        var idx = currentFull.indexOf(CAT_SEP);
        var currentType = idx === -1 ? 'main' : 'sub';

        function setType(type, silent) {
            currentType = type;
            toggle.querySelectorAll('.cat-type-btn').forEach(function (b) {
                b.classList.toggle('active', b.getAttribute('data-type') === type);
            });
            if (type === 'sub') {
                parentWrap.classList.add('show');
                nameLabel.textContent = 'نام زیرمجموعه (فارسی)';
            } else {
                parentWrap.classList.remove('show');
                nameLabel.textContent = 'نام فارسی';
                if (!silent) nameInput.value = currentFull;
            }
        }

        if (currentType === 'sub') {
            parentInput.value = currentFull.slice(0, idx).trim();
            nameInput.value = currentFull.slice(idx + CAT_SEP.length).trim();
        }
        setType(currentType, true);

        toggle.querySelectorAll('.cat-type-btn').forEach(function (btn) {
            btn.addEventListener('click', function () { setType(btn.getAttribute('data-type')); });
        });

        nameInput.addEventListener('input', function () {
            liveName.textContent = nameInput.value.trim() || 'نام دسته‌بندی';
        });

        var ennameInput = document.getElementById('editCategoryEnnameInput');
        var liveEnname = document.getElementById('liveCatEnname');
        if (ennameInput && liveEnname) {
            ennameInput.addEventListener('input', function () {
                liveEnname.textContent = ennameInput.value.trim();
            });
        }

        form.addEventListener('submit', function (e) {
            if (currentType !== 'sub') return;
            var parentVal = parentInput.value.trim();
            if (!parentVal) {
                e.preventDefault();
                parentInput.focus();
                return;
            }
            nameInput.value = parentVal + CAT_SEP + nameInput.value.trim();
        });
    })();

    const CATEGORY_PRESETS = [
        { file: 'bread.svg',             label: 'نان' },
        { file: 'traditional-bread.svg', label: 'نان سنتی' },
        { file: 'fantasy-bread.svg',     label: 'نان فانتزی' },
        { file: 'bulky-bread.svg',       label: 'نان حجیم' },
        { file: 'croissant.svg',         label: 'کرواسان' },
        { file: 'pastry.svg',            label: 'شیرینی' },
        { file: 'dry-pastry.svg',        label: 'شیرینی خشک' },
        { file: 'wet-pastry.svg',        label: 'شیرینی تر' },
        { file: 'cake.svg',              label: 'کیک' },
        { file: 'birthday-cake.svg',     label: 'کیک تولد' },
        { file: 'cupcake.svg',           label: 'کاپ‌کیک' },
        { file: 'dessert.svg',           label: 'دسر' },
        { file: 'cookie.svg',            label: 'کوکی' },
        { file: 'biscuit.svg',           label: 'بیسکویت' },
        { file: 'donut.svg',             label: 'دونات' },
        { file: 'cinnamon-roll.svg',     label: 'رول دارچین' },
        { file: 'chocolate.svg',         label: 'شکلات' },
        { file: 'icecream.svg',          label: 'بستنی' },
        { file: 'coffee.svg',            label: 'قهوه' },
        { file: 'espresso.svg',          label: 'اسپرسو' },
        { file: 'tea.svg',               label: 'چای' },
        { file: 'hot-drink.svg',         label: 'نوشیدنی گرم' },
        { file: 'cold-drink.svg',        label: 'نوشیدنی سرد' },
        { file: 'smoothie.svg',          label: 'اسموتی' },
        { file: 'juice.svg',             label: 'آبمیوه' },
        { file: 'milk.svg',              label: 'شیر' },
        { file: 'breakfast.svg',         label: 'صبحانه' },
        { file: 'sandwich.svg',          label: 'ساندویچ' },
        { file: 'pizza.svg',             label: 'پیتزا' },
        { file: 'fastfood.svg',          label: 'فست‌فود' },
        { file: 'iranian-food.svg',      label: 'غذای ایرانی' },
        { file: 'salad.svg',             label: 'سالاد' }
    ];
    const PRESET_BASE_PATH = '/images/categories/presets/';

    (function () {
        const grid         = document.getElementById('visualPickerGrid');
        const hiddenUrl     = document.getElementById('selectedImageUrl');
        const liveIcon      = document.getElementById('liveCatIcon');
        const fileInput     = document.getElementById('catImageInput');
        const removeBtn     = document.getElementById('catImgRemoveBtn');
        const currentValue  = hiddenUrl.value;

        function isVector(src) { return /\.svg(\?.*)?$/i.test(src || ''); }

        function fullPath(file) { return PRESET_BASE_PATH + file; }

        function setPreview(src) {
            if (src) {
                liveIcon.innerHTML = '<img src="' + src + '" alt="" class="' + (isVector(src) ? 'is-vector' : '') + '">';
            } else {
                liveIcon.innerHTML = '<i class="bi bi-image"></i>';
            }
            removeBtn.classList.toggle('show', Boolean(src));
        }

        function highlightActive(activeFile) {
            grid.querySelectorAll('.visual-picker-item').forEach(item => {
                item.classList.toggle('active', item.dataset.file === activeFile);
            });
        }

        function renderGrid(list) {
            const items = list || CATEGORY_PRESETS;
            grid.innerHTML = '';
            if (items.length === 0) {
                grid.innerHTML = '<p class="text-center text-muted small py-3 mb-0" style="grid-column:1/-1;">وکتوری با این عنوان پیدا نشد.</p>';
                return;
            }
            items.forEach(preset => {
                const path = fullPath(preset.file);
                const isActive = currentValue === path;
                const item = document.createElement('div');
                item.className = 'visual-picker-item' + (isActive ? ' active' : '');
                item.dataset.file = path;
                item.title = preset.label;
                item.innerHTML = `<img src="${path}" alt="${preset.label}" loading="lazy">`;
                item.addEventListener('click', () => {
                    fileInput.value = '';
                    hiddenUrl.value = path;
                    highlightActive(path);
                    setPreview(path);
                });
                grid.appendChild(item);
            });
        }

        renderGrid();

        const searchInput = document.getElementById('visualPickerSearch');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                const q = this.value.trim();
                const filtered = q ? CATEGORY_PRESETS.filter(p => p.label.indexOf(q) !== -1) : CATEGORY_PRESETS;
                renderGrid(filtered);
            });
        }

        const dropZone = document.getElementById('catImgDrop');

        fileInput.addEventListener('change', function () {
            const file = this.files && this.files[0];
            if (!file) return;
            highlightActive(null);
            const reader = new FileReader();
            reader.onload = e => setPreview(e.target.result);
            reader.readAsDataURL(file);
        });

        removeBtn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            fileInput.value = '';
            hiddenUrl.value = '';
            highlightActive(null);
            setPreview(null);
        });

        ['dragenter', 'dragover'].forEach(evt => {
            dropZone.addEventListener(evt, e => { e.preventDefault(); dropZone.classList.add('dragover'); });
        });
        ['dragleave', 'drop'].forEach(evt => {
            dropZone.addEventListener(evt, e => { e.preventDefault(); dropZone.classList.remove('dragover'); });
        });
        dropZone.addEventListener('drop', function (e) {
            const file = e.dataTransfer.files && e.dataTransfer.files[0];
            if (!file) return;
            fileInput.files = e.dataTransfer.files;
            fileInput.dispatchEvent(new Event('change'));
        });
    })();

    (function () {
        const form = document.getElementById('editCategoryForm');
        const btn  = document.getElementById('saveCategoryBtn');
        if (!form || !btn) return;
        form.addEventListener('submit', function () {
            if (!form.checkValidity()) return;
            try { localStorage.setItem('babol-admin-active-tab', 'categoryManage'); } catch (e) {}
            btn.classList.add('is-loading');
            btn.setAttribute('disabled', 'disabled');
        });
    })();
</script>
</body>
</html>
