html[data-bs-theme=dark]{--hw-bg0:#0D0912;--hw-bg1:#1B1026;--hw-surface:rgba(30,18,42,.84);--hw-surface-2:#241533;--hw-text:#F6EBDD;--hw-muted:#BDAACF;--hw-line:rgba(255,117,24,.30)}
html[data-bs-theme=light]{--hw-bg0:#1E1230;--hw-bg1:#3A2356;--hw-surface:rgba(54,34,80,.84);--hw-surface-2:#3A2356;--hw-text:#FFF3E4;--hw-muted:#D3C0E8;--hw-line:rgba(255,160,60,.36)}
html[data-bs-theme]{--bs-body-bg:var(--hw-bg0);--bs-body-color:var(--hw-text);--bs-emphasis-color:var(--hw-text);--bs-secondary-color:var(--hw-muted);--bs-border-color:var(--hw-line);--bs-tertiary-bg:var(--hw-surface);--bs-secondary-bg:var(--hw-surface);--bs-offcanvas-bg:var(--hw-surface-2);--bs-offcanvas-color:var(--hw-text);--bs-link-color:#FFB347;--bs-link-color-rgb:255,179,71;background-color:var(--hw-bg0)!important;color-scheme:dark}
html[data-bs-theme] body{background:transparent!important;color:var(--hw-text)!important}
html[data-bs-theme] ::selection{background:rgba(255,117,24,.5);color:#fff}
html[data-bs-theme] .menu-main,html[data-bs-theme] .cat-panel{background:transparent!important}

.hw-fx{position:fixed;top:0;left:0;right:0;bottom:0;z-index:-1;overflow:hidden;pointer-events:none;contain:strict}
.hw-glow{position:absolute;top:0;left:0;right:0;bottom:0;background:radial-gradient(ellipse 80% 45% at 50% -8%,rgba(255,117,24,.22),transparent 70%),radial-gradient(ellipse 70% 50% at 105% 105%,rgba(107,63,160,.42),transparent 70%),radial-gradient(ellipse 60% 40% at -10% 70%,rgba(90,30,120,.30),transparent 70%),linear-gradient(180deg,var(--hw-bg1),var(--hw-bg0))}
.hw-moon{position:absolute;top:11%;right:10%;width:84px;height:84px;border-radius:50%;background:radial-gradient(circle at 38% 36%,#FFF7D6,#F3D98A 55%,#C9A24A 100%);opacity:.2;box-shadow:0 0 60px 18px rgba(255,220,130,.28)}
.hw-web{position:absolute;top:0;width:150px;height:150px;width:min(46vw,190px);height:min(46vw,190px);background-repeat:no-repeat;background-size:100% 100%}
.hw-web-l{left:0;background-image:var(--hw-web-tl)}
.hw-web-r{right:0;background-image:var(--hw-web-tr)}
.hw-fog{position:absolute;left:-50%;width:200%;height:38%;background:radial-gradient(ellipse 30% 50% at 20% 50%,rgba(190,170,220,.11),transparent 100%),radial-gradient(ellipse 28% 45% at 62% 55%,rgba(190,170,220,.08),transparent 100%),radial-gradient(ellipse 22% 40% at 90% 45%,rgba(255,170,90,.06),transparent 100%);will-change:transform}
.hw-fog-a{bottom:0;animation:hw-drift 46s linear infinite alternate}
.hw-fog-b{bottom:12%;opacity:.7;animation:hw-drift 64s linear infinite alternate-reverse}
.hw-bat{position:absolute;top:0;left:0;width:46px;height:23px;color:#4A2F66;opacity:.85;will-change:transform}
.hw-bat svg{display:block;width:100%;height:100%;fill:currentColor;transform-origin:50% 60%;animation:hw-flap .34s ease-in-out infinite alternate}
.hw-bat-1{animation:hw-fly-a 28s linear infinite;animation-delay:-6s}
.hw-bat-2{width:34px;height:17px;animation:hw-fly-b 36s linear infinite;animation-delay:-19s}
.hw-bat-3{width:26px;height:13px;opacity:.7;animation:hw-fly-a 44s linear infinite;animation-delay:-31s}
@keyframes hw-drift{from{transform:translate3d(-8%,0,0)}to{transform:translate3d(8%,0,0)}}
@keyframes hw-flap{from{transform:scaleY(1)}to{transform:scaleY(.55)}}
@keyframes hw-fly-a{0%{transform:translate3d(-14vw,18vh,0)}25%{transform:translate3d(24vw,9vh,0)}50%{transform:translate3d(54vw,26vh,0)}75%{transform:translate3d(84vw,10vh,0)}100%{transform:translate3d(116vw,22vh,0)}}
@keyframes hw-fly-b{0%{transform:translate3d(116vw,34vh,0) scaleX(-1)}30%{transform:translate3d(78vw,46vh,0) scaleX(-1)}60%{transform:translate3d(40vw,30vh,0) scaleX(-1)}100%{transform:translate3d(-14vw,42vh,0) scaleX(-1)}}
@keyframes hw-flicker{0%,100%{opacity:1}8%{opacity:.82}14%{opacity:1}42%{opacity:.9}47%{opacity:1}73%{opacity:.78}78%{opacity:1}}
@keyframes hw-candle{0%,100%{opacity:.55}20%{opacity:.7}35%{opacity:.5}55%{opacity:.75}75%{opacity:.58}}
@keyframes hw-hop{0%{transform:translate3d(0,0,0) scale(1,1)}22%{transform:translate3d(0,2px,0) scale(1.05,.93)}48%{transform:translate3d(0,-11px,0) scale(.97,1.05)}72%{transform:translate3d(0,0,0) scale(1.04,.95)}100%{transform:translate3d(0,0,0) scale(1,1)}}

html[data-bs-theme] .preloader{background:#0D0912!important}
