  <script>
    (function () {
      var d = document.documentElement;
      try {
        var t = localStorage.getItem('nanonan-theme');
        if (t !== 'dark' && t !== 'light') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        d.setAttribute('data-bs-theme', t);
        var v = localStorage.getItem('nanonan-view');
        if (v === 'list' || v === 'grid') d.setAttribute('data-view', v);
        var m = document.querySelector('meta[name="theme-color"]');
        if (m) m.setAttribute('content', t === 'dark' ? '#0D0912' : '#241638');
      } catch (e) {}
    })();
  </script>

