html[data-bs-theme] .brand-mini-tagline{color:var(--hw-muted)!important}
html[data-bs-theme] .theme-btn{background:rgba(107,63,160,.38)!important;color:var(--hw-amber)!important;border:1px solid var(--hw-line)!important;box-shadow:0 0 16px rgba(255,117,24,.28)!important}

html[data-bs-theme] .cat-nav-wrapper{background:linear-gradient(180deg,rgba(13,9,18,.84),rgba(13,9,18,.58))!important;border-bottom:1px solid rgba(255,117,24,.16)!important}
html[data-bs-theme] .cat-nav{padding-top:16px!important;padding-bottom:12px!important}
html[data-bs-theme] .cat-card{position:relative;overflow:visible!important;min-width:80px;border:0!important;border-radius:48% 48% 44% 44%/54% 54% 46% 46%!important;background:radial-gradient(ellipse 13% 100% at 50% 52%,rgba(255,216,128,.42),transparent 100%),radial-gradient(ellipse 22% 94% at 25% 52%,rgba(130,34,0,.5),transparent 100%),radial-gradient(ellipse 22% 94% at 75% 52%,rgba(130,34,0,.5),transparent 100%),radial-gradient(ellipse 12% 88% at 7% 52%,rgba(96,22,0,.55),transparent 100%),radial-gradient(ellipse 12% 88% at 93% 52%,rgba(96,22,0,.55),transparent 100%),radial-gradient(circle at 50% 36%,#FFA23A 0%,#FF7518 48%,#C4480A 100%)!important;box-shadow:inset 0 9px 14px rgba(255,224,150,.28),inset 0 -12px 18px rgba(110,28,0,.45),0 6px 14px rgba(0,0,0,.45)!important;color:#2B1100!important;-webkit-backdrop-filter:none!important;backdrop-filter:none!important}
html[data-bs-theme] .cat-card.active,html[data-bs-theme] .cat-card[aria-pressed=true]{box-shadow:inset 0 9px 14px rgba(255,230,160,.4),inset 0 -12px 18px rgba(110,28,0,.4),0 0 24px 5px rgba(255,150,40,.6),0 6px 16px rgba(0,0,0,.45)!important}
html[data-bs-theme] .cat-card-thumb{position:relative;z-index:1;border-radius:50%!important;background:radial-gradient(circle at 50% 40%,rgba(255,244,200,.85),rgba(255,190,80,.4))!important;box-shadow:inset 0 0 10px rgba(255,117,24,.65),0 0 12px rgba(255,214,120,.5)!important;-webkit-backdrop-filter:none!important;backdrop-filter:none!important}
html[data-bs-theme] .cat-card-label{position:relative;z-index:1;color:#2B1100!important;font-weight:700;text-shadow:0 1px 0 rgba(255,214,150,.5)}
html[data-bs-theme] .cat-card .pk-stem{position:absolute;top:-10px;left:50%;width:14px;height:15px;margin-left:-7px;z-index:0;border-radius:3px 3px 6px 6px/2px 2px 9px 9px;background:linear-gradient(90deg,#2F5D1B,#78B845 45%,#2F5D1B);transform:rotate(-8deg);pointer-events:none}
html[data-bs-theme] .cat-card .pk-stem::after{content:"";position:absolute;top:1px;left:-13px;width:15px;height:15px;border:2px solid var(--hw-green);border-color:var(--hw-green) transparent transparent transparent;border-radius:50%;transform:rotate(-35deg)}
html[data-bs-theme] .cat-card .pk-glow{position:absolute;top:10%;left:10%;right:10%;bottom:10%;z-index:0;border-radius:50%;background:radial-gradient(circle at 50% 45%,rgba(255,244,180,.95),rgba(255,176,48,.5) 45%,transparent 72%);opacity:0;pointer-events:none;will-change:opacity}
html[data-bs-theme] .cat-card.active .pk-glow,html[data-bs-theme] .cat-card[aria-pressed=true] .pk-glow{animation:hw-candle 2.6s ease-in-out infinite}
@media (hover:hover){
  html[data-bs-theme] .cat-card:hover{animation:hw-hop .6s cubic-bezier(.3,.8,.4,1)}
  html[data-bs-theme] .cat-card:hover .pk-glow{opacity:.8;animation:hw-candle 1.6s ease-in-out infinite}
}

