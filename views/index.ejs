<!DOCTYPE html>
<html lang="fa" dir="rtl" data-bs-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Trattoria Bella — منوی رستوران</title>

  <!-- جلوگیری از فلاش تم اشتباه قبل از رندر اول صفحه -->
  <script>
    (function () {
      try {
        var t = localStorage.getItem('trattoria-theme');
        if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-bs-theme', t);
      } catch (e) {}
    })();
  </script>

  <!-- Bootstrap 5 RTL -->
  <link href="css/bootstrap.rtl.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="css/icons-1.13.1/font/bootstrap-icons.min.css">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="css/style.css">
</head>
<body>

  <!-- ─── PRELOADER (خوش‌آمدگویی اول ورود) ─────── -->
  <div class="preloader" id="preloader">
    <div class="preloader-inner">
      <div class="hero-flag">
        <div class="flag-stripe green"></div>
        <div class="flag-stripe white"></div>
        <div class="flag-stripe red"></div>
      </div>
      <div class="preloader-ring">
        <i class="bi bi-brightness-alt-high"></i>
      </div>
      <div class="preloader-brand">Trattoria <span>Bella</span></div>
      <p class="preloader-tagline">خوش آمدید، در حال آماده‌سازی منو...</p>
      <div class="preloader-dots"><span></span><span></span><span></span></div>
    </div>
  </div>

  <%
    // هش ساده‌ی نام/آیکون دسته‌بندی برای انتخاب رنگ ثابت از پالت
    // icon-swatch-0..9 — دقیقا همان منطق پنل ادمین، تا رنگ هر
    // دسته‌بندی همیشه با پنل ادمین یکی باشد.
    function swatchIndex(str){
      if(!str) return 0;
      var h = 0;
      for (var i=0;i<str.length;i++){ h = (h + str.charCodeAt(i)) % 10; }
      return h;
    }
  %>

  <!-- ─── HERO ─────────────────────────────────── -->
  <section class="hero">
    <div class="hero-toolbar">
      <button class="theme-btn" id="themeBtn" aria-label="تغییر تم">
        <i class="bi bi-moon-stars-fill" id="themeIcon"></i>
      </button>
    </div>
    <div class="hero-inner">
      <div class="hero-flag">
        <div class="flag-stripe green"></div>
        <div class="flag-stripe white"></div>
        <div class="flag-stripe red"></div>
      </div>
      <div class="hero-logo-ring">
        <i class="bi bi-brightness-alt-high"></i>
      </div>
      <h1 class="hero-name">Trattoria <span>Bella</span></h1>
      <div class="hero-divider"></div>
      <p class="hero-tagline">Autentica cucina italiana — طعم اصیل ایتالیا</p>
    </div>
  </section>

<!-- ─── CATEGORY NAV (STICKY) ───────────────── -->
<div class="cat-nav-sentinel" id="catNavSentinel"></div>
<div class="cat-nav-wrapper" id="catNav">
  <nav class="cat-nav" aria-label="دسته‌بندی منو">

    <% categoriesWithItems.forEach(function(cat, index) { %>
      <a class="cat-pill <%= index === 0 ? 'active' : '' %>" 
         data-target="cat-<%= cat.enname %>">
          <span class="pill-thumb icon-swatch-<%= swatchIndex(cat.icon || cat.name) %>">
            <i class="bi <%= cat.icon || 'bi-grid' %>"></i>
          </span>
        <%= cat.name %>
      </a>
    <% }) %>

  </nav>
</div>

  <!-- ─── MENU MAIN ─────────────────────────────── -->
<main class="menu-main container">

  <% categoriesWithItems.forEach(function(cat, index) { %>
    <section class="cat-section" id="cat-<%= cat.enname %>">
      
      <div class="cat-section-header">
        <div class="cat-thumb icon-swatch-<%= swatchIndex(cat.icon || cat.name) %>">
          <i class="bi <%= cat.icon || 'bi-grid' %>"></i>
        </div>
        <div class="cat-section-texts">
          <h2 class="cat-section-title"><%= cat.enname %></h2>
          <p class="cat-section-sub"><%= cat.name %></p>
        </div>
        <div class="cat-section-line"></div>
      </div>

      <div class="menu-grid">
        <% if (cat.items.length === 0) { %>
          <p class="text-muted">محصولی در این دسته‌بندی وجود ندارد.</p>
        <% } %>

        <% cat.items.forEach(function(item) { %>
          <div class="menu-card reveal"
               role="button"
               tabindex="0"
               data-name="<%= item.iteamName %>"
               data-price="<%= item.iteamPrice %>"
               data-desc="<%= item.description %>"
               data-img="<%= item.imageUrl || '' %>"
               data-cat="<%= cat.name %>"
               data-cat-icon="<%= cat.icon || 'bi-grid' %>"
               data-swatch="<%= swatchIndex(cat.icon || cat.name) %>">
            <div class="menu-card-img">
              <% if (item.imageUrl) { %>
                <img src="<%= item.imageUrl %>" 
                     alt="<%= item.iteamName %>" 
                     style="width:100%;height:100%;object-fit:cover;">
              <% } else { %>
                <div class="menu-card-placeholder">
                  <i class="bi bi-image"></i>
                </div>
              <% } %>
            </div>
            <div class="menu-card-info">
              <p class="menu-card-name"><%= item.iteamName %></p>
              <p class="menu-card-desc"><%= item.description %></p>
              <div class="menu-card-footer">
                <div class="menu-card-price">
                  <%= Number(item.iteamPrice).toLocaleString('fa-IR') %> 
                  <small>تومان</small>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>

    </section>
  <% }) %>

</main>

  <!-- ─── FOOTER ─────────────────────────────── -->
 <footer class="menu-footer">
  <div class="footer-brand">Trattoria Bella</div>
  <p class="footer-text">Via Roma 12, Milano · رزرو: 021-123-4567</p>

  <div class="footer-socials">
    <a href="#" class="social-dot" aria-label="اینستاگرام"><i class="bi bi-instagram"></i></a>
    <a href="#" class="social-dot" aria-label="تلگرام"><i class="bi bi-telegram"></i></a>
    <a href="#" class="social-dot" aria-label="واتس‌اپ"><i class="bi bi-whatsapp"></i></a>
    <a href="#" class="social-dot" aria-label="تلفن"><i class="bi bi-telephone-fill"></i></a>
  </div>

  <p class="footer-text mt-3" style="font-size:0.72rem;opacity:0.45;">
    © 2026 حس خاص — رستوران ایتالیایی
  </p>

  <p class="footer-text" style="font-size:0.72rem;opacity:0.45;">
    طراحی و توسعه توسط 
    <a href="http://SoulWeb.ir" target="_blank" rel="noopener noreferrer" class="text-link">سُل وب</a>
  </p>
</footer>

  <!-- ─── PRODUCT DETAIL SHEET (پاپ‌آپ از پایین) ── -->
  <div class="sheet-backdrop" id="sheetBackdrop"></div>
  <div class="product-sheet" id="productSheet" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="sheetItemName">
    <div class="sheet-drag-handle" id="sheetDragHandle"><span></span></div>
    <button type="button" class="sheet-close-btn" id="sheetCloseBtn" aria-label="بستن">
      <i class="bi bi-x-lg"></i>
    </button>
    <div class="sheet-scroll" id="sheetScroll">
      <div class="sheet-media">
        <div class="sheet-media-placeholder" id="sheetMediaPlaceholder">
          <i class="bi bi-image"></i>
        </div>
        <img id="sheetImg" alt="" style="display:none;">
        <span class="sheet-cat-badge icon-swatch-0" id="sheetCatBadge">
          <i class="bi bi-grid" id="sheetCatIcon"></i>
          <span id="sheetCatName"></span>
        </span>
      </div>
      <div class="sheet-body">
        <h2 class="sheet-item-name" id="sheetItemName"></h2>
        <div class="sheet-price-row">
          <span class="sheet-price" id="sheetPrice"></span>
          <span class="sheet-price-unit">تومان</span>
        </div>
        <p class="sheet-desc" id="sheetDesc"></p>
      </div>
    </div>
  </div>

  <!-- Bootstrap JS -->
 <script src="js/jquery-3.7.1.min.js"></script>
<script src="js/bootstrap.bundle.min.js"></script>

<script>
(function () {
  'use strict';

  const html = document.documentElement;

  /* ═══════════════════════════════════════════
     SCROLL LOCK (پری‌لودر و پاپ‌آپ محصول از اون استفاده می‌کنن)
  ═══════════════════════════════════════════ */
  var lockCount = 0;
  function lockScroll() {
    lockCount++;
    html.classList.add('scroll-locked');
  }
  function unlockScroll() {
    lockCount = Math.max(0, lockCount - 1);
    if (lockCount === 0) html.classList.remove('scroll-locked');
  }

  /* ═══════════════════════════════════════════
     PRELOADER — خوش‌آمدگویی اول ورود
  ═══════════════════════════════════════════ */
  var preloader = document.getElementById('preloader');
  if (preloader) {
    lockScroll();
    var MIN_VISIBLE_MS  = 700;   // حداقل زمان نمایش، حتی روی اینترنت پرسرعت
    var HARD_TIMEOUT_MS = 4500;  // سقف ایمنی، اگه عکسی هیچ‌وقت لود نشه
    var startedAt = Date.now();
    var preloaderHidden = false;

    function hidePreloader() {
      if (preloaderHidden) return;
      preloaderHidden = true;
      preloader.classList.add('is-hidden');
      unlockScroll();
      setTimeout(function () {
        if (preloader.parentNode) preloader.parentNode.removeChild(preloader);
      }, 650);
    }

    function readyToHide() {
      var remaining = MIN_VISIBLE_MS - (Date.now() - startedAt);
      if (remaining > 0) setTimeout(hidePreloader, remaining);
      else hidePreloader();
    }

    if (document.readyState === 'complete') {
      readyToHide();
    } else {
      window.addEventListener('load', readyToHide);
    }
    setTimeout(hidePreloader, HARD_TIMEOUT_MS);
  }

  /* ═══════════════════════════════════════════
     THEME TOGGLE
     (data-bs-theme از قبل توسط اسکریپت <head> ست شده تا فلاش
     نداشته باشیم؛ اینجا فقط آیکون رو سینک می‌کنیم و کلیک رو هندل می‌کنیم)
  ═══════════════════════════════════════════ */
  const themeBtn  = document.getElementById('themeBtn');
  const themeIcon = document.getElementById('themeIcon');

  function syncThemeIcon(mode) {
    themeIcon.className = mode === 'dark' ? 'bi bi-sun-fill' : 'bi bi-moon-stars-fill';
    themeIcon.style.color = mode === 'dark' ? '#D4A843' : '';
  }
  syncThemeIcon(html.getAttribute('data-bs-theme'));

  themeBtn.addEventListener('click', function () {
    var next = html.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
    html.setAttribute('data-bs-theme', next);
    try { localStorage.setItem('trattoria-theme', next); } catch (e) {}
    syncThemeIcon(next);
    themeBtn.classList.remove('spinning');
    void themeBtn.offsetWidth; // ریست انیمیشن
    themeBtn.classList.add('spinning');
  });

  /* ═══════════════════════════════════════════
     NAV / SCROLL CORE
  ═══════════════════════════════════════════ */
  const navWrap     = document.getElementById('catNav');        // ولپر استیکی
  const navInner    = navWrap.querySelector('.cat-nav');         // نوار قابل اسکرول افقی
  const navSentinel = document.getElementById('catNavSentinel');
  const pills       = Array.prototype.slice.call(document.querySelectorAll('.cat-pill'));
  const sections    = Array.prototype.slice.call(document.querySelectorAll('.cat-section'));
  const TOP_GAP     = 24; // فاصلهٔ نفس‌کشی بین نوار استیکی و عنوان دسته‌بندی
  const STUCK_GAP   = 10; // باید با مقدار top در .cat-nav-wrapper.is-stuck (style.css) یکی باشه

  function navOffset() {
    var stuckExtra = navWrap.classList.contains('is-stuck') ? STUCK_GAP : 0;
    return stuckExtra + navWrap.offsetHeight + TOP_GAP;
  }

  function setScrollPadding() {
    html.style.scrollPaddingTop = navOffset() + 'px';
  }
  setScrollPadding();

  // تشخیص لحظه‌ی واقعی «چسبیدن» نوار دسته‌بندی، تا کلاس شناورشدنش
  // (فاصله از بالا/کنار + بردر-ردیوس) دقیقا همون موقع فعال شه
  if (navSentinel && 'IntersectionObserver' in window) {
    var stuckObs = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        navWrap.classList.toggle('is-stuck', !entry.isIntersecting);
        setScrollPadding();
      });
    }, { threshold: 0 });
    stuckObs.observe(navSentinel);
  }

  function markActivePill(id) {
    pills.forEach(function (p) {
      p.classList.toggle('active', p.getAttribute('data-target') === id);
    });
  }

  // فقط scrollLeft خود نوار دسته‌بندی رو تغییر می‌ده؛ به اسکرول
  // عمودی صفحه دست نمی‌زنه (پس نمی‌تونه با window.scrollTo تصادم کنه)
  function centerPill(id) {
    if (!navInner) return;
    var pill = pills.filter(function (p) {
      return p.getAttribute('data-target') === id;
    })[0];
    if (!pill) return;

    var pillRect = pill.getBoundingClientRect();
    var navRect  = navInner.getBoundingClientRect();
    var delta    = (pillRect.left + pillRect.width / 2) - (navRect.left + navRect.width / 2);

    if (Math.abs(delta) > 1) {
      navInner.scrollBy({ left: delta, behavior: 'smooth' });
    }
  }

  function setActive(id) {
    markActivePill(id);
    centerPill(id);
  }

  /* ═══════════════════════════════════════════
     CLICK روی دسته‌بندی → اسکرول به بخش مربوطه
  ═══════════════════════════════════════════ */
  var isProgrammaticScroll = false;
  var scrollEndTimer       = null;

  function scrollToSection(id) {
    var section = document.getElementById(id);
    if (!section) return;

    var targetTop = section.getBoundingClientRect().top + window.pageYOffset - navOffset();
    var maxTop    = document.documentElement.scrollHeight - window.innerHeight;
    targetTop     = Math.max(0, Math.min(targetTop, maxTop));

    markActivePill(id);
    centerPill(id);

    isProgrammaticScroll = true;
    window.scrollTo({ top: targetTop, behavior: 'smooth' });

    clearTimeout(scrollEndTimer);
    scrollEndTimer = setTimeout(function () {
      isProgrammaticScroll = false;
    }, 900);
  }

  pills.forEach(function (pill) {
    pill.addEventListener('click', function (e) {
      e.preventDefault();
      scrollToSection(pill.getAttribute('data-target'));
    });
  });

  /* ═══════════════════════════════════════════
     SCROLL SPY (کاملا هماهنگ با sticky nav)
  ═══════════════════════════════════════════ */
  var spyObserver;

  function buildSpyObserver() {
    var rootMargin = '-' + navOffset() + 'px 0px -55% 0px';

    var obs = new IntersectionObserver(function (entries) {
      if (isProgrammaticScroll) return; // در حین اسکرول کلیکی، اسپای رو نادیده بگیر
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          setActive(entry.target.id);
        }
      });
    }, { rootMargin: rootMargin, threshold: 0 });

    sections.forEach(function (s) { obs.observe(s); });
    return obs;
  }

  spyObserver = buildSpyObserver();

  var resizeTimer;
  window.addEventListener('resize', function () {
    setScrollPadding();
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function () {
      spyObserver.disconnect();
      spyObserver = buildSpyObserver();
    }, 250);
  });

  /* ═══════════════════════════════════════════
     REVEAL ANIMATION
  ═══════════════════════════════════════════ */
  var revealObs = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        revealObs.unobserve(entry.target);
      }
    });
  }, { threshold: 0.07 });

  document.querySelectorAll('.reveal').forEach(function (el) {
    revealObs.observe(el);
  });

  /* ═══════════════════════════════════════════
     PRODUCT BOTTOM SHEET
     روی هر محصول کلیک شه، یه پاپ‌آپ شبیه صفحه‌ی تکی محصول از
     پایین صفحه میاد بالا — دقیقا همین رفتار توی موبایل و دسکتاپ
  ═══════════════════════════════════════════ */
  var sheetBackdrop  = document.getElementById('sheetBackdrop');
  var sheet          = document.getElementById('productSheet');
  var sheetScrollEl  = document.getElementById('sheetScroll');
  var sheetCloseBtn  = document.getElementById('sheetCloseBtn');
  var sheetDragHandle= document.getElementById('sheetDragHandle');
  var sheetImg       = document.getElementById('sheetImg');
  var sheetMediaPh   = document.getElementById('sheetMediaPlaceholder');
  var sheetCatBadge  = document.getElementById('sheetCatBadge');
  var sheetCatIcon   = document.getElementById('sheetCatIcon');
  var sheetCatName   = document.getElementById('sheetCatName');
  var sheetItemName  = document.getElementById('sheetItemName');
  var sheetPrice     = document.getElementById('sheetPrice');
  var sheetDesc      = document.getElementById('sheetDesc');
  var lastFocusedEl  = null;

  function openSheet(data) {
    sheetItemName.textContent = data.name || '';
    sheetPrice.textContent    = Number(data.price || 0).toLocaleString('fa-IR');
    sheetDesc.textContent     = (data.desc && data.desc.trim())
      ? data.desc
      : 'توضیحاتی برای این محصول ثبت نشده است.';
    sheetCatName.textContent  = data.cat || '';
    sheetCatIcon.className    = 'bi ' + (data.catIcon || 'bi-grid');
    sheetCatBadge.className   = 'sheet-cat-badge icon-swatch-' + (data.swatch || '0');

    if (data.img) {
      sheetImg.src = data.img;
      sheetImg.alt = data.name || '';
      sheetImg.style.display = 'block';
      sheetMediaPh.style.display = 'none';
    } else {
      sheetImg.removeAttribute('src');
      sheetImg.style.display = 'none';
      sheetMediaPh.style.display = 'flex';
    }

    if (sheetScrollEl) sheetScrollEl.scrollTop = 0;

    lastFocusedEl = document.activeElement;
    lockScroll();
    sheetBackdrop.classList.add('show');
    sheet.classList.add('show');
    sheet.setAttribute('aria-hidden', 'false');
    sheetCloseBtn.focus();
  }

  function closeSheet() {
    if (!sheet.classList.contains('show')) return;
    sheetBackdrop.classList.remove('show');
    sheet.classList.remove('show');
    sheet.setAttribute('aria-hidden', 'true');
    unlockScroll();
    if (lastFocusedEl && typeof lastFocusedEl.focus === 'function') {
      lastFocusedEl.focus();
    }
  }

  document.querySelectorAll('.menu-card').forEach(function (card) {
    card.addEventListener('click', function () { openSheet(card.dataset); });
    card.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openSheet(card.dataset);
      }
    });
  });

  sheetBackdrop.addEventListener('click', closeSheet);
  sheetCloseBtn.addEventListener('click', closeSheet);
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeSheet();
  });

  /* درگ-تو-دیسمیس (لمسی + ماوس) فقط از روی دستگیره‌ی بالای پاپ‌آپ،
     تا اسکرول طبیعی محتوای داخل پاپ‌آپ خراب نشه */
  var dragState = null;

  function onDragStart(e) {
    if (e.pointerType === 'mouse' && e.button !== 0) return;
    dragState = { startY: e.clientY, lastY: e.clientY, startedAt: Date.now() };
    sheet.classList.add('dragging');
    if (sheetDragHandle.setPointerCapture) {
      try { sheetDragHandle.setPointerCapture(e.pointerId); } catch (err) {}
    }
  }
  function onDragMove(e) {
    if (!dragState) return;
    dragState.lastY = e.clientY;
    var delta = Math.max(0, dragState.lastY - dragState.startY);
    sheet.style.transform = 'translate(-50%,' + delta + 'px)';
  }
  function onDragEnd() {
    if (!dragState) return;
    var delta    = dragState.lastY - dragState.startY;
    var elapsed  = Math.max(1, Date.now() - dragState.startedAt);
    var velocity = delta / elapsed; // پیکسل بر میلی‌ثانیه
    sheet.classList.remove('dragging');
    sheet.style.transform = '';
    dragState = null;
    if (delta > 110 || velocity > 0.6) closeSheet();
  }

  sheetDragHandle.addEventListener('pointerdown', onDragStart);
  sheetDragHandle.addEventListener('pointermove', onDragMove);
  sheetDragHandle.addEventListener('pointerup', onDragEnd);
  sheetDragHandle.addEventListener('pointercancel', onDragEnd);

}());
</script>
</body>
</html>
