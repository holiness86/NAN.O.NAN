html[data-bs-theme] .preloader-dots span{background:var(--hw-orange)!important;box-shadow:0 0 10px rgba(255,117,24,.9)}

html[data-bs-theme] .top-bar{background:linear-gradient(180deg,rgba(13,9,18,.88),rgba(13,9,18,.62))!important;border-bottom:1px solid var(--hw-line)!important;box-shadow:0 8px 28px rgba(0,0,0,.38)!important;-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}
html[data-bs-theme] .brand-mini-logo{background:radial-gradient(circle at 50% 40%,#FFF0D6,#FFC98A)!important;box-shadow:0 0 0 2px rgba(255,117,24,.6),0 0 20px rgba(255,117,24,.5)!important}
