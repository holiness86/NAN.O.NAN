<!DOCTYPE html>
<html lang="fa" dir="rtl" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>پنل مدیریت | کافه و بیکری نان و نان</title>

    <!-- جلوگیری از فلاش تم اشتباه قبل از رندر اول — دقیقاً هماهنگ با index.ejs
         (همان کلید localStorage، یعنی تم پنل ادمین و منوی عمومی یکی است) -->
    <script>
      (function () {
        try {
          var t = localStorage.getItem('nanonan-theme');
          if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-bs-theme', t);
        } catch (e) {}
      })();
    </script>

    <link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.0.0/Vazirmatn-font-face.css" rel="stylesheet" type="text/css" />
    <link href="/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/icons-1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">

    <style>
        /* =========================================================
           پنل مدیریت نان و نان (NAN.O.NAN) — توکن‌های طراحی
           این بلوک هیچ رنگ مستقلی تعریف نمی‌کند؛ فقط نام‌متغیرهای
           قدیمی پنل ادمین (--accent-color, --glass-bg, --text-main ...)
           را مستقیماً به توکن‌های اصلی style.css (--brand, --cream,
           --ink, --surface-glass, --sw-0..9 و ...) نگاشت (alias) می‌کند
           تا پالت رنگی و تم روشن/تاریک ۱۰۰٪ با صفحه اصلی یکسان باشد.
        ========================================================= */
        :root, [data-bs-theme="light"] {
            --bg-grad-1: var(--cream);
            --bg-grad-2: var(--cream-deep);
            --bg-grad-3: var(--surface-raised);
            --glass-bg: var(--surface-glass);
            --glass-border: var(--border-warm);
            --glass-shadow: rgba(var(--ink-rgb), .08);
            --glass-hover: var(--brand-soft);
            --text-main: var(--ink);
            --text-muted: var(--ink-muted);
            --input-bg: rgba(255, 255, 255, 0.6);
            --input-focus: rgba(255, 255, 255, 0.92);
            --btn-bg: var(--surface-raised);
            --btn-hover: var(--brand-soft);
            --accent-color: var(--brand);
            --accent-light: var(--brand-light);
            --accent-hover: var(--brand-dark);
            --danger-color: #C1443A;
            --danger-hover: #A83A31;
            --success-color: #3E8A5B;
            --option-bg: var(--surface);
            --sidebar-width: 280px;
            --topbar-height: 72px;
        }

        [data-bs-theme="dark"] {
            --bg-grad-1: var(--cream);
            --bg-grad-2: var(--cream-deep);
            --bg-grad-3: var(--surface-raised);
            --glass-bg: var(--surface-glass);
            --glass-border: var(--border-warm);
            --glass-shadow: rgba(0, 0, 0, 0.45);
            --glass-hover: var(--brand-soft);
            --text-main: var(--ink);
            --text-muted: var(--ink-muted);
            --input-bg: rgba(0, 0, 0, 0.28);
            --input-focus: rgba(0, 0, 0, 0.5);
            --btn-bg: rgba(255, 255, 255, 0.06);
            --btn-hover: var(--brand-soft);
            --accent-color: var(--brand);
            --accent-light: var(--brand-light);
            --accent-hover: var(--brand-dark);
            --danger-color: #E8716A;
            --danger-hover: #F08983;
            --success-color: #6FC090;
            --option-bg: var(--surface);
        }

        html { scroll-behavior: smooth; }

        * { font-family: 'Vazirmatn', Tahoma, Arial, sans-serif; }

        body {
            overflow-x: hidden;
            background: linear-gradient(-45deg, var(--bg-grad-1), var(--bg-grad-2), var(--bg-grad-3));
            background-size: 400% 400%;
            animation: gradientBG 18s ease infinite;
            color: var(--text-main);
            min-height: 100vh;
            transition: background-color 0.4s ease, color 0.4s ease;
        }

        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }


        .admin-layout { display: flex; min-height: 100vh; }

        .glass-panel {
            background: var(--glass-bg);
            backdrop-filter: blur(18px) saturate(160%);
            -webkit-backdrop-filter: blur(18px) saturate(160%);
            border: 1px solid var(--glass-border);
            box-shadow: 0 8px 32px var(--glass-shadow);
            transition: all 0.3s ease;
        }

        /* ---------- Sidebar ---------- */
        .sidebar {
            width: var(--sidebar-width);
            position: fixed;
            top: 0; right: 0;
            height: 100vh;
            overflow-y: auto;
            z-index: 1050;
            border-left: 1px solid var(--glass-border);
            background: var(--glass-bg);
            backdrop-filter: blur(20px) saturate(160%);
            -webkit-backdrop-filter: blur(20px) saturate(160%);
            box-shadow: 4px 0 32px var(--glass-shadow);
            transition: transform 0.3s ease;
            display: flex;
            flex-direction: column;
        }
        .sidebar::-webkit-scrollbar { width: 5px; }
        .sidebar::-webkit-scrollbar-thumb { background: var(--glass-border); border-radius: 5px; }

        .sidebar-brand {
            height: var(--topbar-height);
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0 1.5rem;
            border-bottom: 1px solid var(--glass-border);
            flex-shrink: 0;
        }
        .sidebar-brand .brand-mark {
            width: 42px; height: 42px;
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            background: linear-gradient(135deg, var(--accent-light), var(--accent-color));
            color: #fff;
            font-size: 1.25rem;
            box-shadow: 0 4px 14px rgba(184,134,11,0.35);
            flex-shrink: 0;
        }
        .sidebar-brand .brand-text { line-height: 1.25; min-width: 0; }
        .sidebar-brand .brand-text strong { display: block; font-size: 0.98rem; font-weight: 800; }
        .sidebar-brand .brand-text span { font-size: 0.7rem; color: var(--text-muted); }

        .sidebar-section-label {
            font-size: 0.68rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.06em;
            padding: 0.4rem 1.5rem;
            margin-top: 0.6rem;
            font-weight: 700;
        }

        .sidebar .nav-link {
            border-radius: 13px;
            margin: 0.18rem 1rem;
            padding: 0.7rem 1rem;
            color: var(--text-muted);
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 0.92rem;
            transition: all 0.25s ease;
            position: relative;
        }
        .sidebar .nav-link .nav-ico {
            width: 34px; height: 34px;
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            background: var(--glass-hover);
            font-size: 1rem;
            flex-shrink: 0;
            transition: all 0.25s ease;
        }
        .sidebar .nav-link .nav-badge {
            margin-right: auto;
            background: var(--glass-hover);
            color: var(--text-muted);
            font-size: 0.68rem;
            font-weight: 700;
            padding: 0.15rem 0.5rem;
            border-radius: 50rem;
        }
        .sidebar .nav-link:hover {
            background-color: var(--glass-hover);
            color: var(--text-main);
            transform: translateX(-4px);
        }
        .sidebar .nav-link.active {
            background: linear-gradient(135deg, var(--accent-light), var(--accent-color));
            color: #1A1208;
            font-weight: 700;
            box-shadow: 0 6px 18px rgba(184,134,11,0.30);
        }
        [data-bs-theme="dark"] .sidebar .nav-link.active { color: #1A1208; }
        .sidebar .nav-link.active .nav-ico { background: rgba(255,255,255,0.25); }
        .sidebar .nav-link.active .nav-badge { background: rgba(255,255,255,0.3); color: #1A1208; }

        .sidebar-footer {
            margin-top: auto;
            padding: 1rem 1.25rem 1.4rem;
            border-top: 1px solid var(--glass-border);
        }
        .sidebar-clock {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.65rem 0.9rem;
            border-radius: 13px;
            background: var(--glass-hover);
            border: 1px solid var(--glass-border);
            font-size: 0.78rem;
            color: var(--text-muted);
            margin-bottom: 0.6rem;
        }
        .sidebar-footer .logout-link {
            display: flex; align-items: center; justify-content: center; gap: 0.5rem;
            font-size: 0.82rem; font-weight: 700;
            color: var(--danger-color);
            text-decoration: none;
            padding: 0.55rem;
            border-radius: 12px;
            border: 1px solid var(--glass-border);
            transition: all 0.25s ease;
        }
        .sidebar-footer .logout-link:hover { background: rgba(214,69,59,0.12); }

        /* ---------- Main / Topbar ---------- */
        .main-content { flex: 1; margin-right: var(--sidebar-width); min-width: 0; transition: margin 0.3s ease; }
        .content-wrapper { padding: 1.5rem; padding-top: calc(var(--topbar-height) + 1.5rem); max-width: 1400px; }

        .topbar {
            height: var(--topbar-height);
            position: fixed;
            top: 0; right: var(--sidebar-width); left: 0;
            z-index: 1040;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 1.5rem;
            border-bottom: 1px solid var(--glass-border);
            background: var(--glass-bg);
            backdrop-filter: blur(20px) saturate(160%);
            -webkit-backdrop-filter: blur(20px) saturate(160%);
            box-shadow: 0 4px 24px var(--glass-shadow);
            transition: right 0.3s ease;
        }
        .topbar-title { font-weight: 800; font-size: 1.02rem; display: flex; align-items: center; gap: 0.6rem; }
        .topbar-title .topbar-sub { font-size: 0.72rem; color: var(--text-muted); font-weight: 500; display: block; }
        .sidebar-toggle-btn { display: none; }

        .sidebar-overlay {
            display: none;
            position: fixed; inset: 0;
            background: rgba(0,0,0,0.5);
            backdrop-filter: blur(5px);
            z-index: 1045;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        @media (max-width: 991.98px) {
            .sidebar { transform: translateX(100%); }
            .sidebar.show { transform: translateX(0); }
            .main-content { margin-right: 0; }
            .topbar { right: 0; padding: 0 1rem; }
            .sidebar-overlay.show { display: block; opacity: 1; }
            .sidebar-toggle-btn { display: flex; }
        }

        /* ---------- Cards / Inputs / Buttons ---------- */
        .glass-card {
            background: var(--glass-bg);
            backdrop-filter: blur(16px) saturate(160%);
            -webkit-backdrop-filter: blur(16px) saturate(160%);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            box-shadow: 0 8px 32px var(--glass-shadow);
            padding: 1.6rem;
            transition: transform 0.3s ease, background 0.4s ease;
        }
        .glass-card:hover { transform: translateY(-2px); }

        .glass-input, .glass-select, .glass-textarea {
            background: var(--input-bg) !important;
            border: 1px solid var(--glass-border) !important;
            color: var(--text-main) !important;
            border-radius: 13px !important;
            box-shadow: none !important;
        }
        .glass-input:focus, .glass-select:focus, .glass-textarea:focus {
            box-shadow: 0 0 0 3px rgba(184, 134, 11, 0.20) !important;
            border-color: var(--accent-color) !important;
            background: var(--input-focus) !important;
        }
        option { background-color: var(--option-bg); color: var(--text-main); }

        .table { color: var(--text-main); margin-bottom: 0; }
        .table th, .table td {
            background-color: transparent !important;
            border-bottom: 1px solid var(--glass-border) !important;
            vertical-align: middle;
            padding: 1.1rem 1rem;
            color: var(--text-main);
        }
        .table thead th {
            border-bottom: 2px solid var(--glass-border) !important;
            color: var(--text-muted);
            font-weight: 700;
            font-size: 0.82rem;
        }
        .table-hover tbody tr { transition: background-color 0.25s ease; }
        .table-hover tbody tr:hover { background-color: var(--glass-hover) !important; }

        .theme-butn {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            color: var(--accent-color);
            width: 44px; height: 44px;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            transition: all 0.3s ease;
            cursor: pointer;
            font-size: 1.05rem;
        }
        .theme-butn:hover { transform: rotate(18deg) scale(1.08); background: var(--btn-hover); }

        .btn-accent {
            background: linear-gradient(135deg, var(--accent-light), var(--accent-color));
            color: #1A1208 !important;
            border: none;
            border-radius: 14px;
            padding: 0.75rem 1.5rem;
            font-weight: 700;
            box-shadow: 0 4px 16px rgba(184, 134, 11, 0.28);
            transition: all 0.25s ease;
        }
        .btn-accent:hover { transform: translateY(-2px); box-shadow: 0 6px 22px rgba(184, 134, 11, 0.38); }
        .btn-accent:disabled { opacity: 0.6; transform: none; }

        .btn-glass {
            background: var(--btn-bg);
            border: 1px solid var(--glass-border);
            color: var(--text-main);
            border-radius: 14px;
            padding: 0.7rem 1.4rem;
            font-weight: 600;
            transition: all 0.25s ease;
        }
        .btn-glass:hover { background: var(--btn-hover); color: var(--text-main); }

        .text-accent { color: var(--accent-color) !important; }
        .text-muted-custom { color: var(--text-muted) !important; opacity: 0.9; }
        .border-glass { border-color: var(--glass-border) !important; }

        .content-section { display: none; }
        .content-section.active-section { display: block; animation: fadeIn 0.4s ease-in-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        .password-toggle {
            position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
            cursor: pointer; color: var(--text-muted); background: none; border: none; padding: 0; z-index: 5;
        }
        .input-password-wrap { position: relative; }
        .input-password-wrap .glass-input { padding-left: 44px; }

        input::placeholder, textarea::placeholder { color: var(--text-muted) !important; opacity: 0.8; }

        /* ---------- Stat Cards ---------- */
        .stat-card {
            background: var(--glass-bg);
            backdrop-filter: blur(16px) saturate(160%);
            border: 1px solid var(--glass-border);
            border-radius: 18px;
            box-shadow: 0 8px 28px var(--glass-shadow);
            padding: 1.3rem 1.4rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            height: 100%;
            transition: transform 0.3s ease;
            position: relative;
            overflow: hidden;
        }
        .stat-card:hover { transform: translateY(-4px); }
        .stat-card .stat-icon {
            width: 54px; height: 54px;
            border-radius: 16px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.4rem;
            color: #fff;
            flex-shrink: 0;
            box-shadow: 0 4px 14px rgba(0,0,0,0.18);
        }
        .stat-card h3 { font-size: 1.5rem; letter-spacing: -0.02em; }
        .stat-trend { font-size: 0.68rem; font-weight: 700; padding: 0.15rem 0.5rem; border-radius: 50rem; }

        /* ---------- Category breakdown ---------- */
        .cat-bar-row { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.85rem; }
        .cat-bar-dot { width: 34px; height: 34px; border-radius: 10px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 0.95rem; box-shadow: 0 2px 8px rgba(0,0,0,0.15); }
        .cat-bar-track { flex: 1; height: 8px; border-radius: 50rem; background: var(--glass-hover); overflow: hidden; margin-top: 4px; }
        .cat-bar-fill { height: 100%; border-radius: 50rem; transition: width 0.6s ease; }

        /* ---------- Icon swatches (shared with picker) ---------- */
        .icon-swatch-0 { background: var(--sw-0); } .icon-swatch-1 { background: var(--sw-1); }
        .icon-swatch-2 { background: var(--sw-2); } .icon-swatch-3 { background: var(--sw-3); }
        .icon-swatch-4 { background: var(--sw-4); } .icon-swatch-5 { background: var(--sw-5); }
        .icon-swatch-6 { background: var(--sw-6); } .icon-swatch-7 { background: var(--sw-7); }
        .icon-swatch-8 { background: var(--sw-8); } .icon-swatch-9 { background: var(--sw-9); }

        /* ---------- Visual (Vector/Image) Picker ---------- */
        .icon-picker-preview {
            display: flex; align-items: center; gap: 1rem;
            padding: 0.9rem 1rem; border-radius: 16px;
            background: var(--glass-hover); border: 1px solid var(--glass-border);
            margin-bottom: 0.9rem;
        }
        .icon-picker-preview .ipv-box {
            width: 54px; height: 54px; border-radius: 15px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.55rem; color: var(--accent-color);
            background: var(--glass-bg); border: 1px solid var(--glass-border);
            box-shadow: 0 4px 14px rgba(0,0,0,0.12);
            flex-shrink: 0; overflow: hidden; padding: 8px;
        }
        .icon-picker-preview .ipv-box img { width: 100%; height: 100%; object-fit: contain; }

        .visual-picker-grid {
            display: grid; grid-template-columns: repeat(5, 1fr);
            gap: 10px; max-height: 260px; overflow-y: auto;
            padding: 10px; border-radius: 16px;
            background: var(--input-bg); border: 1px solid var(--glass-border);
        }
        .visual-picker-grid::-webkit-scrollbar { width: 5px; }
        .visual-picker-grid::-webkit-scrollbar-thumb { background: var(--glass-border); border-radius: 5px; }
        .visual-picker-item {
            aspect-ratio: 1/1; border-radius: 14px; cursor: pointer;
            background: var(--glass-bg); border: 2px solid var(--glass-border);
            display: flex; align-items: center; justify-content: center;
            padding: 8px; position: relative; transition: transform .2s ease, border-color .2s ease;
        }
        .visual-picker-item img { width: 100%; height: 100%; object-fit: contain; }
        .visual-picker-item:hover { transform: translateY(-3px) scale(1.06); box-shadow: 0 6px 16px rgba(0,0,0,0.18); border-color: var(--accent-light); }
        .visual-picker-item.active { border-color: var(--accent-color); background: var(--brand-soft); }
        .visual-picker-item.active::after {
            content: '\F26E'; font-family: 'bootstrap-icons'; position: absolute; bottom: -4px; left: -4px;
            background: var(--success-color); color: #fff; width: 16px; height: 16px; border-radius: 50%;
            font-size: 0.55rem; display: flex; align-items: center; justify-content: center;
            box-shadow: 0 1px 4px rgba(0,0,0,0.3);
        }

        .cat-img-upload {
            display: flex; align-items: center; gap: 1rem;
            padding: .9rem; border-radius: 16px;
            background: var(--input-bg); border: 1px dashed var(--glass-border);
            transition: all .25s ease; cursor: pointer;
        }
        .cat-img-upload:hover, .cat-img-upload.dragover {
            border-color: var(--accent-color); background: var(--brand-soft);
        }
        .cat-img-upload-icon {
            width: 44px; height: 44px; border-radius: 12px; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
            background: var(--glass-bg); border: 1px solid var(--glass-border);
            font-size: 1.2rem; color: var(--accent-color);
        }
        .cat-img-upload .txt strong { display: block; font-size: .85rem; }
        .cat-img-upload .txt span { font-size: .74rem; color: var(--text-muted); }
        .cat-img-remove {
            border: none; background: rgba(214,69,59,0.12); color: #D6453B;
            border-radius: 10px; width: 32px; height: 32px; flex-shrink: 0;
            display: none; align-items: center; justify-content: center;
        }
        .cat-img-remove.show { display: flex; }

        /* ---------- Category badge in table ---------- */
        .cat-icon-badge {
            width: 34px; height: 34px; border-radius: 10px;
            display: inline-flex; align-items: center; justify-content: center;
            color: #fff; font-size: 1rem; box-shadow: 0 2px 8px rgba(0,0,0,0.15);
            overflow: hidden; padding: 5px;
        }
        .cat-icon-badge img { width: 100%; height: 100%; object-fit: contain; }
        .product-cat-pill {
            display: inline-flex; align-items: center; gap: 0.4rem;
            background: var(--glass-hover); border: 1px solid var(--glass-border);
            border-radius: 50rem; padding: 0.3rem 0.7rem 0.3rem 0.9rem; font-size: 0.78rem; font-weight: 600;
        }
        .product-cat-pill .dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }

        .img-thumb-ph {
            width: 55px; height: 55px; border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            background: var(--glass-hover); border: 1px solid var(--glass-border);
            color: var(--text-muted); font-size: 1.3rem;
        }

        .upload-drop {
            border: 1.5px dashed var(--glass-border);
            border-radius: 16px;
            background: var(--input-bg);
            padding: 1.4rem;
            text-align: center;
            cursor: pointer;
            transition: all 0.25s ease;
        }
        .upload-drop:hover, .upload-drop.dragover { border-color: var(--accent-color); background: var(--glass-hover); }
        .upload-drop i { font-size: 1.8rem; color: var(--accent-color); }

        .char-counter { font-size: 0.7rem; color: var(--text-muted); text-align: left; margin-top: 0.3rem; }

        .empty-state { text-align: center; padding: 3rem 1rem; color: var(--text-muted); }
        .empty-state i { font-size: 2.6rem; color: var(--accent-color); opacity: 0.6; margin-bottom: 0.75rem; display: block; }

        .badge-soft-success { background: rgba(46,138,80,0.15); color: var(--success-color); }
        .badge-soft-danger { background: rgba(214,69,59,0.15); color: var(--danger-color); }

        @media (max-width: 575.98px) {
            .content-wrapper { padding: 1rem; padding-top: calc(var(--topbar-height) + 1rem); }
            .glass-card { padding: 1.1rem; border-radius: 16px; }
        }
    </style>
</head>
<body>

<div class="admin-layout">

    <!-- ═══════════════ SIDEBAR ═══════════════ -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <div class="brand-mark"><img width="100%" height="100%" src="/images/logo/Nan.O.Nan-white.png" style="width: 100%; height: 100%; object-fit: contain;" alt="نان و نان"></div>
            <div class="brand-text">
                <strong>نان و نان</strong>
                <span>NAN.O.NAN | پنل مدیریت</span>
            </div>
        </div>

        <nav class="py-2" id="sidebarNav">
            <div class="sidebar-section-label">نمای کلی</div>
            <a class="nav-link active" href="#dashboard" onclick="setActiveTab('dashboard'); closeSidebarOnMobile();">
                <span class="nav-ico"><i class="bi bi-speedometer2"></i></span> داشبورد
            </a>

            <div class="sidebar-section-label">مدیریت منو</div>
            <a class="nav-link" href="#addProduct" onclick="setActiveTab('addProduct'); closeSidebarOnMobile();">
                <span class="nav-ico"><i class="bi bi-plus-circle-fill"></i></span> افزودن محصول
            </a>
            <a class="nav-link" href="#productList" onclick="setActiveTab('productList'); closeSidebarOnMobile();">
                <span class="nav-ico"><i class="bi bi-list-stars"></i></span> لیست محصولات
                <span class="nav-badge"><%= typeof iteam !== 'undefined' ? iteam.length : 0 %></span>
            </a>
            <a class="nav-link" href="#categoryManage" onclick="setActiveTab('categoryManage'); closeSidebarOnMobile();">
                <span class="nav-ico"><i class="bi bi-grid-fill"></i></span> دسته‌بندی‌ها
                <span class="nav-badge"><%= typeof categories !== 'undefined' ? categories.length : 0 %></span>
            </a>

            <div class="sidebar-section-label">حساب کاربری</div>
            <a class="nav-link" href="#changeCredentials" onclick="setActiveTab('changeCredentials'); closeSidebarOnMobile();">
                <span class="nav-ico"><i class="bi bi-shield-lock-fill"></i></span> امنیت و رمز عبور
            </a>
            <a class="nav-link" href="/" target="_blank">
                <span class="nav-ico"><i class="bi bi-box-arrow-up-left"></i></span> مشاهده سایت
            </a>
        </nav>

        <div class="sidebar-footer">
            <div class="sidebar-clock">
                <span class="d-flex align-items-center gap-2"><i class="bi bi-clock-fill text-accent"></i> <span id="liveClock">--:--</span></span>
                <span id="liveDate">----</span>
            </div>
            <a href="/logout" class="logout-link">
                <i class="bi bi-box-arrow-right"></i> خروج از پنل
            </a>
        </div>
    </aside>

    <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

    <!-- ═══════════════ MAIN ═══════════════ -->
    <main class="main-content">

        <header class="topbar">
            <div class="d-flex align-items-center gap-3">
                <button class="theme-butn sidebar-toggle-btn" onclick="toggleSidebar()" aria-label="منو">
                    <i class="bi bi-list"></i>
                </button>
                <div class="topbar-title">
                   <img width="75px" height="75px" src="/images/logo/Nan.O.Nan-brand.png" style="width: 75px; height: 75px; object-fit: contain;" alt="نان و نان">
                    <div>
                        پنل مدیریت نان و نان
                        <span class="topbar-sub">خوش آمدید، امروز روز خوبی برای پختن نان تازه است ☕🥐</span>
                    </div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a href="/" target="_blank" class="btn-glass d-none d-md-inline-flex align-items-center gap-2 text-decoration-none" style="font-size:0.82rem;">
                    <i class="bi bi-eye-fill"></i> مشاهده منو
                </a>
                <button class="theme-butn" id="themeBtn" onclick="toggleTheme()" aria-label="تغییر تم">
                    <i class="bi bi-sun-fill" id="themeIcon"></i>
                </button>
            </div>
        </header>

        <div class="content-wrapper">

            <%
                // ---------- کمک‌تابع‌های محاسباتی (بدون نیاز به فیلد جدید در دیتابیس) ----------
                function swatchIndex(str){
                    if(!str) return 0;
                    var h = 0;
                    for (var i=0;i<str.length;i++){ h = (h + str.charCodeAt(i)) % 10; }
                    return h;
                }
                function fmtNum(n){
                    if(n === undefined || n === null || n === '') return '0';
                    return String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
                }
                var allProducts = typeof iteam !== 'undefined' ? iteam : [];
                var allCategories = typeof categories !== 'undefined' ? categories : [];
                var totalValue = 0, missingImg = 0;
                allProducts.forEach(function(p){
                    totalValue += Number(p.iteamPrice) || 0;
                    if (!p.imageUrl) missingImg++;
                });
                var avgPrice = allProducts.length ? Math.round(totalValue / allProducts.length) : 0;
                var catCounts = {};
                allProducts.forEach(function(p){ catCounts[p.category] = (catCounts[p.category] || 0) + 1; });
                function catByName(n){ return allCategories.find(function(c){ return c.name === n; }); }
            %>

            <!-- ══════════════ DASHBOARD ══════════════ -->
            <section id="dashboardSection" class="content-section active-section">
                <h5 class="fw-bold mb-4 d-flex align-items-center gap-2">
                    <i class="bi bi-pie-chart-fill text-accent"></i>
                    آمار و وضعیت کلی نان و نان
                </h5>

                <div class="row g-3 mb-4">
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="stat-card">
                            <div>
                                <span class="text-muted-custom d-block mb-1 fw-medium" style="font-size:0.78rem;">کل محصولات</span>
                                <h3 class="fw-bold mb-0"><%= allProducts.length %></h3>
                            </div>
                            <div class="stat-icon icon-swatch-0"><i class="bi bi-box-seam-fill"></i></div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="stat-card">
                            <div>
                                <span class="text-muted-custom d-block mb-1 fw-medium" style="font-size:0.78rem;">دسته‌بندی‌ها</span>
                                <h3 class="fw-bold mb-0"><%= allCategories.length %></h3>
                            </div>
                            <div class="stat-icon icon-swatch-5"><i class="bi bi-tags-fill"></i></div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="stat-card">
                            <div>
                                <span class="text-muted-custom d-block mb-1 fw-medium" style="font-size:0.78rem;">ارزش کل منو</span>
                                <h3 class="fw-bold mb-0" style="font-size:1.15rem;"><%= fmtNum(totalValue) %> <small class="fw-normal text-muted-custom" style="font-size:0.7rem;">تومان</small></h3>
                            </div>
                            <div class="stat-icon icon-swatch-3"><i class="bi bi-cash-coin"></i></div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="stat-card">
                            <div>
                                <span class="text-muted-custom d-block mb-1 fw-medium" style="font-size:0.78rem;">میانگین قیمت</span>
                                <h3 class="fw-bold mb-0" style="font-size:1.15rem;"><%= fmtNum(avgPrice) %> <small class="fw-normal text-muted-custom" style="font-size:0.7rem;">تومان</small></h3>
                            </div>
                            <div class="stat-icon icon-swatch-6"><i class="bi bi-graph-up-arrow"></i></div>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-md-7">
                        <div class="glass-card h-100">
                            <h6 class="fw-bold mb-4 d-flex align-items-center gap-2">
                                <i class="bi bi-bar-chart-fill text-accent"></i> توزیع محصولات بر اساس دسته‌بندی
                            </h6>
                            <% if (allCategories.length > 0) { %>
                                <% allCategories.forEach(function(cat){
                                    var cnt = catCounts[cat.name] || 0;
                                    var pct = allProducts.length ? Math.round((cnt / allProducts.length) * 100) : 0;
                                    var sIdx = swatchIndex(cat.icon || cat.name);
                                %>
                                <div class="cat-bar-row">
                                    <div class="cat-bar-dot icon-swatch-<%= sIdx %>"><i class="bi <%= cat.icon || 'bi-grid' %>"></i></div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="fw-semibold" style="font-size:0.85rem;"><%= cat.name %></span>
                                            <span class="text-muted-custom" style="font-size:0.78rem;"><%= cnt %> محصول · <%= pct %>%</span>
                                        </div>
                                        <div class="cat-bar-track">
                                            <div class="cat-bar-fill icon-swatch-<%= sIdx %>" style="width: <%= pct %>%;"></div>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                            <% } else { %>
                                <div class="empty-state py-3">
                                    <i class="bi bi-tags"></i>
                                    <p class="mb-0">هنوز دسته‌بندی‌ای ثبت نشده است.</p>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <div class="col-md-5">
                        <div class="glass-card h-100">
                            <h6 class="fw-bold mb-4 d-flex align-items-center gap-2">
                                <i class="bi bi-clipboard-check-fill text-accent"></i> وضعیت سیستم
                            </h6>
                            <div class="d-flex align-items-center justify-content-between p-3 rounded-3 mb-3" style="background: var(--glass-hover); border:1px solid var(--glass-border);">
                                <span class="fw-semibold d-flex align-items-center gap-2" style="font-size:0.88rem;">
                                    <span class="spinner-grow spinner-grow-sm text-success"></span> سرور و پنل
                                </span>
                                <span class="badge-soft-success rounded-pill px-3 py-2 fw-bold" style="font-size:0.72rem;">فعال و آنلاین</span>
                            </div>
                            <div class="d-flex align-items-center justify-content-between p-3 rounded-3 mb-3" style="background: var(--glass-hover); border:1px solid var(--glass-border);">
                                <span class="fw-semibold" style="font-size:0.88rem;">محصولات بدون تصویر</span>
                                <span class="<%= missingImg > 0 ? 'badge-soft-danger' : 'badge-soft-success' %> rounded-pill px-3 py-2 fw-bold" style="font-size:0.72rem;"><%= missingImg %> مورد</span>
                            </div>
                            <div class="d-flex align-items-center justify-content-between p-3 rounded-3" style="background: var(--glass-hover); border:1px solid var(--glass-border);">
                                <span class="fw-semibold" style="font-size:0.88rem;">دسته‌بندی‌های خالی</span>
                                <% var emptyCats = allCategories.filter(function(c){ return !(catCounts[c.name] > 0); }).length; %>
                                <span class="<%= emptyCats > 0 ? 'badge-soft-danger' : 'badge-soft-success' %> rounded-pill px-3 py-2 fw-bold" style="font-size:0.72rem;"><%= emptyCats %> مورد</span>
                            </div>

                            <div class="d-flex gap-2 mt-4">
                                <a href="#addProduct" onclick="setActiveTab('addProduct')" class="btn btn-accent flex-fill text-decoration-none text-center" style="font-size:0.85rem;">
                                    <i class="bi bi-plus-lg"></i> محصول جدید
                                </a>
                                <a href="#categoryManage" onclick="setActiveTab('categoryManage')" class="btn btn-glass flex-fill text-decoration-none text-center" style="font-size:0.85rem;">
                                    <i class="bi bi-grid"></i> دسته‌بندی جدید
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ══════════════ ADD PRODUCT ══════════════ -->
            <section id="addProductSection" class="content-section">
                <div class="glass-card" style="max-width: 900px;">
                    <h5 class="fw-bold mb-4 d-flex align-items-center gap-2">
                        <i class="bi bi-plus-circle-fill text-accent"></i>
                        افزودن محصول جدید به منو
                    </h5>

                    <form action="/admin" method="POST" enctype="multipart/form-data" class="row g-4" id="addProductForm">

                        <div class="col-md-6">
                            <label class="form-label fw-medium text-muted-custom">نام محصول</label>
                            <input type="text" name="iteamName" class="form-control glass-input" required placeholder="مثال: پاستا آلفردو">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-medium text-muted-custom">قیمت (تومان)</label>
                            <input type="text" inputmode="numeric" name="iteamPrice" class="form-control glass-input price-input" required placeholder="مثال: 185,000">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-medium text-muted-custom">دسته‌بندی</label>
                            <select name="category" class="form-select glass-select" required>
                                <% if (allCategories.length > 0) { %>
                                    <% allCategories.forEach(function(cat){ %>
                                        <option value="<%= cat.name %>"><%= cat.name %> (<%= cat.enname %>)</option>
                                    <% }) %>
                                <% } else { %>
                                    <option value="">ابتدا دسته‌بندی بسازید</option>
                                <% } %>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-medium text-muted-custom">تصویر محصول</label>
                            <label class="upload-drop d-block" id="addUploadDrop">
                                <i class="bi bi-cloud-arrow-up-fill d-block mb-2"></i>
                                <span class="fw-semibold d-block" style="font-size:0.85rem;" id="addUploadLabel">برای انتخاب تصویر کلیک کنید</span>
                                <span class="text-muted-custom" style="font-size:0.72rem;">PNG, JPG یا WEBP</span>
                                <input type="file" name="imageUrl" id="addImageInput" accept="image/*" class="d-none" onchange="previewAddImage(event)">
                            </label>
                            <div id="addPreviewContainer" class="d-none mt-2 text-center">
                                <img id="addPreview" class="rounded-3 border-glass" style="width:90px; height:90px; object-fit:cover; border:1px solid var(--glass-border);">
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-medium text-muted-custom">توضیحات و ترکیبات محصول</label>
                            <textarea name="description" class="form-control glass-textarea" rows="4" maxlength="400" id="addDescField"
                                      placeholder="ترکیبات: فیله مرغ، قارچ، خامه، پنیر پارمسان..."></textarea>
                            <div class="char-counter"><span id="addDescCount">0</span>/400</div>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 mt-3">
                            <button type="reset" class="btn btn-glass px-4">پاک کردن فرم</button>
                            <button type="submit" class="btn btn-accent px-5">
                                <i class="bi bi-check-circle me-1"></i> ثبت و انتشار محصول
                            </button>
                        </div>

                    </form>
                </div>
            </section>

            <!-- ══════════════ PRODUCT LIST ══════════════ -->
            <section id="productListSection" class="content-section">
                <div class="glass-card">
                    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
                        <h5 class="fw-bold mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-list-stars text-accent"></i>
                            مدیریت و لیست محصولات منو
                        </h5>
                        <div class="d-flex gap-2 flex-wrap">
                            <select class="form-select glass-select" id="categoryFilter" style="max-width:180px;" onchange="filterByCategory(this.value)">
                                <option value="">همه دسته‌بندی‌ها</option>
                                <% allCategories.forEach(function(cat){ %>
                                    <option value="<%= cat.name %>"><%= cat.name %></option>
                                <% }) %>
                            </select>
                            <div style="max-width: 260px; width: 100%;">
                                <input type="text" class="form-control glass-input rounded-pill" placeholder="جستجو در نام محصولات..." id="productSearchInput" onkeyup="searchTable(this.value)">
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted-custom" style="font-size:0.8rem;" id="productCountLabel">نمایش <%= allProducts.length %> از <%= allProducts.length %> محصول</span>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle" id="productTable">
                            <thead>
                                <tr>
                                    <th class="ps-4">تصویر</th>
                                    <th>نام محصول</th>
                                    <th>قیمت</th>
                                    <th>دسته‌بندی</th>
                                    <th class="text-center pe-4">عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (allProducts.length > 0) { %>
                                    <% allProducts.forEach(function(it){
                                        var cat = catByName(it.category);
                                        var sIdx = swatchIndex(cat ? (cat.icon || cat.name) : it.category);
                                    %>
                                        <tr data-category="<%= it.category %>">
                                            <td class="ps-4">
                                                <% if (it.imageUrl) { %>
                                                    <img src="<%= it.imageUrl %>" width="55" height="55" class="rounded-3 object-fit-cover shadow-sm border-glass">
                                                <% } else { %>
                                                    <div class="img-thumb-ph"><i class="bi bi-image"></i></div>
                                                <% } %>
                                            </td>
                                            <td class="fw-semibold"><%= it.iteamName %></td>
                                            <td class="text-accent fw-bold"><%= fmtNum(it.iteamPrice) %> <small class="text-muted-custom fw-normal">تومان</small></td>
                                            <td>
                                                <span class="product-cat-pill">
                                                    <span class="dot icon-swatch-<%= sIdx %>"></span>
                                                    <%= it.category %>
                                                </span>
                                            </td>
                                            <td class="text-center pe-4">
                                                <div class="d-flex justify-content-center gap-2">
                                                    <a href="/admin/edit/<%= it._id %>" class="btn btn-glass btn-sm text-accent">
                                                        <i class="bi bi-pencil-square"></i> ویرایش
                                                    </a>
                                                    <button type="button" class="btn btn-glass btn-sm text-danger" data-bs-toggle="modal" data-bs-target="#deleteModal"
                                                            data-bs-title="<%= it.iteamName %>" data-bs-id="<%= it._id %>">
                                                        <i class="bi bi-trash"></i> حذف
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5">
                                            <div class="empty-state">
                                                <i class="bi bi-inboxes"></i>
                                                <p class="mb-0">هیچ محصولی در سیستم یافت نشد. از تب «افزودن محصول» شروع کنید.</p>
                                            </div>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- ══════════════ CATEGORY MANAGEMENT ══════════════ -->
            <section id="categoryManageSection" class="content-section">
                <div class="row g-4">
                    <div class="col-lg-5">
                        <div class="glass-card">
                            <h5 class="fw-bold mb-4 d-flex align-items-center gap-2">
                                <i class="bi bi-plus-square-fill text-accent"></i>
                                ایجاد دسته‌بندی جدید
                            </h5>
                            <form action="/admin/category/add" method="POST" enctype="multipart/form-data" class="row g-3" id="addCategoryForm">
                                <div class="col-12">
                                    <label class="form-label fw-medium text-muted-custom">نام فارسی</label>
                                    <input type="text" name="name" class="form-control glass-input" required placeholder="مثال: پاستا">
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-medium text-muted-custom">نام انگلیسی</label>
                                    <input type="text" name="enname" class="form-control glass-input" required placeholder="مثال: pasta">
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-medium text-muted-custom">تصویر دسته‌بندی</label>

                                    <div class="icon-picker-preview">
                                        <div class="ipv-box" id="addVisualPreviewBox">
                                            <i class="bi bi-image"></i>
                                        </div>
                                        <div>
                                            <span class="fw-semibold d-block" id="addVisualPreviewLabel">هیچ تصویری انتخاب نشده</span>
                                            <span class="text-muted-custom" style="font-size:0.78rem;">یکی از وکتورهای آماده را انتخاب یا تصویر دلخواه آپلود کنید</span>
                                        </div>
                                    </div>

                                    <div class="visual-picker-grid" id="addVisualPickerGrid"></div>

                                    <label class="cat-img-upload mt-3" id="addCategoryImageDrop" for="addCategoryImageInput">
                                        <div class="cat-img-upload-icon"><i class="bi bi-cloud-arrow-up"></i></div>
                                        <div class="txt flex-grow-1">
                                            <strong>آپلود تصویر یا وکتور دلخواه</strong>
                                            <span>SVG / PNG / JPG — برای آپلود کلیک یا فایل را رها کنید</span>
                                        </div>
                                        <button type="button" class="cat-img-remove" id="addCategoryImageRemoveBtn" title="حذف تصویر">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                        <input type="file" name="image" id="addCategoryImageInput" accept="image/*,.svg" class="visually-hidden">
                                    </label>

                                    <input type="hidden" name="imageUrl" id="addSelectedImageUrl" value="">
                                </div>

                                <div class="col-12 text-end mt-2">
                                    <button type="submit" class="btn btn-accent w-100">
                                        <i class="bi bi-plus-lg me-1"></i> افزودن دسته‌بندی
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="col-lg-7">
                        <div class="glass-card">
                            <h5 class="fw-bold mb-4 d-flex align-items-center gap-2">
                                <i class="bi bi-grid-fill text-accent"></i>
                                دسته‌بندی‌های موجود
                            </h5>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead>
                                        <tr>
                                            <th class="ps-4">#</th>
                                            <th>دسته‌بندی</th>
                                            <th>نام انگلیسی</th>
                                            <th class="text-center">تعداد محصول</th>
                                            <th class="text-center pe-4">عملیات</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (allCategories.length > 0) { %>
                                            <% allCategories.forEach(function(cat, index){
                                                var sIdx = swatchIndex(cat.icon || cat.name);
                                                var cnt = catCounts[cat.name] || 0;
                                            %>
                                                <tr>
                                                    <td class="ps-4">
                                                        <span class="badge rounded-circle fw-bold d-flex align-items-center justify-content-center" style="width:32px; height:32px; background: var(--glass-hover); color: var(--accent-color); border: 1px solid var(--glass-border);">
                                                            <%= index + 1 %>
                                                        </span>
                                                    </td>
                                                    <td class="fw-bold">
                                                        <span class="cat-icon-badge icon-swatch-<%= sIdx %> me-2">
                                                            <% if (cat.image) { %>
                                                                <img src="<%= cat.image %>" alt="<%= cat.name %>" style="width:100%; height:100%; object-fit:cover; border-radius:inherit;">
                                                            <% } else { %>
                                                                <i class="bi <%= cat.icon || 'bi-image' %>"></i>
                                                            <% } %>
                                                        </span>
                                                        <%= cat.name %>
                                                    </td>
                                                    <td class="text-muted-custom"><%= cat.enname %></td>
                                                    <td class="text-center">
                                                        <span class="badge rounded-pill" style="background: var(--glass-hover); color: var(--text-main); border:1px solid var(--glass-border);"><%= cnt %></span>
                                                    </td>
                                                    <td class="text-center pe-4">
                                                        <div class="d-flex justify-content-center gap-2">
                                                            <a href="/admin/category/edit/<%= cat._id %>" class="btn btn-glass btn-sm text-accent">
                                                                <i class="bi bi-pencil-square"></i> ویرایش
                                                            </a>
                                                            <button type="button" class="btn btn-glass btn-sm text-danger" data-bs-toggle="modal" data-bs-target="#deleteCategoryModal"
                                                                    data-bs-title="<%= cat.name %>" data-bs-id="<%= cat._id %>">
                                                                <i class="bi bi-trash"></i> حذف
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="5">
                                                    <div class="empty-state">
                                                        <i class="bi bi-tags"></i>
                                                        <p class="mb-0">هیچ دسته‌بندی ثبت نشده است.</p>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ══════════════ SECURITY / CREDENTIALS ══════════════ -->
            <section id="changeCredentialsSection" class="content-section">
                <div class="glass-card mx-auto" style="max-width: 550px;">
                    <h5 class="fw-bold mb-4 text-center d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-shield-lock-fill text-accent"></i>
                        تنظیمات امنیتی و تغییر رمز عبور ادمین
                    </h5>
                    <form action="/admin/change-credentials" method="POST" id="credentialsForm" class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-medium text-muted-custom">نام کاربری جدید</label>
                            <input type="text" name="username" class="form-control glass-input" required placeholder="نام کاربری جدید را وارد کنید">
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-medium text-muted-custom">رمز عبور جدید</label>
                            <div class="input-password-wrap">
                                <input type="password" name="password" id="newPasswordInput" class="form-control glass-input" placeholder="رمز عبور قوی انتخاب کنید" autocomplete="new-password" required>
                                <button type="button" class="password-toggle" onclick="togglePassword('newPasswordInput', 'eyeIcon1')">
                                    <i class="bi bi-eye" id="eyeIcon1"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-medium text-muted-custom">تکرار رمز عبور جدید</label>
                            <div class="input-password-wrap">
                                <input type="password" name="confirmPassword" id="confirmPasswordInput" class="form-control glass-input" placeholder="رمز عبور جدید را مجدداً وارد کنید" autocomplete="new-password" required>
                                <button type="button" class="password-toggle" onclick="togglePassword('confirmPasswordInput', 'eyeIcon2')">
                                    <i class="bi bi-eye" id="eyeIcon2"></i>
                                </button>
                            </div>
                            <div class="text-danger d-none mt-2" id="passwordMatchError" style="font-size:0.8rem;">
                                <i class="bi bi-exclamation-circle"></i> رمزهای عبور با یکدیگر مطابقت ندارند.
                            </div>
                        </div>
                        <div class="col-12 text-end mt-3">
                            <button type="submit" class="btn btn-accent w-100 py-3">
                                <i class="bi bi-check-circle me-1"></i> به‌روزرسانی اطلاعات امنیتی
                            </button>
                        </div>
                    </form>
                </div>
            </section>

        </div>
    </main>
</div>

<!-- ═══════════════ MODALS ═══════════════ -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-panel" style="border-radius: 22px;">
            <div class="modal-body text-center p-5">
                <div class="mb-3"><i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 2.8rem;"></i></div>
                <h5 class="fw-bold mb-2">حذف محصول</h5>
                <p class="text-muted-custom mb-0">آیا از حذف محصول «<strong id="modalProductName"></strong>» اطمینان دارید؟ این عملیات غیرقابل بازگشت است.</p>
            </div>
            <div class="modal-footer border-0 justify-content-center pt-0 pb-4 gap-2">
                <button type="button" class="btn btn-glass rounded-pill px-4" data-bs-dismiss="modal">انصراف</button>
                <a href="#" id="confirmDeleteBtn" class="btn rounded-pill px-4 shadow" style="background: var(--danger-color); color: white; border: none;">بله، حذف شود</a>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteCategoryModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-panel" style="border-radius: 22px;">
            <div class="modal-body text-center p-5">
                <div class="mb-3"><i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 2.8rem;"></i></div>
                <h5 class="fw-bold mb-2">حذف دسته‌بندی</h5>
                <p class="text-muted-custom mb-0">آیا از حذف دسته‌بندی «<strong id="modalCategoryName"></strong>» اطمینان دارید؟ محصولات این دسته ممکن است بدون دسته‌بندی باقی بمانند.</p>
            </div>
            <div class="modal-footer border-0 justify-content-center pt-0 pb-4 gap-2">
                <button type="button" class="btn btn-glass rounded-pill px-4" data-bs-dismiss="modal">انصراف</button>
                <a href="#" id="confirmDeleteCategoryBtn" class="btn rounded-pill px-4 shadow" style="background: var(--danger-color); color: white; border: none;">بله، حذف شود</a>
            </div>
        </div>
    </div>
</div>

<!-- Toast -->
<div class="toast-container position-fixed bottom-0 start-0 p-3" style="z-index: 1080;">
    <div id="liveToast" class="toast align-items-center border-0" role="alert" aria-live="assertive" aria-atomic="true"
         style="background: rgba(46,138,80,0.2); backdrop-filter: blur(10px); border: 1px solid rgba(46,138,80,0.3) !important; color: var(--text-main); border-radius: 15px;">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-center gap-2 fw-bold" id="toastMessage"></div>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<script src="/js/jquery-3.7.1.min.js"></script>
<script src="/js/bootstrap.bundle.min.js"></script>

<script>
/* =========================================================
   وکتورهای از پیش آپلود‌شده برای دسته‌بندی‌ها (کافه/بیکری)
   فایل‌های SVG باید در public/images/categories/presets/ باشند.
========================================================= */
const CATEGORY_PRESETS = [
    { file: 'bread.svg',         label: 'نان' },
    { file: 'croissant.svg',     label: 'کرواسان' },
    { file: 'coffee.svg',        label: 'قهوه' },
    { file: 'cake.svg',          label: 'کیک' },
    { file: 'cupcake.svg',       label: 'کاپ‌کیک' },
    { file: 'donut.svg',         label: 'دونات' },
    { file: 'cookie.svg',        label: 'کوکی' },
    { file: 'cinnamon-roll.svg', label: 'رول دارچین' },
    { file: 'sandwich.svg',      label: 'ساندویچ' },
    { file: 'milk.svg',          label: 'شیر' }
];
const PRESET_BASE_PATH = '/images/categories/presets/';
/* گرید انتخاب تصویر/وکتور + آپلود دلخواه — برای فرم افزودن دسته‌بندی */
function initVisualPicker(cfg) {
    const grid        = document.getElementById(cfg.gridId);
    const hiddenUrl    = document.getElementById(cfg.hiddenId);
    const previewBox   = document.getElementById(cfg.previewBoxId);
    const previewLabel = document.getElementById(cfg.previewLabelId);
    const fileInput    = document.getElementById(cfg.fileInputId);
    const removeBtn    = document.getElementById(cfg.removeBtnId);
    const dropZone      = document.getElementById(cfg.dropZoneId);
    if (!grid) return;

    let currentValue = hiddenUrl.value || '';

    function setPreview(src, label) {
        previewBox.innerHTML = src
            ? `<img src="${src}" alt="">`
            : `<i class="bi bi-image"></i>`;
        if (previewLabel) previewLabel.textContent = label || 'هیچ تصویری انتخاب نشده';
        if (removeBtn) removeBtn.classList.toggle('show', Boolean(src));
    }

    function highlightActive(activeFile) {
        grid.querySelectorAll('.visual-picker-item').forEach(item => {
            item.classList.toggle('active', item.dataset.file === activeFile);
        });
    }

    function renderGrid() {
        grid.innerHTML = '';
        CATEGORY_PRESETS.forEach(preset => {
            const path = PRESET_BASE_PATH + preset.file;
            const item = document.createElement('div');
            item.className = 'visual-picker-item' + (currentValue === path ? ' active' : '');
            item.dataset.file = path;
            item.title = preset.label;
            item.innerHTML = `<img src="${path}" alt="${preset.label}" loading="lazy">`;
            item.addEventListener('click', () => {
                if (fileInput) fileInput.value = '';
                hiddenUrl.value = path;
                currentValue = path;
                highlightActive(path);
                setPreview(path, preset.label);
            });
            grid.appendChild(item);
        });
    }
    renderGrid();

    if (fileInput) {
        fileInput.addEventListener('change', function () {
            const file = this.files && this.files[0];
            if (!file) return;
            highlightActive(null);
            const reader = new FileReader();
            reader.onload = e => setPreview(e.target.result, file.name);
            reader.readAsDataURL(file);
        });
    }

    if (removeBtn) {
        removeBtn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            if (fileInput) fileInput.value = '';
            hiddenUrl.value = '';
            currentValue = '';
            highlightActive(null);
            setPreview(null, null);
        });
    }

    if (dropZone) {
        ['dragenter', 'dragover'].forEach(evt => {
            dropZone.addEventListener(evt, e => { e.preventDefault(); dropZone.classList.add('dragover'); });
        });
        ['dragleave', 'drop'].forEach(evt => {
            dropZone.addEventListener(evt, e => { e.preventDefault(); dropZone.classList.remove('dragover'); });
        });
        dropZone.addEventListener('drop', function (e) {
            const file = e.dataTransfer.files && e.dataTransfer.files[0];
            if (!file || !fileInput) return;
            fileInput.files = e.dataTransfer.files;
            fileInput.dispatchEvent(new Event('change'));
        });
    }
}

document.addEventListener("DOMContentLoaded", function () {

    initVisualPicker({
        gridId: 'addVisualPickerGrid',
        hiddenId: 'addSelectedImageUrl',
        previewBoxId: 'addVisualPreviewBox',
        previewLabelId: 'addVisualPreviewLabel',
        fileInputId: 'addCategoryImageInput',
        removeBtnId: 'addCategoryImageRemoveBtn',
        dropZoneId: 'addCategoryImageDrop'
    });


    const deleteModal = document.getElementById('deleteModal');
    if (deleteModal) {
        deleteModal.addEventListener('show.bs.modal', event => {
            const btn = event.relatedTarget;
            deleteModal.querySelector('#modalProductName').textContent = btn.getAttribute('data-bs-title');
            deleteModal.querySelector('#confirmDeleteBtn').href = `/admin/delete/${btn.getAttribute('data-bs-id')}`;
        });
    }

    const deleteCategoryModal = document.getElementById('deleteCategoryModal');
    if (deleteCategoryModal) {
        deleteCategoryModal.addEventListener('show.bs.modal', event => {
            const btn = event.relatedTarget;
            deleteCategoryModal.querySelector('#modalCategoryName').textContent = btn.getAttribute('data-bs-title');
            deleteCategoryModal.querySelector('#confirmDeleteCategoryBtn').href = `/admin/category/delete/${btn.getAttribute('data-bs-id')}`;
        });
    }

    // --- اعتبارسنجی فرم رمز عبور ---
    const credForm = document.getElementById('credentialsForm');
    if (credForm) {
        credForm.addEventListener('submit', function (e) {
            const pass = document.getElementById('newPasswordInput').value;
            const confirm = document.getElementById('confirmPasswordInput').value;
            const errorEl = document.getElementById('passwordMatchError');
            if (pass !== confirm) {
                e.preventDefault();
                errorEl.classList.remove('d-none');
                document.getElementById('confirmPasswordInput').classList.add('border-danger');
            } else {
                errorEl.classList.add('d-none');
                document.getElementById('confirmPasswordInput').classList.remove('border-danger');
            }
        });
        document.getElementById('confirmPasswordInput').addEventListener('input', function () {
            document.getElementById('passwordMatchError').classList.add('d-none');
            this.classList.remove('border-danger');
        });
    }

    // --- همگام‌سازی آیکون تم با مقدار مشترک با صفحه اصلی (nanonan-theme) ---
    // خودِ تم پیش از رندر توسط اسکریپت ضدفلاش در <head> ست شده؛ اینجا فقط آیکون را هماهنگ می‌کنیم.
    updateThemeIcon(document.documentElement.getAttribute('data-bs-theme') || 'dark');

    const initialHash = window.location.hash || '#dashboard';
    setActiveTab(initialHash.substring(1));

    // --- Image Preview (Add Product) ---
    window.previewAddImage = function (event) {
        const reader = new FileReader();
        const container = document.getElementById("addPreviewContainer");
        const preview = document.getElementById("addPreview");
        const label = document.getElementById("addUploadLabel");
        reader.onload = function () {
            preview.src = reader.result;
            container.classList.remove("d-none");
        };
        if (event.target.files[0]) {
            label.textContent = event.target.files[0].name;
            reader.readAsDataURL(event.target.files[0]);
        } else {
            container.classList.add("d-none");
            label.textContent = "برای انتخاب تصویر کلیک کنید";
        }
    };

    // --- شمارنده کاراکتر توضیحات ---
    const addDescField = document.getElementById('addDescField');
    const addDescCount = document.getElementById('addDescCount');
    if (addDescField) {
        addDescField.addEventListener('input', () => { addDescCount.textContent = addDescField.value.length; });
    }

    // --- فرمت‌دهی قیمت با کاما ---
    document.querySelectorAll('.price-input').forEach(input => {
        input.addEventListener('input', function () {
            let raw = this.value.replace(/[^\d]/g, '');
            this.value = raw.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        });
    });
    document.querySelectorAll('form').forEach(form => {
        form.addEventListener('submit', function () {
            form.querySelectorAll('.price-input').forEach(input => {
                input.value = input.value.replace(/,/g, '');
            });
        });
    });

    // --- لودینگ تعاملی برای دکمه‌های ارسال فرم (افزودن محصول/دسته‌بندی/امنیت) ---
    document.querySelectorAll('form').forEach(form => {
        const submitBtn = form.querySelector('button[type="submit"].btn-accent');
        if (!submitBtn) return;
        form.addEventListener('submit', function () {
            if (!form.checkValidity()) return;
            if (submitBtn.dataset.loading === '1') return;
            submitBtn.dataset.loading = '1';
            submitBtn.dataset.originalHtml = submitBtn.innerHTML;
            submitBtn.setAttribute('disabled', 'disabled');
            submitBtn.style.position = 'relative';
            submitBtn.innerHTML =
                '<span style="opacity:0;">' + submitBtn.innerHTML + '</span>' +
                '<span style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center;">' +
                '<span style="width:18px;height:18px;border:2.5px solid rgba(255,255,255,.4);border-top-color:currentColor;border-radius:50%;display:inline-block;animation:spin .7s linear infinite;"></span>' +
                '</span>';
        });
    });
    if (!document.getElementById('spinKeyframes')) {
        const styleTag = document.createElement('style');
        styleTag.id = 'spinKeyframes';
        styleTag.textContent = '@keyframes spin{to{transform:rotate(360deg);}}';
        document.head.appendChild(styleTag);
    }

    // --- جستجوی جدول محصولات ---
    window.searchTable = function (value) {
        applyTableFilters();
    };
    window.filterByCategory = function (value) {
        applyTableFilters();
    };
    function applyTableFilters() {
        const searchVal = (document.getElementById('productSearchInput')?.value || '').toLowerCase();
        const catVal = document.getElementById('categoryFilter')?.value || '';
        const rows = document.querySelectorAll("#productTable tbody tr");
        let visibleCount = 0, totalCount = 0;
        rows.forEach(row => {
            if (row.querySelector('td')?.colSpan === 5) return;
            totalCount++;
            const matchesSearch = row.innerText.toLowerCase().includes(searchVal);
            const matchesCat = !catVal || row.getAttribute('data-category') === catVal;
            const show = matchesSearch && matchesCat;
            row.style.display = show ? "" : "none";
            if (show) visibleCount++;
        });
        const label = document.getElementById('productCountLabel');
        if (label) label.textContent = `نمایش ${visibleCount} از ${totalCount} محصول`;
    }

    // --- ساعت و تاریخ سایدبار ---
    function updateClock() {
        const now = new Date();
        const clockEl = document.getElementById('liveClock');
        const dateEl = document.getElementById('liveDate');
        if (clockEl) clockEl.textContent = now.toLocaleTimeString('fa-IR', { hour: '2-digit', minute: '2-digit' });
        if (dateEl) dateEl.textContent = now.toLocaleDateString('fa-IR', { day: 'numeric', month: 'short' });
    }
    updateClock();
    setInterval(updateClock, 30000);
});

// --- نمایش/پنهان رمز عبور ---
function togglePassword(inputId, iconId) {
    const input = document.getElementById(inputId);
    const icon = document.getElementById(iconId);
    if (input.type === 'password') {
        input.type = 'text';
        icon.classList.replace('bi-eye', 'bi-eye-slash');
    } else {
        input.type = 'password';
        icon.classList.replace('bi-eye-slash', 'bi-eye');
    }
}

// --- Toast ---
function showToast(message, type = 'success') {
    const toastEl = document.getElementById('liveToast');
    const toastMessage = document.getElementById('toastMessage');
    const toast = new bootstrap.Toast(toastEl);
    const isSuccess = type === 'success';
    toastEl.style.background = isSuccess ? 'rgba(46,138,80,0.2)' : 'rgba(214,69,59,0.2)';
    toastEl.style.borderColor = isSuccess ? 'rgba(46,138,80,0.4)' : 'rgba(214,69,59,0.4)';
    toastMessage.innerHTML = `<i class="bi ${isSuccess ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-danger'} fs-5"></i> <span>${message}</span>`;
    toast.show();
}

// --- Sidebar ---
function toggleSidebar() {
    document.getElementById("sidebar").classList.toggle("show");
    document.getElementById("sidebarOverlay").classList.toggle("show");
}
function closeSidebarOnMobile() {
    if (window.innerWidth < 992) {
        document.getElementById("sidebar").classList.remove("show");
        document.getElementById("sidebarOverlay").classList.remove("show");
    }
}

// --- Theme ---
function toggleTheme() {
    const html = document.documentElement;
    const newTheme = html.getAttribute("data-bs-theme") === "dark" ? "light" : "dark";
    html.setAttribute("data-bs-theme", newTheme);
    try { localStorage.setItem("nanonan-theme", newTheme); } catch (e) {}
    updateThemeIcon(newTheme);
}
function updateThemeIcon(theme) {
    const icon = document.getElementById("themeIcon");
    if (!icon) return;
    if (theme === "light") {
        icon.classList.replace("bi-moon-stars-fill", "bi-sun-fill");
    } else {
        icon.classList.replace("bi-sun-fill", "bi-moon-stars-fill");
    }
}

// --- Tab Switching ---
function setActiveTab(targetId) {
    document.querySelectorAll('.content-section').forEach(s => s.classList.remove('active-section'));
    const target = document.getElementById(targetId + 'Section');
    if (target) target.classList.add('active-section');
    document.querySelectorAll('#sidebarNav .nav-link').forEach(link => {
        link.classList.toggle('active', link.getAttribute('href') === `#${targetId}`);
    });
    history.replaceState(null, '', `#${targetId}`);
}

// --- AJAX وضعیت سفارش (در صورت وجود فرم در صفحات آینده) ---
document.querySelectorAll('.update-status-form').forEach(form => {
    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const orderId = form.getAttribute('data-order-id');
        const newStatus = form.querySelector('select[name="newStatus"]').value;
        try {
            const response = await fetch(`/admin/order/update_status/${orderId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ newStatus })
            });
            const result = await response.json();
            if (response.ok) { showToast(result.message, 'success'); setTimeout(() => window.location.reload(), 1000); }
            else { showToast('خطا: ' + (result.message || 'نامشخص'), 'danger'); }
        } catch { showToast('خطای ارتباط با سرور.', 'danger'); }
    });
});
</script>

</body>
</html>
