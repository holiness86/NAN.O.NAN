    }

    const credForm = document.getElementById('credentialsForm');
    if (credForm) {
        credForm.addEventListener('submit', function (e) {
            const pass = document.getElementById('newPasswordInput').value;
            const confirm = document.getElementById('confirmPasswordInput').value;
            const errorEl = document.getElementById('passwordMatchError');
            if (pass !== confirm) {
                e.preventDefault();
                errorEl.classList.remove('d-none');
                document.getElementById('confirmPasswordInput').classList.add('border-danger');
            } else {
                errorEl.classList.add('d-none');
                document.getElementById('confirmPasswordInput').classList.remove('border-danger');
            }
        });
        document.getElementById('confirmPasswordInput').addEventListener('input', function () {
            document.getElementById('passwordMatchError').classList.add('d-none');
            this.classList.remove('border-danger');
        });
    }

    updateThemeIcon(document.documentElement.getAttribute('data-bs-theme') || 'dark');

    let savedTab = null;
    try { savedTab = localStorage.getItem(ADMIN_TAB_STORAGE_KEY); } catch (e) {}
    const initialTab = (window.location.hash ? window.location.hash.substring(1) : '') || savedTab || 'dashboard';
    setActiveTab(document.getElementById(initialTab + 'Section') ? initialTab : 'dashboard');

    window.previewAddImage = function (event) {
        const reader = new FileReader();
        const container = document.getElementById("addPreviewContainer");
        const preview = document.getElementById("addPreview");
        const label = document.getElementById("addUploadLabel");
        const hint = document.getElementById("addUploadHint");
        reader.onload = function () {
            preview.src = reader.result;
            container.classList.remove("d-none");
            if (hint) hint.style.opacity = '0';
        };
        if (event.target.files[0]) {
            label.textContent = event.target.files[0].name;
            reader.readAsDataURL(event.target.files[0]);
        } else {
            container.classList.add("d-none");
            if (hint) hint.style.opacity = '1';
            label.textContent = "برای انتخاب تصویر کلیک کن";
        }
    };

    const addDescField = document.getElementById('addDescField');
    const addDescCount = document.getElementById('addDescCount');
    if (addDescField) {
        addDescField.addEventListener('input', () => { addDescCount.textContent = addDescField.value.length; });
    }

    (function initAddProductLivePreview() {
        var nameField  = document.getElementById('addNameField');
        var priceField = document.getElementById('addPriceField');
        var mainSelect = document.getElementById('addMainCategorySelect');
        var subSelect  = document.getElementById('addSubCategorySelect');
        var pvName  = document.getElementById('livePreviewName');
        var pvPrice = document.getElementById('livePreviewPrice');
        var pvDesc  = document.getElementById('livePreviewDesc');
        var pvCat   = document.getElementById('livePreviewCat');
        if (!nameField || !pvName) return;

        function toFa(n) { try { return Number(n || 0).toLocaleString('fa-IR'); } catch (e) { return n; } }

        function syncCategory() {
            var subVisible = document.getElementById('addSubWrap') && document.getElementById('addSubWrap').classList.contains('show');
            var label = (subVisible && subSelect && subSelect.value && subSelect.options.length) ? subSelect.options[subSelect.selectedIndex].textContent : (mainSelect.options[mainSelect.selectedIndex] ? mainSelect.options[mainSelect.selectedIndex].textContent : 'دسته‌بندی');
            pvCat.innerHTML = '<i class="bi bi-tag"></i> ' + label;
        }

        nameField.addEventListener('input', function () { pvName.textContent = nameField.value.trim() || 'نام محصول شما'; });
        priceField.addEventListener('input', function () {
            var raw = priceField.value.replace(/[^\d]/g, '');
            pvPrice.innerHTML = toFa(raw || 0) + ' <small>تومان</small>';
        });
        addDescField && addDescField.addEventListener('input', function () {
            pvDesc.textContent = addDescField.value.trim() || 'توضیحات محصول اینجا نمایش داده می‌شود...';
        });
        mainSelect && mainSelect.addEventListener('change', function () { setTimeout(syncCategory, 60); });
        subSelect  && subSelect.addEventListener('change', syncCategory);
        setTimeout(syncCategory, 120);

        var formEl = document.getElementById('addProductForm');
        if (formEl) {
            formEl.addEventListener('reset', function () {
                setTimeout(function () {
                    pvName.textContent = 'نام محصول شما';
                    pvPrice.innerHTML = '۰ <small>تومان</small>';
                    pvDesc.textContent = 'توضیحات محصول اینجا نمایش داده می‌شود...';
                    var pc = document.getElementById('addPreviewContainer');
                    var hint = document.getElementById('addUploadHint');
                    if (pc) pc.classList.add('d-none');
                    if (hint) hint.style.opacity = '1';
                    syncCategory();
                }, 10);
            });
        }
    })();

    document.querySelectorAll('.price-input').forEach(input => {
        input.addEventListener('input', function () {
            let raw = this.value.replace(/[^\d]/g, '');
            this.value = raw.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        });
    });
    document.querySelectorAll('form').forEach(form => {
        form.addEventListener('submit', function () {
            form.querySelectorAll('.price-input').forEach(input => {
                input.value = input.value.replace(/,/g, '');
            });
        });
    });

    document.querySelectorAll('form').forEach(form => {
        const submitBtn = form.querySelector('button[type="submit"].btn-accent');
        if (!submitBtn) return;
        form.addEventListener('submit', function () {
            if (!form.checkValidity()) return;
            if (submitBtn.dataset.loading === '1') return;
            submitBtn.dataset.loading = '1';
            submitBtn.dataset.originalHtml = submitBtn.innerHTML;
            submitBtn.setAttribute('disabled', 'disabled');
            submitBtn.style.position = 'relative';
            submitBtn.innerHTML =
                '<span style="opacity:0;">' + submitBtn.innerHTML + '</span>' +
                '<span style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center;">' +
                '<span style="width:18px;height:18px;border:2.5px solid rgba(255,255,255,.4);border-top-color:currentColor;border-radius:50%;display:inline-block;animation:spin .7s linear infinite;"></span>' +
                '</span>';
        });
    });
    if (!document.getElementById('spinKeyframes')) {
        const styleTag = document.createElement('style');
        styleTag.id = 'spinKeyframes';
        styleTag.textContent = '@keyframes spin{to{transform:rotate(360deg);}}';
        document.head.appendChild(styleTag);
    }

    window.searchTable = function (value) {
        applyTableFilters();
    };
    window.filterByCategory = function (value) {
        applyTableFilters();
    };
    function applyTableFilters() {
        const searchVal = (document.getElementById('productSearchInput')?.value || '').toLowerCase();
        const catVal = document.getElementById('categoryFilter')?.value || '';
        const rows = document.querySelectorAll("#productTable tbody tr[data-category]");
        const cards = document.querySelectorAll("#productCards .product-mobile-card");
        let visibleCount = 0, totalCount = 0;

        function matches(el) {
            const matchesSearch = el.innerText.toLowerCase().includes(searchVal);
            const matchesCat = !catVal || el.getAttribute('data-category') === catVal;
            return matchesSearch && matchesCat;
        }

        rows.forEach(row => {
            totalCount++;
            const show = matches(row);
            row.style.display = show ? "" : "none";
            if (show) visibleCount++;
        });
        cards.forEach(card => {
            card.style.display = matches(card) ? "" : "none";
        });

        const label = document.getElementById('productCountLabel');
        if (label) label.textContent = `نمایش ${visibleCount} از ${totalCount} محصول`;
    }

    function updateClock() {
        const now = new Date();
        const clockEl = document.getElementById('liveClock');
        const dateEl = document.getElementById('liveDate');
        if (clockEl) clockEl.textContent = now.toLocaleTimeString('fa-IR', { hour: '2-digit', minute: '2-digit' });
        if (dateEl) dateEl.textContent = now.toLocaleDateString('fa-IR', { day: 'numeric', month: 'short' });
    }
    updateClock();
    setInterval(updateClock, 30000);
});

function togglePassword(inputId, iconId) {
    const input = document.getElementById(inputId);
    const icon = document.getElementById(iconId);
    if (input.type === 'password') {
        input.type = 'text';
        icon.classList.replace('bi-eye', 'bi-eye-slash');
    } else {
        input.type = 'password';
        icon.classList.replace('bi-eye-slash', 'bi-eye');
    }
}

function showToast(message, type = 'success') {
    const toastEl = document.getElementById('liveToast');
    const toastMessage = document.getElementById('toastMessage');
    const toast = new bootstrap.Toast(toastEl);
    const isSuccess = type === 'success';
    toastEl.style.background = isSuccess ? 'rgba(46,138,80,0.2)' : 'rgba(214,69,59,0.2)';
    toastEl.style.borderColor = isSuccess ? 'rgba(46,138,80,0.4)' : 'rgba(214,69,59,0.4)';
    toastMessage.innerHTML = `<i class="bi ${isSuccess ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-danger'} fs-5"></i> <span>${message}</span>`;
    toast.show();
}

function toggleSidebar() {
    document.getElementById("sidebar").classList.toggle("show");
    document.getElementById("sidebarOverlay").classList.toggle("show");
}
function closeSidebarOnMobile() {
    if (window.innerWidth < 992) {
        document.getElementById("sidebar").classList.remove("show");
        document.getElementById("sidebarOverlay").classList.remove("show");
    }
}

function toggleTheme() {
    const html = document.documentElement;
    const newTheme = html.getAttribute("data-bs-theme") === "dark" ? "light" : "dark";
    html.setAttribute("data-bs-theme", newTheme);
    try { localStorage.setItem("bubbleteale-theme", newTheme); } catch (e) {}
    updateThemeIcon(newTheme);
}
function updateThemeIcon(theme) {
    const icon = document.getElementById("themeIcon");
    if (!icon) return;
    if (theme === "light") {
        icon.classList.replace("bi-moon-stars-fill", "bi-sun-fill");
    } else {
        icon.classList.replace("bi-sun-fill", "bi-moon-stars-fill");
    }
}

const ADMIN_TAB_STORAGE_KEY = 'babol-admin-active-tab';
function setActiveTab(targetId) {
    document.querySelectorAll('.content-section').forEach(s => s.classList.remove('active-section'));
    const target = document.getElementById(targetId + 'Section');
    if (target) target.classList.add('active-section');
    document.querySelectorAll('#sidebarNav .nav-link').forEach(link => {
        link.classList.toggle('active', link.getAttribute('href') === `#${targetId}`);
    });
    history.replaceState(null, '', `#${targetId}`);
    try { localStorage.setItem(ADMIN_TAB_STORAGE_KEY, targetId); } catch (e) {}
}

document.querySelectorAll('.update-status-form').forEach(form => {
    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const orderId = form.getAttribute('data-order-id');
        const newStatus = form.querySelector('select[name="newStatus"]').value;
        try {
            const response = await fetch(`/admin/order/update_status/${orderId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ newStatus })
            });
            const result = await response.json();
            if (response.ok) { showToast(result.message, 'success'); setTimeout(() => window.location.reload(), 1000); }
            else { showToast('خطا: ' + (result.message || 'نامشخص'), 'danger'); }
        } catch { showToast('خطای ارتباط با سرور.', 'danger'); }
    });
});
</script>

</body>
</html>
