const PRESET_BASE_PATH = '/images/categories/presets/';

const CAT_SEP = ' — ';

function parseCategoryFull(full) {
    if (!full) return { parent: '', child: '' };
    var idx = full.indexOf(CAT_SEP);
    if (idx === -1) return { parent: full.trim(), child: '' };
    return { parent: full.slice(0, idx).trim(), child: full.slice(idx + CAT_SEP.length).trim() };
}

function buildCategoryTree(realSelectEl) {
    var tree = {}, order = [];
    if (!realSelectEl) return { tree: tree, order: order };
    Array.prototype.forEach.call(realSelectEl.options, function (opt) {
        var full = opt.value;
        if (!full) return;
        var p = parseCategoryFull(full);
        if (!tree[p.parent]) { tree[p.parent] = { hasOwn: false, ownValue: '', children: [] }; order.push(p.parent); }
        if (p.child) tree[p.parent].children.push({ label: p.child, full: full });
        else { tree[p.parent].hasOwn = true; tree[p.parent].ownValue = full; }
    });
    return { tree: tree, order: order };
}

function initCategoryCascade(opts) {
    var realSelect = document.getElementById(opts.realId);
    var mainSelect = document.getElementById(opts.mainId);
    var subWrap    = document.getElementById(opts.subWrapId);
    var subSelect  = document.getElementById(opts.subId);
    if (!realSelect || !mainSelect || !subSelect || !subWrap) return;

    var data = buildCategoryTree(realSelect);
    var tree = data.tree, order = data.order;
    if (!order.length) return;

    mainSelect.innerHTML = '';
    order.forEach(function (name) {
        var o = document.createElement('option');
        o.value = name; o.textContent = name;
        mainSelect.appendChild(o);
    });

    function fillSub(parentName, preselectFull) {
        var node = tree[parentName];
        subSelect.innerHTML = '';
        if (!node || node.children.length === 0) {
            subWrap.classList.remove('show');
            realSelect.value = node ? node.ownValue : '';
            return;
        }
        node.children.forEach(function (c) {
            var o = document.createElement('option');
            o.value = c.full; o.textContent = c.label;
            subSelect.appendChild(o);
        });
        subWrap.classList.add('show');
        if (preselectFull) subSelect.value = preselectFull;
        realSelect.value = subSelect.value;
    }

    mainSelect.addEventListener('change', function () { fillSub(mainSelect.value, null); });
    subSelect.addEventListener('change', function () { realSelect.value = subSelect.value; });

    var initialFull = opts.initialValue || (realSelect.options[0] ? realSelect.options[0].value : '');
    var p = parseCategoryFull(initialFull);
    if (order.indexOf(p.parent) === -1) p.parent = order[0];
    mainSelect.value = p.parent;
    fillSub(p.parent, initialFull);
}

document.addEventListener('DOMContentLoaded', function () {

    initCategoryCascade({
        realId: 'addRealCategorySelect', mainId: 'addMainCategorySelect',
        subWrapId: 'addSubWrap', subId: 'addSubCategorySelect'
    });

    var editRealSel = document.getElementById('editRealCategorySelect');
    if (editRealSel) {
        initCategoryCascade({
            realId: 'editRealCategorySelect', mainId: 'editMainCategorySelect',
            subWrapId: 'editSubWrap', subId: 'editSubCategorySelect',
            initialValue: editRealSel.dataset.initial || ''
        });
    }

    document.querySelectorAll('.cat-name-render[data-cat-name]').forEach(function (el) {
        var full = el.getAttribute('data-cat-name') || '';
        var p = parseCategoryFull(full);
        if (!p.child) { el.textContent = full; return; }
        el.innerHTML =
            '<span class="cat-tree-render">' +
                '<span class="cat-pill-main">' + p.parent + '</span>' +
                '<i class="bi bi-chevron-left cat-tree-sep"></i>' +
                '<span class="cat-pill-sub">' + p.child + '</span>' +
            '</span>';
    });

    (function groupCategoryFilter() {
        var sel = document.getElementById('categoryFilter');
        if (!sel) return;
        var allOpt = sel.querySelector('option[value=""]');
        var opts = Array.prototype.slice.call(sel.querySelectorAll('option')).filter(function (o) { return o.value !== ''; });
        if (!opts.length) return;
        var groups = {}, order = [];
        opts.forEach(function (o) {
            var p = parseCategoryFull(o.value);
            if (!groups[p.parent]) { groups[p.parent] = []; order.push(p.parent); }
            o.textContent = p.child || p.parent;
            groups[p.parent].push(o);
        });
        sel.innerHTML = '';
        if (allOpt) sel.appendChild(allOpt);
        else { var d = document.createElement('option'); d.value = ''; d.textContent = 'همه دسته‌بندی‌ها'; sel.appendChild(d); }
        order.forEach(function (parentName) {
            if (groups[parentName].length === 1 && groups[parentName][0].value === parentName) {
                sel.appendChild(groups[parentName][0]);
            } else {
                var og = document.createElement('optgroup');
                og.label = parentName;
                groups[parentName].forEach(function (o) { og.appendChild(o); });
                sel.appendChild(og);
            }
        });
    })();

    (function initAddCategoryToggle() {
        var toggle       = document.getElementById('addCatTypeToggle');
        var form         = document.getElementById('addCategoryForm');
        var parentWrap   = document.getElementById('addParentWrap');
        var parentSelect = document.getElementById('addParentSelect');
        var nameLabel    = document.getElementById('addCatNameLabel');
        var nameInput    = document.getElementById('addCategoryNameInput');
        if (!toggle || !form) return;
        var currentType = 'main';

        toggle.querySelectorAll('.cat-type-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                toggle.querySelectorAll('.cat-type-btn').forEach(function (b) { b.classList.remove('active'); });
                btn.classList.add('active');
                currentType = btn.getAttribute('data-type');
                if (currentType === 'sub') {
                    parentWrap.classList.add('show');
                    nameLabel.textContent = 'نام زیرمجموعه (فارسی)';
                    nameInput.placeholder = 'مثال: نوشیدنی سرد';
                } else {
                    parentWrap.classList.remove('show');
                    nameLabel.textContent = 'نام فارسی';
                    nameInput.placeholder = 'مثال: پاستا';
                }
            });
        });

        form.addEventListener('submit', function (e) {
            if (currentType !== 'sub') return;
            var parentVal = parentSelect ? parentSelect.value : '';
            if (!parentVal) {
                e.preventDefault();
                if (typeof showToast === 'function') showToast('لطفاً یک دسته والد انتخاب کنید.', 'danger');
                return;
            }
            var childVal = nameInput.value.trim();
            nameInput.value = parentVal + CAT_SEP + childVal;
        });
    })();
});

function initVisualPicker(cfg) {
    const grid        = document.getElementById(cfg.gridId);
    const hiddenUrl    = document.getElementById(cfg.hiddenId);
    const previewBox   = document.getElementById(cfg.previewBoxId);
    const previewLabel = document.getElementById(cfg.previewLabelId);
    const fileInput    = document.getElementById(cfg.fileInputId);
    const removeBtn    = document.getElementById(cfg.removeBtnId);
    const dropZone      = document.getElementById(cfg.dropZoneId);
    if (!grid) return;

    let currentValue = hiddenUrl.value || '';

    function setPreview(src, label) {
        previewBox.innerHTML = src
            ? `<img src="${src}" alt="">`
            : `<i class="bi bi-image"></i>`;
        if (previewLabel) previewLabel.textContent = label || 'هیچ تصویری انتخاب نشده';
        if (removeBtn) removeBtn.classList.toggle('show', Boolean(src));
    }

    function highlightActive(activeFile) {
        grid.querySelectorAll('.visual-picker-item').forEach(item => {
            item.classList.toggle('active', item.dataset.file === activeFile);
        });
    }

    function renderGrid(list) {
        const items = list || CATEGORY_PRESETS;
        grid.innerHTML = '';
        if (items.length === 0) {
            grid.innerHTML = '<p class="text-center text-muted-custom small py-3 mb-0" style="grid-column:1/-1;">وکتوری با این عنوان پیدا نشد.</p>';
            return;
        }
        items.forEach(preset => {
            const path = PRESET_BASE_PATH + preset.file;
            const item = document.createElement('div');
            item.className = 'visual-picker-item' + (currentValue === path ? ' active' : '');
            item.dataset.file = path;
            item.title = preset.label;
            item.innerHTML = `<img src="${path}" alt="${preset.label}" loading="lazy">`;
            item.addEventListener('click', () => {
                if (fileInput) fileInput.value = '';
                hiddenUrl.value = path;
                currentValue = path;
                highlightActive(path);
                setPreview(path, preset.label);
            });
            grid.appendChild(item);
        });
    }
    renderGrid();

    if (cfg.searchId) {
        const searchInput = document.getElementById(cfg.searchId);
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                const q = this.value.trim();
                const filtered = q ? CATEGORY_PRESETS.filter(p => p.label.indexOf(q) !== -1) : CATEGORY_PRESETS;
                renderGrid(filtered);
            });
        }
    }

    if (fileInput) {
        fileInput.addEventListener('change', function () {
            const file = this.files && this.files[0];
            if (!file) return;
            highlightActive(null);
            const reader = new FileReader();
            reader.onload = e => setPreview(e.target.result, file.name);
            reader.readAsDataURL(file);
        });
    }

    if (removeBtn) {
        removeBtn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            if (fileInput) fileInput.value = '';
            hiddenUrl.value = '';
            currentValue = '';
            highlightActive(null);
            setPreview(null, null);
        });
    }

    if (dropZone) {
        ['dragenter', 'dragover'].forEach(evt => {
            dropZone.addEventListener(evt, e => { e.preventDefault(); dropZone.classList.add('dragover'); });
        });
        ['dragleave', 'drop'].forEach(evt => {
            dropZone.addEventListener(evt, e => { e.preventDefault(); dropZone.classList.remove('dragover'); });
        });
        dropZone.addEventListener('drop', function (e) {
            const file = e.dataTransfer.files && e.dataTransfer.files[0];
            if (!file || !fileInput) return;
            fileInput.files = e.dataTransfer.files;
            fileInput.dispatchEvent(new Event('change'));
        });
    }
}

