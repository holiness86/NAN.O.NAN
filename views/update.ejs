<!DOCTYPE html>
<html lang="fa" dir="rtl" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ویرایش محصول | <%= iteam.iteamName %> — بابل تیله رزکان</title>

    <script>
      (function () {
        try {
          var t = localStorage.getItem('bubbleteale-theme');
          if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-bs-theme', t);
        } catch (e) {}
      })();
    </script>

    <link href="/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/icons-1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        :root, [data-bs-theme="light"] {
            --bg-gradient-1: var(--cream);
            --bg-gradient-2: var(--cream-deep);
            --bg-gradient-3: var(--surface-raised);
            --glass-bg: var(--surface-glass);
            --glass-border: var(--border-warm);
            --glass-shadow: rgba(var(--ink-rgb), .08);
            --glass-hover: var(--brand-soft);
            --text-main: var(--ink);
            --text-muted: var(--ink-muted);
            --input-bg: rgba(255, 255, 255, 0.65);
            --input-focus: rgba(255, 255, 255, 0.92);
            --accent-color: var(--brand);
            --accent-hover: var(--brand-dark);
            --option-bg: var(--surface);
        }
        [data-bs-theme="dark"] {
            --bg-gradient-1: var(--cream);
            --bg-gradient-2: var(--cream-deep);
            --bg-gradient-3: var(--surface-raised);
            --glass-bg: var(--surface-glass);
            --glass-border: var(--border-warm);
            --glass-shadow: rgba(0, 0, 0, 0.5);
            --glass-hover: var(--brand-soft);
            --text-main: var(--ink);
            --text-muted: var(--ink-muted);
            --input-bg: rgba(0, 0, 0, 0.3);
            --input-focus: rgba(0, 0, 0, 0.5);
            --accent-color: var(--brand);
            --accent-hover: var(--brand-dark);
            --option-bg: var(--surface);
        }
        body {
            background: linear-gradient(-45deg, var(--bg-gradient-1), var(--bg-gradient-2), var(--bg-gradient-3));
            color: var(--text-main);
            font-family: 'YekanBakh', Tahoma, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1.5rem;
        }
        .glass-card {
            background: var(--glass-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 30px;
            border-radius: max(30px, 1.85rem);
            box-shadow: 0 12px 40px var(--glass-shadow);
            width: 100%;
            max-width: 1100px;
            padding: 2.6rem;
        }
        .glass-input, .glass-select, .glass-textarea {
            background: var(--input-bg) !important;
            border: 1px solid var(--glass-border) !important;
            color: var(--text-main) !important;
            border-radius: 16px !important;
            padding: 0.75rem 1rem;
            transition: all 0.3s ease;
        }
        .glass-input:focus, .glass-select:focus, .glass-textarea:focus {
            box-shadow: 0 0 0 4px rgba(87,45,119, 0.2) !important;
            border-color: var(--accent-color) !important;
            background: var(--input-focus) !important;
        }
        option { background-color: var(--option-bg); color: var(--text-main); }
        .btn-accent {
            background: linear-gradient(135deg, var(--accent-color), var(--accent-hover));
            color: #FFFFFF !important;
            border: none;
            border-radius: 18px;
            padding: 0.75rem 1.6rem;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        .btn-accent:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(87,45,119, 0.3); }
        .btn-glass {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--glass-border);
            color: var(--text-main);
            border-radius: 18px;
            padding: 0.75rem 1.6rem;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .btn-glass:hover { background: var(--glass-hover); color: var(--text-main); }

        input::placeholder,
        textarea::placeholder { color: var(--text-main) !important; opacity: 1; }
        input:-ms-input-placeholder,
        textarea:-ms-input-placeholder { color: var(--text-main) !important; }
        input::-ms-input-placeholder,
        textarea::-ms-input-placeholder { color: var(--text-main) !important; }

        @keyframes cardPop { 0% { opacity: 0; transform: translateY(24px) scale(.97); } 100% { opacity: 1; transform: translateY(0) scale(1); } }
        @keyframes fieldIn { 0% { opacity: 0; transform: translateY(12px); } 100% { opacity: 1; transform: translateY(0); } }
        .glass-card { animation: cardPop .6s cubic-bezier(.22,1,.36,1) both; }
        .form-block { animation: fieldIn .45s ease both; }
        .form-block:nth-child(1) { animation-delay: .05s; }
        .form-block:nth-child(2) { animation-delay: .10s; }
        .form-block:nth-child(3) { animation-delay: .15s; }
        .product-form-preview { animation: fieldIn .5s ease .1s both; }

        .product-form-grid { display: grid; grid-template-columns: 1.55fr 1fr; gap: 1.6rem; align-items: start; }
        @media (max-width: 991.98px) { .product-form-grid { grid-template-columns: 1fr; } }

        .form-block {
            background: var(--glass-hover);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            padding: 1.25rem 1.3rem;
            margin-bottom: 1.1rem;
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
        }
        .form-block:focus-within { border-color: var(--accent-color); box-shadow: 0 0 0 4px rgba(87,45,119,0.12); }
        .form-block-title {
            display: flex; align-items: center; gap: 0.5rem;
            font-weight: 800; font-size: 0.86rem; color: var(--text-main);
            margin-bottom: 1rem;
        }
        .form-block-title i { color: var(--accent-color); font-size: 1rem; }

        .cat-sub-wrap {
            overflow: hidden;
            max-height: 0; opacity: 0; transform: translateY(-6px);
            transition: max-height 0.4s cubic-bezier(.22,1,.36,1), opacity 0.3s ease, transform 0.3s ease;
        }
        .cat-sub-wrap.show { max-height: 130px; opacity: 1; transform: translateY(0); }

        .char-counter { font-size: 0.7rem; color: var(--text-muted); text-align: left; margin-top: 0.3rem; }

        .product-form-preview { position: sticky; top: 1rem; }
        .live-menu-card {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 28px;
            border-radius: max(28px, 1.75rem);
            overflow: hidden;
            box-shadow: 0 10px 30px var(--glass-shadow);
            transition: transform 0.4s cubic-bezier(.34,1.1,.64,1);
        }
        .live-menu-card:hover { transform: translateY(-4px); }
        .live-menu-card-img {
            position: relative; display: block; width: 100%; aspect-ratio: 16/11;
            background: var(--input-bg); cursor: pointer; overflow: hidden;
        }
        .live-menu-card-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
        .upload-drop-hint {
            position: absolute; inset: 0; display: flex; flex-direction: column;
            align-items: center; justify-content: center; text-align: center; padding: 1rem;
            border: 1.5px dashed var(--glass-border); border-radius: inherit; margin: 8px;
            transition: border-color 0.25s ease, background 0.25s ease;
        }
        .upload-drop-hint i { font-size: 1.9rem; color: var(--accent-color); }
        .live-menu-card-img:hover .upload-drop-hint, .live-menu-card-img.dragover .upload-drop-hint {
            border-color: var(--accent-color); background: var(--glass-hover);
        }
        .upload-drop-hint.is-hidden { opacity: 0; pointer-events: none; }

        .live-menu-card-body { padding: 1.1rem 1.2rem 1.3rem; }
        .live-menu-card-cat {
            display: inline-flex; align-items: center; gap: 0.3rem;
            font-size: 0.68rem; font-weight: 700; color: var(--accent-color);
            background: var(--glass-hover); border-radius: 50rem; padding: 0.2rem 0.65rem;
            margin-bottom: 0.5rem;
        }
        .live-menu-card-name { font-weight: 800; font-size: 1.02rem; margin: 0 0 0.3rem; color: var(--text-main); }
        .live-menu-card-desc {
            font-size: 0.76rem; color: var(--text-muted); line-height: 1.6; margin: 0 0 0.7rem;
            display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
        }
        .live-menu-card-price { font-weight: 800; font-size: 1.15rem; color: var(--accent-color); }
        .live-menu-card-price small { font-size: 0.68rem; color: var(--text-muted); font-weight: 500; }

        .img-remove-btn {
            position: absolute; top: 10px; left: 10px; z-index: 3;
            border: none; background: rgba(214,69,59,0.85); color: #fff;
            border-radius: 12px; width: 32px; height: 32px;
            display: none; align-items: center; justify-content: center;
        }
        .img-remove-btn.show { display: flex; }

        .btn-accent, .btn-glass { position: relative; overflow: hidden; }
        .btn-accent:active, .btn-glass:active { transform: translateY(0) scale(.97); }
        .btn-accent[disabled] { cursor: not-allowed; opacity: .85; }
        .btn-spinner {
            display: none; width: 18px; height: 18px;
            border: 2.5px solid rgba(255,255,255,.4); border-top-color: currentColor;
            border-radius: 50%; animation: spin .7s linear infinite;
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        .btn-accent.is-loading .btn-label { opacity: 0; }
        .btn-accent.is-loading .btn-spinner {
            display: inline-block; position: absolute; top: 50%; left: 50%; margin: -9px 0 0 -9px;
        }
    </style>
</head>
<body>

<div class="glass-card">
    <h5 class="fw-bold mb-1 d-flex align-items-center gap-2">
        <i class="bi bi-pencil-square text-accent"></i>
        ویرایش اطلاعات محصول منو
    </h5>
    <p class="text-muted mb-4" style="font-size:0.82rem;">تغییرات را اعمال کن؛ در سمت راست دقیقاً همان‌طور که در منو دیده می‌شود پیش‌نمایش می‌گیری 🧋</p>

    <form action="/admin/update/<%= iteam._id %>" method="POST" enctype="multipart/form-data" class="product-form-grid" id="updateProductForm">

        <div class="product-form-fields">
            <div class="form-block">
                <div class="form-block-title"><i class="bi bi-tag-fill"></i> اطلاعات پایه</div>
                <div class="row g-3">
                    <div class="col-md-7">
                        <label class="form-label fw-medium text-muted small">نام محصول</label>
                        <input type="text" name="iteamName" id="editNameField" class="form-control glass-input" value="<%= iteam.iteamName %>" required>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label fw-medium text-muted small">قیمت (تومان)</label>
                        <input type="text" inputmode="numeric" name="iteamPrice" id="editPriceField" class="form-control glass-input price-input"
                               value="<%= Number(iteam.iteamPrice).toLocaleString('en-US') %>" placeholder="مثال: 185,000" required>
                    </div>
                </div>
            </div>

            <div class="form-block">
                <div class="form-block-title"><i class="bi bi-diagram-3-fill"></i> دسته‌بندی</div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-medium text-muted small">دسته اصلی</label>
                        <select class="form-select glass-select cat-cascade-main" id="editMainCategorySelect" required></select>
                    </div>
                    <div class="col-md-6 cat-sub-wrap" id="editSubWrap">
                        <label class="form-label fw-medium text-muted small">زیردسته</label>
                        <select class="form-select glass-select cat-cascade-sub" id="editSubCategorySelect"></select>
                    </div>
                </div>
                <select name="category" id="editRealCategorySelect" class="visually-hidden" tabindex="-1" aria-hidden="true"
                        data-initial="<%= iteam.category %>">
                    <% if (typeof categories !== 'undefined') { %>
                        <% categories.forEach(cat => { %>
                            <option value="<%= cat.name %>" <%= iteam.category === cat.name ? 'selected' : '' %>><%= cat.name %></option>
                        <% }) %>
                    <% } %>
                </select>
            </div>

            <div class="form-block">
                <div class="form-block-title"><i class="bi bi-card-text"></i> توضیحات و ترکیبات</div>
                <textarea name="description" class="form-control glass-textarea" rows="4" maxlength="400" id="editDescField"><%= iteam.description %></textarea>
                <div class="char-counter"><span id="editDescCount">0</span>/400</div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-1">
                <a href="/admin#productList" class="btn btn-glass px-4">انصراف</a>
                <button type="submit" class="btn btn-accent px-5" id="updateSubmitBtn">
                    <span class="btn-label"><i class="bi bi-check-circle me-1"></i> ذخیره تغییرات محصول</span>
                    <span class="btn-spinner" aria-hidden="true"></span>
                </button>
            </div>
        </div>

        <div class="product-form-preview">
            <div class="form-block-title"><i class="bi bi-eye-fill"></i> پیش‌نمایش زنده</div>
            <div class="live-menu-card">
                <label class="live-menu-card-img" id="uploadZone">
                    <div class="upload-drop-hint <%= iteam.imageUrl ? 'is-hidden' : '' %>" id="uploadHint">
                        <i class="bi bi-cloud-arrow-up-fill d-block mb-2"></i>
                        <span class="fw-semibold d-block" style="font-size:0.82rem;">برای انتخاب تصویر کلیک کن</span>
                        <span class="text-muted" style="font-size:0.68rem;">PNG, JPG یا WEBP</span>
                    </div>
                    <img id="imgPreview" alt="پیش‌نمایش محصول" style="<%= iteam.imageUrl ? '' : 'display:none;' %>"
                         src="<%= iteam.imageUrl || '' %>">
                    <button type="button" class="img-remove-btn <%= iteam.imageUrl ? 'show' : '' %>" id="imgRemoveBtn" title="حذف تصویر">
                        <i class="bi bi-x-lg"></i>
                    </button>
                    <input type="file" name="imageUrl" id="imageInput" accept="image/*" class="d-none">
                </label>
                <div class="live-menu-card-body">
                    <span class="live-menu-card-cat" id="livePreviewCat"><i class="bi bi-tag"></i> دسته‌بندی</span>
                    <h6 class="live-menu-card-name" id="livePreviewName"><%= iteam.iteamName %></h6>
                    <p class="live-menu-card-desc" id="livePreviewDesc"><%= iteam.description %></p>
                    <div class="live-menu-card-price" id="livePreviewPrice"><%= Number(iteam.iteamPrice).toLocaleString('fa-IR') %> <small>تومان</small></div>
                </div>
            </div>
        </div>

    </form>
</div>

<script>
    (function () {
        var CAT_SEP = ' — ';

        function parseCategoryFull(full) {
            if (!full) return { parent: '', child: '' };
            var idx = full.indexOf(CAT_SEP);
            if (idx === -1) return { parent: full.trim(), child: '' };
            return { parent: full.slice(0, idx).trim(), child: full.slice(idx + CAT_SEP.length).trim() };
        }

        var realSelect = document.getElementById('editRealCategorySelect');
        var mainSelect = document.getElementById('editMainCategorySelect');
        var subWrap    = document.getElementById('editSubWrap');
        var subSelect  = document.getElementById('editSubCategorySelect');
        if (!realSelect || !mainSelect || !subSelect || !subWrap) return;

        var tree = {}, order = [];
        Array.prototype.forEach.call(realSelect.options, function (opt) {
            var full = opt.value;
            if (!full) return;
            var p = parseCategoryFull(full);
            if (!tree[p.parent]) { tree[p.parent] = { hasOwn: false, ownValue: '', children: [] }; order.push(p.parent); }
            if (p.child) tree[p.parent].children.push({ label: p.child, full: full });
            else { tree[p.parent].hasOwn = true; tree[p.parent].ownValue = full; }
        });
        if (!order.length) return;

        mainSelect.innerHTML = '';
        order.forEach(function (name) {
            var o = document.createElement('option');
            o.value = name; o.textContent = name;
            mainSelect.appendChild(o);
        });

        function syncCategoryPreview() {
            var pv = document.getElementById('livePreviewCat');
            if (!pv) return;
            var subVisible = subWrap.classList.contains('show');
            var label = (subVisible && subSelect.options.length) ? subSelect.options[subSelect.selectedIndex].textContent : (mainSelect.options[mainSelect.selectedIndex] ? mainSelect.options[mainSelect.selectedIndex].textContent : 'دسته‌بندی');
            pv.innerHTML = '<i class="bi bi-tag"></i> ' + label;
        }

        function fillSub(parentName, preselectFull) {
            var node = tree[parentName];
            subSelect.innerHTML = '';
            if (!node || node.children.length === 0) {
                subWrap.classList.remove('show');
                realSelect.value = node ? node.ownValue : '';
                syncCategoryPreview();
                return;
            }
            node.children.forEach(function (c) {
                var o = document.createElement('option');
                o.value = c.full; o.textContent = c.label;
                subSelect.appendChild(o);
            });
            subWrap.classList.add('show');
            if (preselectFull) subSelect.value = preselectFull;
            realSelect.value = subSelect.value;
            syncCategoryPreview();
        }

        mainSelect.addEventListener('change', function () { fillSub(mainSelect.value, null); });
        subSelect.addEventListener('change', function () { realSelect.value = subSelect.value; syncCategoryPreview(); });

        var initialFull = realSelect.dataset.initial || (realSelect.options[0] ? realSelect.options[0].value : '');
        var p = parseCategoryFull(initialFull);
        if (order.indexOf(p.parent) === -1) p.parent = order[0];
        mainSelect.value = p.parent;
        fillSub(p.parent, initialFull);
    })();

    (function () {
        document.querySelectorAll('.price-input').forEach(function (input) {
            input.addEventListener('input', function () {
                let raw = this.value.replace(/[^\d]/g, '');
                this.value = raw.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
            });
        });
    })();

    const editDescField = document.getElementById('editDescField');
    const editDescCount = document.getElementById('editDescCount');
    if (editDescField && editDescCount) {
        editDescCount.textContent = editDescField.value.length;
        editDescField.addEventListener('input', () => { editDescCount.textContent = editDescField.value.length; });
    }

    (function () {
        var nameField  = document.getElementById('editNameField');
        var priceField = document.getElementById('editPriceField');
        var pvName  = document.getElementById('livePreviewName');
        var pvPrice = document.getElementById('livePreviewPrice');
        var pvDesc  = document.getElementById('livePreviewDesc');
        if (!nameField || !pvName) return;

        function toFa(n) { try { return Number(n || 0).toLocaleString('fa-IR'); } catch (e) { return n; } }

        nameField.addEventListener('input', function () { pvName.textContent = nameField.value.trim() || 'نام محصول'; });
        priceField.addEventListener('input', function () {
            var raw = priceField.value.replace(/[^\d]/g, '');
            pvPrice.innerHTML = toFa(raw || 0) + ' <small>تومان</small>';
        });
        editDescField && editDescField.addEventListener('input', function () {
            pvDesc.textContent = editDescField.value.trim() || 'توضیحات محصول اینجا نمایش داده می‌شود...';
        });
    })();

    (function () {
        const zone       = document.getElementById('uploadZone');
        const fileInput  = document.getElementById('imageInput');
        const preview    = document.getElementById('imgPreview');
        const hint       = document.getElementById('uploadHint');
        const removeBtn  = document.getElementById('imgRemoveBtn');

        function renderPreview(src) {
            if (src) {
                preview.src = src;
                preview.style.display = 'block';
                hint.classList.add('is-hidden');
            } else {
                preview.removeAttribute('src');
                preview.style.display = 'none';
                hint.classList.remove('is-hidden');
            }
            removeBtn.classList.toggle('show', Boolean(src));
        }

        zone.addEventListener('click', function (e) {
            if (e.target.closest('#imgRemoveBtn')) return;
            fileInput.click();
        });

        fileInput.addEventListener('change', function () {
            const file = this.files && this.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.addEventListener('load', e => renderPreview(e.target.result));
            reader.readAsDataURL(file);
        });

        removeBtn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            fileInput.value = '';
            renderPreview(null);
        });

        ['dragenter', 'dragover'].forEach(evt => {
            zone.addEventListener(evt, e => { e.preventDefault(); zone.classList.add('dragover'); });
        });
        ['dragleave', 'drop'].forEach(evt => {
            zone.addEventListener(evt, e => { e.preventDefault(); zone.classList.remove('dragover'); });
        });
        zone.addEventListener('drop', function (e) {
            e.preventDefault();
            const file = e.dataTransfer.files && e.dataTransfer.files[0];
            if (!file) return;
            fileInput.files = e.dataTransfer.files;
            fileInput.dispatchEvent(new Event('change'));
        });
    })();

    (function () {
        const form = document.getElementById('updateProductForm');
        const btn  = document.getElementById('updateSubmitBtn');
        if (!form || !btn) return;
        form.addEventListener('submit', function () {
            if (!form.checkValidity()) return;
            form.querySelectorAll('.price-input').forEach(input => {
                input.value = input.value.replace(/,/g, '');
            });
            try { localStorage.setItem('babol-admin-active-tab', 'productList'); } catch (e) {}
            btn.classList.add('is-loading');
            btn.setAttribute('disabled', 'disabled');
        });
    })();
</script>
</body>
</html>
